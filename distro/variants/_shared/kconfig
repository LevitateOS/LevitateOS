CONFIG_SCHED_MC=y
CONFIG_SCHED_SMT=y
# Full preemption: kernel can be preempted almost anywhere.
# Higher throughput cost (~2-3%) but dramatically lower latency.
# PREEMPT_DYNAMIC lets `preempt=` on the command line choose another model.
CONFIG_PREEMPT=y
CONFIG_PREEMPT_DYNAMIC=y
# Since 6.13 x86 defaults to the scheduler-controlled PREEMPT_LAZY model, which
# wins the choice unless cleared.
CONFIG_PREEMPT_LAZY=n
