+/// Copy without ptrace fallback: guest page protections remain authoritative.
+pub fn write_tracee_bytes_strict(pid: usize, address: usize, bytes: &[u8]) -> Result<(), i64> {
+    address.checked_add(bytes.len()).ok_or(-EFAULT)?;
+    let written = process_vm_write_bytes(pid, address, bytes);
+    if written == bytes.len() as i64 {
+        Ok(())
+    } else if written < 0 {
+        Err(written)
+    } else {
+        Err(-EFAULT)
+    }
+}
+
+fn process_vm_write_bytes(pid: usize, address: usize, bytes: &[u8]) -> i64 {
+    let local = [bytes.as_ptr() as usize, bytes.len()];
+    let remote = [address, bytes.len()];
+    (unsafe {
+        syscall6(
+            SYS_PROCESS_VM_WRITEV,
+            pid,
+            local.as_ptr() as usize,
+            1,
+            remote.as_ptr() as usize,
+            1,
+            0,
+        )
+    }) as i64
+}
+
 /// Map a failed ptrace access to the errno a user copy would report: an
 /// unmapped address (`EIO` or `EFAULT`) is `-EFAULT`; anything else, such as
 /// `ESRCH` for a tracee that is gone, stays as it is.
diff --git a/crates/ginux-kernel-views/src/lib.rs b/crates/ginux-kernel-views/src/lib.rs
index 90a3a534..d4e92cb2 100644
--- a/crates/ginux-kernel-views/src/lib.rs
+++ b/crates/ginux-kernel-views/src/lib.rs
@@ -32,6 +32,36 @@ pub struct IdentityView<'a> {
     pub boot_id: &'a [u8],
 }
 
+impl IdentityView<'_> {
+    /// Linux utsname layout with domain-owned identity and a virtual release.
+    /// This release names the contract implementation, not the host kernel.
+    pub fn uname(&self, machine: &[u8], output: &mut [u8]) -> Result<usize, ViewError> {
+        const LENGTH: usize = 6 * 65;
+        if output.len() < LENGTH {
+            return Err(ViewError::BufferTooSmall);
+        }
+        let fields = [
+            b"Linux".as_slice(),
+            self.hostname,
+            concat!(env!("CARGO_PKG_VERSION"), "-ginux").as_bytes(),
+            b"ginux",
+            machine,
+            b"",
+        ];
+        if fields
+            .iter()
+            .any(|field| field.len() >= 65 || field.contains(&0))
+        {
+            return Err(ViewError::InvalidPath);
+        }
+        output[..LENGTH].fill(0);
+        for (index, field) in fields.iter().enumerate() {
+            output[index * 65..index * 65 + field.len()].copy_from_slice(field);
+        }
+        Ok(LENGTH)
+    }
+}
+
