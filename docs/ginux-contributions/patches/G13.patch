 crates/ginux-init/src/descriptors.rs    |   7 +
 crates/ginux-init/src/fs_hooks.rs       | 129 ++++++++-
 crates/ginux-vfs/src/lib.rs             | 352 +++++++++++++++++++++---
 scripts/test-launch-scripts.py          |   2 +-
 scripts/test-launch-storage.py          |   4 +-
 tests/fixtures/launch-script-fixture.c  |  12 +-
 tests/fixtures/launch-storage-fixture.c |  57 ++++
 8 files changed, 516 insertions(+), 58 deletions(-)

