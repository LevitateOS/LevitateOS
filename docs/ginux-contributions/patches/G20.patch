+fn parse_control_fd(value: *const u8) -> Option<usize> {
+    let mut fd = 0usize;
+    for i in 0..6 {
+        let byte = unsafe { core::ptr::read_volatile(value.add(i)) };
+        if byte == 0 {
+            return (i != 0 && (3..=65535).contains(&fd)).then_some(fd);
+        }
+        if !byte.is_ascii_digit() {
+            return None;
+        }
+        fd = fd * 10 + (byte - b'0') as usize;
+    }
+    None
+}
