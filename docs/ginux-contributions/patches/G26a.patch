             record = json.loads(result_path.read_text())
             wanted = {"version": 1, "outcome": outcome, "code": None,
                       "signal": None, "generation": None}
@@ -63,6 +63,22 @@ def main():
             print(f"PASS launch {args}: {outcome} ({expected})")
             return proc
 
+        def resource_cases():
+            invoke(["resources", "32"], 0, "exited", stdout=b"process-address-space: PASS\n",
+                   changes={"memory_mib = 256": "memory_mib = 32"})
+            original = resource.getrlimit(resource.RLIMIT_AS)
+            def lower_operator_limit():
+                resource.setrlimit(resource.RLIMIT_AS, (24*1024*1024, original[1]))
+            invoke(["resources", "24"], 0, "exited", stdout=b"process-address-space: PASS\n",
+                   changes={"memory_mib = 256": "memory_mib = 32"},
+                   preexec=lower_operator_limit)
+            assert resource.getrlimit(resource.RLIMIT_AS) == original
+        if sys.argv[3:]:
+            if sys.argv[3:] != ['ordinary-resources']:
+                sys.exit('unknown selected launch scenario')
+            resource_cases()
+            return
+        resource_cases()
         for code in (0, 3, 120, 127, 128, 255):
             invoke(["exit", str(code)], code, "exited")
         invoke(["args", "one two", ""], 0, "exited", env=["GREETING=hello world", "EMPTY="],
diff --git a/tests/fixtures/launch-fixture.c b/tests/fixtures/launch-fixture.c
index 70c70f18..3c528df5 100644
--- a/tests/fixtures/launch-fixture.c
+++ b/tests/fixtures/launch-fixture.c
@@ -20,6 +20,17 @@ static long call4(long number, word a, word b, word c, word d)
     return result;
 }
 
+static long call6(long n, word a, word b, word c, word d, word e, word f)
+{
+    register word r10 __asm__("r10") = d;
+    register word r8 __asm__("r8") = e;
+    register word r9 __asm__("r9") = f;
+    long result;
+    __asm__ volatile("syscall" : "=a"(result) : "a"(n), "D"(a), "S"(b), "d"(c),
+                     "r"(r10), "r"(r8), "r"(r9) : "rcx", "r11", "memory");
+    return result;
+}
+
 /* Signal return trampoline (SA_RESTORER), as libc provides it. */
 void launch_fixture_restore(void);
 __asm__(".global launch_fixture_restore\n"
@@ -78,6 +89,22 @@ long launch_fixture_main(word *stack)
     char **env = argv + argc + 1;
     if (argc < 2) return 90;
     switch (argv[1][0]) {
+    case 'r': {
+        word limits[2];
+        word expected=(argc>2 ? number(argv[2]) : 32)*1024*1024;
+        if(call4(302,0,9,0,(word)limits)!=0 || limits[0]!=expected || limits[1]!=expected) return 160;
+        /* Reserve virtual space only; no host memory pressure is generated. */
+        if(call6(9,0,64*1024*1024,3,0x22,-1,0)!=-12) return 161;
+        long memory=call6(9,0,1024*1024,3,0x22,-1,0);
+        if(memory<=0) return 162;
+        ((volatile char *)memory)[0]=1;
+        ((volatile char *)memory)[1024*1024-1]=2;
+        if(call3(11,memory,1024*1024,0)!=0) return 163;
+        long previous=call3(12,0,0,0);
+        if(previous<=0 || call3(12,previous+64*1024*1024,0,0)!=previous) return 164;
+        print("process-address-space: PASS");
+        return 0;
+    }
     case 'e': return argc > 2 ? number(argv[2]) : 0;
     case 'a':
         for (word i = 2; i < argc; ++i) print(argv[i]);
