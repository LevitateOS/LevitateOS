+fn write_bytes(fd: usize, bytes: &[u8]) -> Result<(), i64> {
+    let mut written = 0;
+    while written < bytes.len() {
+        let count = unsafe {
+            syscall3(
+                1,
+                fd,
+                bytes[written..].as_ptr() as usize,
+                bytes.len() - written,
+            )
+        };
