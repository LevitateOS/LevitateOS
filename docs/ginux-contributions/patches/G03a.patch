From 0b563cf87a3c0e83a20a22eee3af8ffdb7adf015 Mon Sep 17 00:00:00 2001
From: vince <vincepaul.liem@gmail.com>
Date: Fri, 6 Nov 2026 09:06:29 +0100
Subject: [PATCH] fix(launch): use mkdirat when creating the workload directory

Use the x86-64 mkdirat syscall number instead of mknodat so launch
can enter a configured working directory that does not exist yet.
Add a real launch regression that checks the created directory.

Signed-off-by: vince <vincepaul.liem@gmail.com>
---
 crates/ginux-init/src/launch.rs | 2 +-
 scripts/test-launch.py          | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/crates/ginux-init/src/launch.rs b/crates/ginux-init/src/launch.rs
index 1c475fc4..533b12fa 100644
--- a/crates/ginux-init/src/launch.rs
+++ b/crates/ginux-init/src/launch.rs
@@ -283,7 +283,7 @@ pub const MAX_LAUNCH_ARG_LEN: usize = 128;
 pub const MAX_LAUNCH_ENV_LEN: usize = 256;
 pub const MAX_LAUNCH_PATH_LEN: usize = 128;
 
-const SYS_MKDIRAT: usize = 259;
+const SYS_MKDIRAT: usize = 258;
 
 static mut LAUNCH_EXEC: [u8; 129] = [0; 129];
 static mut LAUNCH_ARGS: [u8; 7 * 129] = [0; 7 * 129];
diff --git a/scripts/test-launch.py b/scripts/test-launch.py
index c507d3bb..6ef91eaa 100644
--- a/scripts/test-launch.py
+++ b/scripts/test-launch.py
@@ -77,6 +77,9 @@ def main():
         invoke(["cwd"], 0, "exited", stdout=b"root working directory\n",
                changes={"args = [": 'workdir = "/"\nargs = ['})
         invoke(["exit"], 0, "exited", changes={"args = [": 'workdir = "/work/a..b"\nargs = ['})
+        invoke(["exit"], 0, "exited", changes={"args = [": 'workdir = "/created-workdir"\nargs = ['})
+        if not (root / "created-workdir").is_dir():
+            raise RuntimeError("missing workload directory was not created as a directory")
         invoke(["trap"], 133, "signaled")
         invoke(["handler"], 0, "exited", stdout=b"handled\n")
         invoke(["segv"], 139, "signaled")
