+    pub fn copy_cwd(&mut self, fd: i32) -> Result<i32, i64> {
+        self.fs.duplicate(fd, false).map_err(errno)
+    }
+
+    pub fn close_cwd(&mut self, fd: i32) -> Result<(), i64> {
