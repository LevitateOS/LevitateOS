 crates/ginux-init/src/descriptors.rs |  4 +++
 crates/ginux-init/src/fs_hooks.rs    | 24 ++++++++++++++
 crates/ginux-init/src/launch.rs      | 11 ++++---
 scripts/test-launch-fds.py           | 48 +++++++++++++++++-----------
 scripts/test-launch-storage.py       |  7 +++-
 tests/fixtures/launch-fd-fixture.c   |  6 ++++
 7 files changed, 80 insertions(+), 27 deletions(-)

