From 2ed520c4437a8459c70dc79208d40b2923390939 Mon Sep 17 00:00:00 2001
From: vince <vincepaul.liem@gmail.com>
Date: Fri, 6 Nov 2026 17:31:09 +0100
Subject: [PATCH] feat(init): expose task-owned affinity and preserve process
 bounds

Translate self affinity queries through the registered virtual task identity
and copy only the bounded kernel mask to the tracee. Deny affinity and
address-space limit mutation and verify process-bound inheritance across fork
and exec within the operator CPU subset.

Signed-off-by: vince <vincepaul.liem@gmail.com>
---
 README.md                             |  4 ++-
 crates/ginux-init/src/descriptors.rs  |  4 +--
 crates/ginux-init/src/launch_tasks.rs | 41 +++++++++++++++++++++++++++
 scripts/test-launch-tasks.py          | 36 +++++++++++++++++++++--
 tests/fixtures/launch-task-fixture.c  | 37 ++++++++++++++++++++++++
 5 files changed, 116 insertions(+), 6 deletions(-)

diff --git a/README.md b/README.md
index 1a29feb8..8bdd0285 100644
--- a/README.md
+++ b/README.md
@@ -220,7 +220,9 @@ anonymous and image mappings; it is not an aggregate domain RSS limit.
 from the launcher's allowed affinity mask. This bounds eligible CPUs, not CPU
 time. Limits are installed only in the child before exec; no host-global cgroup
 policy is changed. Kernel inheritance preserves them for supported descendants.
-CPU affinity syscalls retain the existing default-denied policy.
+Self affinity queries (zero, current virtual PID or thread-group ID) report the
+actual eligible CPU subset through a buffer of at most 1024 bytes. Affinity mutation and address-space limit mutation
+are denied; unrelated virtual PIDs are not native scheduler targets.
 
 Optional `[storage].assignments` entries of the form `"memory:/absolute/path"`
 declare empty, ephemeral writable namespaces. For example:
diff --git a/crates/ginux-init/src/descriptors.rs b/crates/ginux-init/src/descriptors.rs
index cb69292d..dd7da768 100644
--- a/crates/ginux-init/src/descriptors.rs
+++ b/crates/ginux-init/src/descriptors.rs
@@ -293,8 +293,8 @@ impl DescriptorTable {
         r: &mut UserRegs,
         backends: &mut Backends,
     ) -> NativeDecision {
-        // Resource changes cannot silently invalidate the public allocator.
-        if r.orig_rax == 302 && r.rsi == 7 && r.rdx != 0 {
+        // Resource changes cannot invalidate the public allocator or address-space bound.
+        if r.orig_rax == 302 && matches!(r.rsi, 7 | 9) && r.rdx != 0 {
             return ready(-1);
         }
         let result = match r.orig_rax {
diff --git a/crates/ginux-init/src/launch_tasks.rs b/crates/ginux-init/src/launch_tasks.rs
index 1adee8cd..1f77d15b 100644
--- a/crates/ginux-init/src/launch_tasks.rs
+++ b/crates/ginux-init/src/launch_tasks.rs
@@ -375,6 +375,47 @@ impl Supervisor<'_> {
         let original = *r;
         let id = self.task(index).id;
         match r.orig_rax {
+            203 => {
+                self.emulate(index, r, -1, domain);
+                return;
+            }
+            204 => {
+                let result = (|| {
+                    let target = r.rdi as u32;
+                    let tgid = self.processes.view(id).unwrap().tgid;
+                    if target != 0 && target != id.pid && target != tgid {
+                        return Err(-3);
+                    }
+                    if r.rsi > 1024 {
+                        return Err(-22);
+                    }
+                    let mut mask = [0u8; 1024];
+                    let size = unsafe {
+                        crate::supervisor::syscall3(
+                            204,
+                            self.task(index).host,
+                            r.rsi as usize,
+                            mask.as_mut_ptr() as usize,
+                        )
+                    };
+                    if size < 0 {
+                        return Err(size as i64);
+                    }
+                    if copy_memory(
+                        self.task(index).host,
+                        r.rdx,
+                        &mut mask[..size as usize],
+                        true,
+                    )? != size as i64
+                    {
+                        return Err(-14);
+                    }
+                    Ok(size as i64)
+                })()
+                .unwrap_or_else(|error| error);
+                self.emulate(index, r, result, domain);
+                return;
+            }
             59 | 322 => {
                 let result = self.prepare_exec(index, r);
                 if result == Err(-5) {
