+
+    fn path_descriptor(
+        &mut self,
+        pid: usize,
+        r: &mut UserRegs,
+        fs: &mut LaunchFs,
+        channels: &mut LaunchChannels,
+    ) -> Result<NativeDecision, i64> {
+        let empty = match r.orig_rax {
+            262 => r.r10 & 0x1000 != 0,
+            332 => r.rdx & 0x1000 != 0,
+            _ => false,
+        };
