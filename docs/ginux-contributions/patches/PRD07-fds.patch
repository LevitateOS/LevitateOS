+                // directory descriptors. Pass only their selected backend.
+                match entry.handle {
+                    Handle::Native { fd, .. } => r.rdi = fd as u64,
+                    Handle::Owned(handle) if fs.memory_handle(handle) => r.rdi = handle as u64,
+                    _ => return Err(-20),
