+        return match result {
+            crate::channel_hooks::ChannelResult::Ready(result) => NativeDecision::Hooked {
+                lane: Lane::Channel,
+                result,
+            },
+            crate::channel_hooks::ChannelResult::Blocked { fd } => NativeDecision::Park { fd },
+        };
+    }
+    match filesystem.dispatch(pid, registers) {
+        crate::launch_storage::Dispatch::Device(result) => NativeDecision::Hooked {
+            lane: Lane::Device,
+            result,
+        },
+        crate::launch_storage::Dispatch::Handled(result) => NativeDecision::Hooked {
+            lane: Lane::Filesystem,
+            result,
+        },
+        crate::launch_storage::Dispatch::Native | crate::launch_storage::Dispatch::Rewritten => {
+            decide_native(
