+                            self.entries[r.rdi as u32 as usize]
+                                .as_mut()
+                                .unwrap()
+                                .cloexec = r.rdx != 0;
+                            Ok(ready(0))
+                        }
+                        2 => Err(-22),
+                        _ => self.descriptor(pid, r, entry, fs, channels),
+                    },
+                }
+            }
+            0 | 1 | 5 | 8 | 16 | 17 | 18 | 19 | 20 | 74 | 75 | 77 | 78 | 81 | 91 | 217 => {
+                self.save(r);
+                self.get(r.rdi)
+                    .and_then(|d| self.descriptor(pid, r, d, fs, channels))
