+        let slot = self.reserve(flags & CLOEXEC != 0)?;
+        if r.orig_rax == 2 {
+            r.rsi &= !CLOEXEC;
+        } else {
+            r.rdx &= !CLOEXEC;
+        }
+        let decision = if r.orig_rax == 257 {
+            self.path_descriptor(pid, r, fs, channels)
