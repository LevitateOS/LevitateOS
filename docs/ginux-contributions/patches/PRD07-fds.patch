+            }
+            Handle::Owned(handle) => {
+                if r.orig_rax == 81 && !fs.memory_handle(handle) {
+                    return Err(-20);
+                }
+                r.rdi = handle as u64;
+            }
+            Handle::Reserved => return Err(-9),
