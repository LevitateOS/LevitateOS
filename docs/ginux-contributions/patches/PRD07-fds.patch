+            read_path(pid, r.rsi)?
+        };
+        if path.as_bytes().first() == Some(&b'/') {
+            r.rdi = (-100i64) as u64;
+        } else if r.rdi as i32 != -100 {
+            let entry = self.get(r.rdi)?;
+            if path.is_empty() {
+                match entry.handle {
+                    Handle::Native { fd, .. } => r.rdi = fd as u64,
+                    Handle::Owned(handle) => r.rdi = handle as u64,
+                    Handle::Reserved => return Err(-9),
+                }
+            } else {
