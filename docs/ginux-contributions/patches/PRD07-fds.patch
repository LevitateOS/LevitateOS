+            9 if r.r10 & 0x20 == 0 => {
+                self.save(r);
+                match self.get(r.r8) {
+                    Ok(Descriptor {
+                        handle: Handle::Native { fd, console: false },
+                        ..
+                    }) => {
+                        r.r8 = fd as u64;
+                        Ok(decide_objects(pid, r, fs, channels))
+                    }
+                    Ok(_) => Err(-95),
+                    Err(e) => Err(e),
+                }
+            }
+            258 | 262 | 263 | 267 | 268 | 269 | 332 | 439 => {
+                self.save(r);
+                self.path_descriptor(pid, r, fs, channels)
+            }
+            _ => Ok(decide_objects(pid, r, fs, channels)),
+        };
+        result.unwrap_or_else(ready)
