+        Ok(None)
+    }
+
+    pub fn exec_descriptor(&mut self, pid: usize, handle: u32) -> Result<Executable, i64> {
+        let fd = handle
+            .checked_sub(FD_BASE as u32)
+            .filter(|n| *n < 64)
+            .ok_or(-95)?;
+        let image = self.fs.pin_executable_fd(fd as i32 + 3).map_err(errno)?;
+        self.check_exec(pid, image)
