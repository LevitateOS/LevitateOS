diff --git a/crates/ginux-init/src/fs_hooks.rs b/crates/ginux-init/src/fs_hooks.rs
index b75d7015b15ef694937004d3d6605bbe72c32a95..8034a09dc04f7c86f954d1800a01b6c65dc6ab96 100644
--- a/crates/ginux-init/src/fs_hooks.rs
+++ b/crates/ginux-init/src/fs_hooks.rs
@@ -1,18 +1,589 @@
-//! Native filesystem-lane dispatch hooks.
-//!
-//! Owner: G-files lane. Next task: G06 adds domain directory and
-//! working-directory operations. Until then every hook declines and the
-//! supervisor keeps its existing behavior byte-identical.
-
-/// Lane membership by syscall number. Reserved for G06+.
-pub fn claims(syscall: u64) -> bool {
-    let _ = syscall;
-    false
+//! Configured-launch ephemeral memory storage. Bytes and descriptors belong to
+//! the supervisor; no writable host descriptor is installed in the workload.
+//! Retained storage, directory descriptors, mappings and exec are not provided.
+
+use crate::supervisor::{syscall4, syscall6, UserRegs};
+use core::sync::atomic::{AtomicBool, Ordering};
+use ginux_domain::{DomainConfig, Text};
+use ginux_vfs::{
+    BaseReader, Entry, FileMetadata, Index, NodeKind, VfsError, VirtualFs, HEADER_SIZE, MAX_PATH,
+    O_APPEND, O_CLOEXEC, O_CREATE, O_EXCLUSIVE, O_READ, O_TRUNC, O_WRITE, RECORD_SIZE,
+};
+
+pub const FD_BASE: usize = 1 << 20;
+const IO_SIZE: usize = 4096;
+type Path = Text<MAX_PATH>;
+type MemoryFs = VirtualFs<'static, EmptyReader, 32, 65536, 64>;
+static mut ROOT_INDEX: [u8; HEADER_SIZE + RECORD_SIZE] = [0; HEADER_SIZE + RECORD_SIZE];
+static ROOT_INITIALIZED: AtomicBool = AtomicBool::new(false);
+
+pub struct EmptyReader;
+impl BaseReader for EmptyReader {
+    fn read_at(&mut self, _: u64, _: &mut [u8]) -> Result<(), VfsError> {
+        Err(VfsError::Io)
+    }
+}
+
+pub struct LaunchFs {
+    fs: MemoryFs,
+    prefixes: [Path; 8],
+    count: usize,
+    cwd: Path,
 }
 
-/// Emulated result when this lane handles the entry. `None` falls through to
-/// the shared balanced-contract decision. Reserved for G06+.
-pub fn claim(syscall: u64, rdi: u64, rsi: u64, rdx: u64) -> Option<i64> {
-    let _ = (syscall, rdi, rsi, rdx);
+impl LaunchFs {
+    /// Called once, before fork. Assignments are domain paths, never host paths.
+    pub fn prepare(config: &DomainConfig) -> Result<Self, &'static [u8]> {
+        let mut prefixes = [Path::empty(); 8];
+        let mut count = 0;
+        for assignment in config.storage.as_slice() {
+            let path = assignment
+                .as_bytes()
+                .strip_prefix(b"memory:")
+                .ok_or(b"unsupported launch storage assignment".as_slice())?;
+            if path.len() < 2
+                || path[0] != b'/'
+                || path.ends_with(b"/")
+                || path
+                    .split(|b| *b == b'/')
+                    .skip(1)
+                    .any(|p| p.is_empty() || p == b"." || p == b"..")
+                || [b"/proc".as_slice(), b"/sys", b"/dev"]
+                    .iter()
+                    .any(|r| within(path, r) || within(r, path))
+                || within(config.init.as_bytes(), path)
+                || within(path, config.init.as_bytes())
+                || prefixes[..count].iter().any(|p| p.as_bytes() == path)
+            {
+                return Err(b"invalid launch memory-storage path");
+            }
+            prefixes[count] =
+                Path::from_bytes(path).map_err(|_| b"storage path exceeds bound".as_slice())?;
+            count += 1;
+        }
+        // Root-only index: writable opens cannot copy image files into memory.
+        // Never mutate the static index while any existing view can borrow it.
+        if ROOT_INITIALIZED.swap(true, Ordering::Relaxed) {
+            return Err(b"launch filesystem already initialized");
+        }
+        let index_bytes = unsafe { &mut *core::ptr::addr_of_mut!(ROOT_INDEX) };
+        let (header, record) = index_bytes.split_at_mut(HEADER_SIZE);
+        ginux_vfs::encode_header(1, header.try_into().unwrap());
+        ginux_vfs::encode_record(
+            Entry {
+                path: b"/",
+                kind: NodeKind::Directory,
+                mode: 0o755,
+                uid: 0,
+                gid: 0,
+                size: 0,
+                data_offset: 0,
+                link: b"",
+            },
+            record.try_into().unwrap(),
+        )
+        .map_err(|_| b"invalid storage root index".as_slice())?;
+        let mut fs = MemoryFs::new(
+            Index::new(index_bytes).map_err(|_| b"invalid storage root index".as_slice())?,
+            EmptyReader,
+        );
+        for prefix in &prefixes[..count] {
+            let path = prefix.as_bytes();
+            for end in 1..=path.len() {
+                if end == path.len() || path[end] == b'/' {
+                    match fs.mkdir(&path[..end], 0o755) {
+                        Ok(()) | Err(VfsError::AlreadyExists) => {}
+                        Err(_) => return Err(b"memory storage directory capacity exceeded"),
+                    }
+                }
+            }
+        }
+        Ok(Self {
+            fs,
+            prefixes,
+            count,
+            cwd: Path::from_bytes(config.workdir.as_bytes())
+                .map_err(|_| b"storage workdir exceeds bound".as_slice())?,
+        })
+    }
+
+    pub fn enabled(&self) -> bool {
+        self.count != 0
+    }
+
+    /// Native open/dup cannot obtain descriptors in the virtual namespace.
+    pub fn reserve_descriptors(&self) -> bool {
+        if !self.enabled() {
+            return true;
+        }
+        let mut limits = [0u64; 2];
+        if unsafe { syscall4(302, 0, 7, 0, limits.as_mut_ptr() as usize) } < 0 {
+            return false;
+        }
+        limits[0] = limits[0].min(FD_BASE as u64);
+        limits[1] = limits[1].min(FD_BASE as u64);
+        unsafe { syscall4(302, 0, 7, limits.as_ptr() as usize, 0) == 0 }
+    }
+
+    fn owns_path(&self, path: &[u8]) -> bool {
+        self.prefixes[..self.count]
+            .iter()
+            .any(|p| within(path, p.as_bytes()))
+    }
+
+    fn path(&self, pid: usize, address: u64, dirfd: u64) -> Result<Path, i64> {
+        let text = read_path(pid, address)?;
+        if text.is_empty() {
+            return Err(-2);
+        }
+        let absolute = text.as_bytes().first() == Some(&b'/');
+        if !absolute && dirfd as i32 != -100 {
+            return Err(if dirfd as i32 >= FD_BASE as i32 {
+                -20
+            } else {
+                -9
+            });
+        }
+        let mut bytes = [0; MAX_PATH];
+        let base = if absolute {
+            b"".as_slice()
+        } else {
+            self.cwd.as_bytes()
+        };
+        let separator = usize::from(!base.is_empty() && base != b"/");
+        let end = base
+            .len()
+            .checked_add(separator)
+            .and_then(|n| n.checked_add(text.as_bytes().len()))
+            .filter(|n| *n < MAX_PATH)
+            .ok_or(-36)?;
+        bytes[..base.len()].copy_from_slice(base);
+        if separator != 0 {
+            bytes[base.len()] = b'/';
+        }
+        bytes[base.len() + separator..end].copy_from_slice(text.as_bytes());
+        Path::from_bytes(&bytes[..end]).map_err(|_| -36)
+    }
+
+    fn resolve(&self, pid: usize, path: &[u8], follow: bool, missing: bool) -> Result<Path, i64> {
+        let image = crate::path_hooks::ImageRoot::new(pid)?;
+        let mut output = [0; MAX_PATH];
+        let n = ginux_vfs::resolve_namespace(path, follow, missing, &mut output, |path, target| {
+            if self.owns_path(path)
+                || path != b"/"
+                    && self.prefixes[..self.count]
+                        .iter()
+                        .any(|prefix| within(prefix.as_bytes(), path))
+            {
+                return self.fs.metadata(path).map(|m| (m.kind, 0));
+            }
+            image.lookup(path, target)
+        })
+        .map_err(errno)?;
+        Path::from_bytes(&output[..n]).map_err(|_| -36)
+    }
+
+    fn request_path(&self, pid: usize, r: &UserRegs) -> Result<Option<(u8, Path)>, i64> {
+        let (argument, address, dirfd, follow, missing) = match r.orig_rax {
+            2 => (
+                0,
+                r.rdi,
+                (-100i64) as u64,
+                r.rsi & 0o400000 == 0 && r.rsi & 0o300 != 0o300,
+                r.rsi & 0o100 != 0,
+            ),
+            257 => (
+                1,
+                r.rsi,
+                r.rdi,
+                r.rdx & 0o400000 == 0 && r.rdx & 0o300 != 0o300,
+                r.rdx & 0o100 != 0,
+            ),
+            4 | 21 | 90 => (0, r.rdi, (-100i64) as u64, true, false),
+            6 | 87 | 89 => (0, r.rdi, (-100i64) as u64, false, false),
+            83 => (0, r.rdi, (-100i64) as u64, false, true),
+            258 => (1, r.rsi, r.rdi, false, true),
+            262 => (1, r.rsi, r.rdi, r.r10 & 0x100 == 0, false),
+            263 => (1, r.rsi, r.rdi, false, false),
+            268 => (1, r.rsi, r.rdi, true, false),
+            332 => (1, r.rsi, r.rdi, r.rdx & 0x100 == 0, false),
+            439 => (1, r.rsi, r.rdi, r.r10 & 0x100 == 0, false),
+            _ => return Ok(None),
+        };
+        if matches!(r.orig_rax, 262 | 332 | 439)
+            && (dirfd as i32) < FD_BASE as i32
+            && read_path(pid, address)?.is_empty()
+        {
+            return Ok(None);
+        }
+        let path = self.path(pid, address, dirfd)?;
+        self.resolve(pid, path.as_bytes(), follow, missing)
+            .map(|p| Some((argument, p)))
+    }
+
+    /// Canonical image paths preserve assignment precedence even through links
+    /// and parent components; the kernel never follows a hidden image subtree.
+    pub fn native_path(&self, pid: usize, r: &UserRegs) -> Result<Option<(u8, Path)>, i64> {
+        if !self.enabled() {
+            return Ok(None);
+        }
+        let Some((argument, path)) = self.request_path(pid, r)? else {
+            return Ok(None);
+        };
+        if self.owns_path(path.as_bytes()) {
+            return Ok(None);
+        }
+        let raw = read_path(pid, if argument == 0 { r.rdi } else { r.rsi })?;
+        if raw == path {
+            return Ok(None);
+        }
+        Ok(Some((argument, path)))
+    }
+
+    /// Configured-launch dispatch only; demo paths keep their existing contract.
+    pub fn claim(&mut self, pid: usize, r: &UserRegs) -> Option<i64> {
+        if !self.enabled() {
+            return None;
+        }
+        let fd = r.rdi as i32;
+        if matches!(
+            r.orig_rax,
+            0 | 1 | 3 | 5 | 8 | 16 | 17 | 18 | 19 | 20 | 32 | 33 | 72 | 74 | 75 | 77 | 91 | 292
+        ) && fd >= FD_BASE as i32
+        {
+            return Some(self.descriptor_call(pid, r, fd - FD_BASE as i32 + 3));
+        }
+        if matches!(r.orig_rax, 262 | 332) {
+            match read_path(pid, r.rsi) {
+                Ok(p) if p.is_empty() && fd >= FD_BASE as i32 => {
+                    return Some(self.descriptor_call(pid, r, fd - FD_BASE as i32 + 3))
+                }
+                Ok(p) if p.is_empty() => return None,
+                Err(error) => return Some(error),
+                _ => {}
+            }
+        }
+        let path = match self.request_path(pid, r) {
+            Ok(Some((_, path))) => path,
+            Ok(None) => return None,
+            Err(error) => return Some(error),
+        };
+        if !self.owns_path(path.as_bytes()) {
+            return None;
+        }
+        let result = match r.orig_rax {
+            2 => self.open(path.as_bytes(), r.rsi, r.rdx),
+            257 => self.open(path.as_bytes(), r.rdx, r.r10),
+            4 | 6 => self.stat(pid, path.as_bytes(), r.rsi, false),
+            262 => {
+                if r.r10 & !0x1900 != 0 {
+                    Err(-22)
+                } else {
+                    self.stat(pid, path.as_bytes(), r.rdx, false)
+                }
+            }
+            332 => {
+                if !valid_statx(r.rdx, r.r10) {
+                    Err(-22)
+                } else {
+                    self.stat(pid, path.as_bytes(), r.r8, true)
+                }
+            }
+            83 => self
+                .fs
+                .mkdir(path.as_bytes(), r.rsi as u32 & 0o755)
+                .map(|_| 0)
+                .map_err(errno),
+            258 => self
+                .fs
+                .mkdir(path.as_bytes(), r.rdx as u32 & 0o755)
+                .map(|_| 0)
+                .map_err(errno),
+            87 => self.fs.unlink(path.as_bytes()).map(|_| 0).map_err(errno),
+            263 => {
+                if r.rdx != 0 {
+                    Err(-95)
+                } else {
+                    self.fs.unlink(path.as_bytes()).map(|_| 0).map_err(errno)
+                }
+            }
+            90 => self
+                .fs
+                .chmod(path.as_bytes(), r.rsi as u32)
+                .map(|_| 0)
+                .map_err(errno),
+            268 => self
+                .fs
+                .chmod(path.as_bytes(), r.rdx as u32)
+                .map(|_| 0)
+                .map_err(errno),
+            _ => Err(-95),
+        };
+        Some(result.unwrap_or_else(|error| error))
+    }
+
+    fn open(&mut self, path: &[u8], flags: u64, mode: u64) -> Result<i64, i64> {
+        // NOFOLLOW is valid because this backend has no symlinks. Unsupported
+        // directory/path-only behavior never falls through to native storage.
+        const ALLOWED: u64 = 3 | 0o100 | 0o200 | 0o1000 | 0o2000 | 0o100000 | 0o400000 | 0o2000000;
+        if flags & !ALLOWED != 0 || flags & 3 == 3 {
+            return Err(-95);
+        }
+        let mut translated = match flags & 3 {
+            0 => O_READ,
+            1 => O_WRITE,
+            _ => O_READ | O_WRITE,
+        };
+        for (native, internal) in [
+            (0o100, O_CREATE),
+            (0o200, O_EXCLUSIVE),
+            (0o1000, O_TRUNC),
+            (0o2000, O_APPEND),
+            (0o2000000, O_CLOEXEC),
+        ] {
+            if flags & native != 0 {
+                translated |= internal;
+            }
+        }
+        let existed = self.fs.metadata(path).is_ok();
+        let fd = self.fs.open(path, translated).map_err(errno)?;
+        if !existed && flags & 0o100 != 0 {
+            self.fs.fchmod(fd, mode as u32 & 0o755).map_err(errno)?;
+        }
+        Ok(FD_BASE as i64 + fd as i64 - 3)
+    }
+
+    fn stat(&self, pid: usize, path: &[u8], destination: u64, statx: bool) -> Result<i64, i64> {
+        copy_metadata(
+            pid,
+            destination,
+            self.fs.metadata(path).map_err(errno)?,
+            statx,
+        )
+    }
+
+    fn descriptor_call(&mut self, pid: usize, r: &UserRegs, fd: i32) -> i64 {
+        let result = match r.orig_rax {
+            0 => self.read(pid, fd, r.rsi, r.rdx, None),
+            17 => self.read(pid, fd, r.rsi, r.rdx, Some(r.r10 as i64)),
+            1 => self.write(pid, fd, r.rsi, r.rdx),
+            3 => self.fs.close(fd).map(|_| 0).map_err(errno),
+            5 => self
+                .fs
+                .fstat(fd)
+                .map_err(errno)
+                .and_then(|m| copy_metadata(pid, r.rsi, m, false)),
+            8 => self
+                .fs
+                .seek(fd, r.rsi as i64, r.rdx as u32)
+                .map(|n| n as i64)
+                .map_err(errno),
+            91 => self.fs.fchmod(fd, r.rsi as u32).map(|_| 0).map_err(errno),
+            72 => self
+                .fs
+                .descriptor_flags(fd)
+                .map_err(errno)
+                .and_then(|(flags, cloexec)| match r.rsi {
+                    1 => Ok(cloexec as i64),
+                    2 if r.rdx & !1 == 0 => self
+                        .fs
+                        .set_close_on_exec(fd, r.rdx != 0)
+                        .map(|_| 0)
+                        .map_err(errno),
+                    3 => Ok(flags as i64),
+                    _ => Err(-95),
+                }),
+            262 | 332 => {
+                let flags = if r.orig_rax == 262 { r.r10 } else { r.rdx };
+                let valid = if r.orig_rax == 262 {
+                    flags & !0x1900 == 0
+                } else {
+                    valid_statx(flags, r.r10)
+                };
+                if flags & 0x1000 == 0 || !valid {
+                    Err(-22)
+                } else {
+                    self.fs.fstat(fd).map_err(errno).and_then(|m| {
+                        copy_metadata(
+                            pid,
+                            if r.orig_rax == 262 { r.rdx } else { r.r8 },
+                            m,
+                            r.orig_rax == 332,
+                        )
+                    })
+                }
+            }
+            _ => Err(-95),
+        };
+        result.unwrap_or_else(|error| error)
+    }
+
+    fn read(
+        &mut self,
+        pid: usize,
+        fd: i32,
+        address: u64,
+        length: u64,
+        offset: Option<i64>,
+    ) -> Result<i64, i64> {
+        let previous = self.fs.seek(fd, 0, 1).map_err(errno)?;
+        if let Some(offset) = offset {
+            self.fs.seek(fd, offset, 0).map_err(errno)?;
+        }
+        let start = self.fs.seek(fd, 0, 1).map_err(errno)?;
+        let mut buffer = [0u8; IO_SIZE];
+        let read = self
+            .fs
+            .read(fd, &mut buffer[..length.min(IO_SIZE as u64) as usize])
+            .map_err(errno);
+        let result = read.and_then(|count| copy_memory(pid, address, &mut buffer[..count], true));
+        let next = if offset.is_some() {
+            previous
+        } else {
+            start + result.unwrap_or(0) as u64
+        };
+        self.fs.seek(fd, next as i64, 0).map_err(errno)?;
+        result
+    }
+
+    fn write(&mut self, pid: usize, fd: i32, address: u64, length: u64) -> Result<i64, i64> {
+        self.fs.fstat(fd).map_err(errno)?;
+        let mut buffer = [0u8; IO_SIZE];
+        let count = length.min(IO_SIZE as u64) as usize;
+        let copied = copy_memory(pid, address, &mut buffer[..count], false)? as usize;
+        self.fs
+            .write(fd, &buffer[..copied])
+            .map(|n| n as i64)
+            .map_err(errno)
+    }
+}
+
+fn valid_statx(flags: u64, mask: u64) -> bool {
+    flags & !0x7900 == 0 && flags & 0x6000 != 0x6000 && mask & 0x8000_0000 == 0
+}
+
+fn within(path: &[u8], prefix: &[u8]) -> bool {
+    path == prefix
+        || path
+            .strip_prefix(prefix)
+            .is_some_and(|suffix| suffix.first() == Some(&b'/'))
+}
+
+#[repr(C)]
+struct IoVec {
+    address: usize,
+    length: usize,
+}
+
+// Parent-only calls honor guest page protections. No PTRACE forced copyout.
+pub(crate) fn copy_memory(
+    pid: usize,
+    address: u64,
+    buffer: &mut [u8],
+    output: bool,
+) -> Result<i64, i64> {
+    if buffer.is_empty() {
+        return Ok(0);
+    }
+    address.checked_add(buffer.len() as u64).ok_or(-14)?;
+    let local = IoVec {
+        address: buffer.as_mut_ptr() as usize,
+        length: buffer.len(),
+    };
+    let remote = IoVec {
+        address: address as usize,
+        length: buffer.len(),
+    };
+    let result = unsafe {
+        syscall6(
+            if output { 311 } else { 310 },
+            pid,
+            &local as *const _ as usize,
+            1,
+            &remote as *const _ as usize,
+            1,
+            0,
+        )
+    };
+    if result <= 0 {
+        Err(-14)
+    } else {
+        Ok(result as i64)
+    }
+}
+
+fn read_path(pid: usize, address: u64) -> Result<Path, i64> {
+    let mut buffer = [0; MAX_PATH];
+    for i in 0..MAX_PATH {
+        copy_memory(
+            pid,
+            address.checked_add(i as u64).ok_or(-14)?,
+            &mut buffer[i..i + 1],
+            false,
+        )?;
+        if buffer[i] == 0 {
+            return Path::from_bytes(&buffer[..i]).map_err(|_| -36);
+        }
+    }
+    Err(-36)
+}
+
+fn copy_metadata(
+    pid: usize,
+    address: u64,
+    metadata: FileMetadata,
+    statx: bool,
+) -> Result<i64, i64> {
+    let mut bytes = [0u8; 256];
+    let mode = metadata.mode
+        | if metadata.kind == NodeKind::Directory {
+            0o40000
+        } else {
+            0o100000
+        };
+    let (ino, mode_at, size_at, blocks_at, length) = if statx {
+        bytes[..4].copy_from_slice(&0x7ffu32.to_le_bytes());
+        bytes[4..8].copy_from_slice(&4096u32.to_le_bytes());
+        bytes[16..20].copy_from_slice(&1u32.to_le_bytes());
+        bytes[28..30].copy_from_slice(&(mode as u16).to_le_bytes());
+        (32, None, 40, 48, 256)
+    } else {
+        bytes[16..24].copy_from_slice(&1u64.to_le_bytes());
+        bytes[56..64].copy_from_slice(&4096u64.to_le_bytes());
+        (8, Some(24), 48, 64, 144)
+    };
+    bytes[ino..ino + 8].copy_from_slice(&metadata.inode.to_le_bytes());
+    if let Some(mode_at) = mode_at {
+        bytes[mode_at..mode_at + 4].copy_from_slice(&mode.to_le_bytes());
+    }
+    bytes[size_at..size_at + 8].copy_from_slice(&metadata.size.to_le_bytes());
+    bytes[blocks_at..blocks_at + 8].copy_from_slice(&metadata.size.div_ceil(512).to_le_bytes());
+    if copy_memory(pid, address, &mut bytes[..length], true)? != length as i64 {
+        return Err(-14);
+    }
+    Ok(0)
+}
+
+fn errno(error: VfsError) -> i64 {
+    match error {
+        VfsError::NotFound => -2,
+        VfsError::NotDirectory => -20,
+        VfsError::IsDirectory => -21,
+        VfsError::AlreadyExists => -17,
+        VfsError::PermissionDenied => -13,
+        VfsError::InvalidDescriptor => -9,
+        VfsError::DescriptorLimit => -24,
+        VfsError::OverlayLimit => -28,
+        VfsError::FileTooLarge => -27,
+        VfsError::InvalidPath => -22,
+        VfsError::SymlinkLoop => -40,
+        VfsError::InvalidIndex | VfsError::Io => -5,
+    }
+}
+
+pub fn claims(_: u64) -> bool {
+    false
+}
+pub fn claim(_: u64, _: u64, _: u64, _: u64) -> Option<i64> {
     None
 }
