+    /// A semantic denial takes precedence; a semantic allowance cannot grant
+    /// an unknown or denied syscall. Backends still validate implementation
+    /// support and typed resource constraints before producing effects.
+    pub fn runtime_rule(&self, number: u64, semantic: Option<&str>) -> Option<&EffectiveRule> {
+        semantic
+            .and_then(|id| self.operation_rule(id))
+            .filter(|rule| matches!(rule.action, Action::Deny(_)))
+            .or_else(|| self.syscall_rule(number))
+    }
