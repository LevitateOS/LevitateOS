diff --git a/crates/ginux-init/src/fs_hooks.rs b/crates/ginux-init/src/fs_hooks.rs
index b75d7015b15ef694937004d3d6605bbe72c32a95..281fd1db8f2cd5befbc0a299c210c0fd4e637d3b 100644
--- a/crates/ginux-init/src/fs_hooks.rs
+++ b/crates/ginux-init/src/fs_hooks.rs
@@ -1,18 +1,610 @@
-//! Native filesystem-lane dispatch hooks.
-//!
-//! Owner: G-files lane. Next task: G06 adds domain directory and
-//! working-directory operations. Until then every hook declines and the
-//! supervisor keeps its existing behavior byte-identical.
-
-/// Lane membership by syscall number. Reserved for G06+.
-pub fn claims(syscall: u64) -> bool {
-    let _ = syscall;
-    false
+//! Configured-launch ephemeral memory storage. Bytes and descriptors belong to
+//! the supervisor; no writable host descriptor is installed in the workload.
+//! Retained storage, directory descriptors, mappings and exec are not provided.
+
+use crate::supervisor::{syscall4, syscall6, UserRegs};
+use core::sync::atomic::{AtomicBool, Ordering};
+use ginux_domain::{DomainConfig, Text};
+use ginux_vfs::{
+    BaseReader, Entry, FileMetadata, Index, NodeKind, VfsError, VirtualFs, HEADER_SIZE, MAX_PATH,
+    O_APPEND, O_CLOEXEC, O_CREATE, O_EXCLUSIVE, O_READ, O_TRUNC, O_WRITE, RECORD_SIZE,
+};
+
+pub const FD_BASE: usize = 1 << 20;
+const IO_SIZE: usize = 4096;
+type Path = Text<MAX_PATH>;
+type MemoryFs = VirtualFs<'static, EmptyReader, 32, 65536, 64>;
+static mut ROOT_INDEX: [u8; HEADER_SIZE + RECORD_SIZE] = [0; HEADER_SIZE + RECORD_SIZE];
+static ROOT_INITIALIZED: AtomicBool = AtomicBool::new(false);
+
+pub struct EmptyReader;
+impl BaseReader for EmptyReader {
+    fn read_at(&mut self, _: u64, _: &mut [u8]) -> Result<(), VfsError> {
+        Err(VfsError::Io)
+    }
+}
+
+pub struct LaunchFs {
+    fs: MemoryFs,
+    prefixes: [Path; 8],
+    count: usize,
+    cwd: Path,
+}
+
+impl LaunchFs {
+    /// Called once, before fork. Assignments are domain paths, never host paths.
+    pub fn prepare(config: &DomainConfig) -> Result<Self, &'static [u8]> {
+        let mut prefixes = [Path::empty(); 8];
+        let mut count = 0;
+        for assignment in config.storage.as_slice() {
+            let path = assignment
+                .as_bytes()
+                .strip_prefix(b"memory:")
+                .ok_or(b"unsupported launch storage assignment".as_slice())?;
+            if path.len() < 2
+                || path[0] != b'/'
+                || path.ends_with(b"/")
+                || path
+                    .split(|b| *b == b'/')
+                    .skip(1)
+                    .any(|p| p.is_empty() || p == b"." || p == b"..")
+                || [b"/proc".as_slice(), b"/sys", b"/dev"]
+                    .iter()
+                    .any(|r| within(path, r) || within(r, path))
+                || within(config.init.as_bytes(), path)
+                || within(path, config.init.as_bytes())
+                || prefixes[..count].iter().any(|p| p.as_bytes() == path)
+            {
+                return Err(b"invalid launch memory-storage path");
+            }
+            prefixes[count] =
+                Path::from_bytes(path).map_err(|_| b"storage path exceeds bound".as_slice())?;
+            count += 1;
+        }
+        // Root-only index: writable opens cannot copy image files into memory.
+        // Never mutate the static index while any existing view can borrow it.
+        if ROOT_INITIALIZED.swap(true, Ordering::Relaxed) {
+            return Err(b"launch filesystem already initialized");
+        }
+        let index_bytes = unsafe { &mut *core::ptr::addr_of_mut!(ROOT_INDEX) };
+        let (header, record) = index_bytes.split_at_mut(HEADER_SIZE);
+        ginux_vfs::encode_header(1, header.try_into().unwrap());
+        ginux_vfs::encode_record(
+            Entry {
+                path: b"/",
+                kind: NodeKind::Directory,
+                mode: 0o755,
+                uid: 0,
+                gid: 0,
+                size: 0,
+                data_offset: 0,
+                link: b"",
+            },
+            record.try_into().unwrap(),
+        )
+        .map_err(|_| b"invalid storage root index".as_slice())?;
+        let mut fs = MemoryFs::new(
+            Index::new(index_bytes).map_err(|_| b"invalid storage root index".as_slice())?,
+            EmptyReader,
+        );
+        for prefix in &prefixes[..count] {
+            let path = prefix.as_bytes();
+            for end in 1..=path.len() {
+                if end == path.len() || path[end] == b'/' {
+                    match fs.mkdir(&path[..end], 0o755) {
+                        Ok(()) | Err(VfsError::AlreadyExists) => {}
+                        Err(_) => return Err(b"memory storage directory capacity exceeded"),
+                    }
+                }
+            }
+        }
+        Ok(Self {
+            fs,
+            prefixes,
+            count,
+            cwd: Path::from_bytes(config.workdir.as_bytes())
+                .map_err(|_| b"storage workdir exceeds bound".as_slice())?,
+        })
+    }
+
+    pub fn enabled(&self) -> bool {
+        self.count != 0
+    }
+
+    /// Native open/dup cannot obtain descriptors in the virtual namespace.
+    pub fn reserve_descriptors(&self) -> bool {
+        if !self.enabled() {
+            return true;
+        }
+        let mut limits = [0u64; 2];
+        if unsafe { syscall4(302, 0, 7, 0, limits.as_mut_ptr() as usize) } < 0 {
+            return false;
+        }
+        limits[0] = limits[0].min(FD_BASE as u64);
+        limits[1] = limits[1].min(FD_BASE as u64);
+        unsafe { syscall4(302, 0, 7, limits.as_ptr() as usize, 0) == 0 }
+    }
+
+    fn owns_path(&self, path: &[u8]) -> bool {
+        self.prefixes[..self.count]
+            .iter()
+            .any(|p| within(path, p.as_bytes()))
+    }
+
+    fn path(&self, pid: usize, address: u64, dirfd: u64) -> Result<Path, i64> {
+        let text = read_path(pid, address)?;
+        if text.is_empty() {
+            return Err(-2);
+        }
+        let absolute = text.as_bytes().first() == Some(&b'/');
+        if !absolute && dirfd as i32 != -100 {
+            return Err(if dirfd as i32 >= FD_BASE as i32 {
+                -20
+            } else {
+                -9
+            });
+        }
+        let mut bytes = [0; MAX_PATH];
+        let base = if absolute {
+            b"".as_slice()
+        } else {
+            self.cwd.as_bytes()
+        };
+        let separator = usize::from(!base.is_empty() && base != b"/");
+        let end = base
+            .len()
+            .checked_add(separator)
+            .and_then(|n| n.checked_add(text.as_bytes().len()))
+            .filter(|n| *n < MAX_PATH)
+            .ok_or(-36)?;
+        bytes[..base.len()].copy_from_slice(base);
+        if separator != 0 {
+            bytes[base.len()] = b'/';
+        }
+        bytes[base.len() + separator..end].copy_from_slice(text.as_bytes());
+        Path::from_bytes(&bytes[..end]).map_err(|_| -36)
+    }
+
+    fn resolve(&self, pid: usize, path: &[u8], follow: bool, missing: bool) -> Result<Path, i64> {
+        let image = crate::path_hooks::ImageRoot::new(pid)?;
+        let mut output = [0; MAX_PATH];
+        let n = ginux_vfs::resolve_namespace(path, follow, missing, &mut output, |path, target| {
+            if self.owns_path(path)
+                || path != b"/"
+                    && self.prefixes[..self.count]
+                        .iter()
+                        .any(|prefix| within(prefix.as_bytes(), path))
+            {
+                return self.fs.metadata(path).map(|m| (m.kind, 0));
+            }
+            image.lookup(path, target)
+        })
+        .map_err(errno)?;
+        Path::from_bytes(&output[..n]).map_err(|_| -36)
+    }
+
+    fn request_path(&self, pid: usize, r: &UserRegs) -> Result<Option<(u8, Path)>, i64> {
+        let (argument, address, dirfd, follow, missing) = match r.orig_rax {
+            2 => (
+                0,
+                r.rdi,
+                (-100i64) as u64,
+                r.rsi & 0o400000 == 0 && r.rsi & 0o300 != 0o300,
+                r.rsi & 0o100 != 0,
+            ),
+            257 => (
+                1,
+                r.rsi,
+                r.rdi,
+                r.rdx & 0o400000 == 0 && r.rdx & 0o300 != 0o300,
+                r.rdx & 0o100 != 0,
+            ),
+            4 | 21 | 90 => (0, r.rdi, (-100i64) as u64, true, false),
+            6 | 87 | 89 => (0, r.rdi, (-100i64) as u64, false, false),
+            83 => (0, r.rdi, (-100i64) as u64, false, true),
+            258 => (1, r.rsi, r.rdi, false, true),
+            262 => (1, r.rsi, r.rdi, r.r10 & 0x100 == 0, false),
+            263 => (1, r.rsi, r.rdi, false, false),
+            268 => (1, r.rsi, r.rdi, true, false),
+            332 => (1, r.rsi, r.rdi, r.rdx & 0x100 == 0, false),
+            439 => (1, r.rsi, r.rdi, r.r10 & 0x100 == 0, false),
+            _ => return Ok(None),
+        };
+        if matches!(r.orig_rax, 262 | 332 | 439)
+            && (dirfd as i32) < FD_BASE as i32
+            && read_path(pid, address)?.is_empty()
+        {
+            return Ok(None);
+        }
+        let path = self.path(pid, address, dirfd)?;
+        self.resolve(pid, path.as_bytes(), follow, missing)
+            .map(|p| Some((argument, p)))
+    }
+
+    /// Canonical image paths preserve assignment precedence even through links
+    /// and parent components; the kernel never follows a hidden image subtree.
+    pub fn native_path(&self, pid: usize, r: &UserRegs) -> Result<Option<(u8, Path)>, i64> {
+        if !self.enabled() {
+            return Ok(None);
+        }
+        let Some((argument, path)) = self.request_path(pid, r)? else {
+            return Ok(None);
+        };
+        if self.owns_path(path.as_bytes()) {
+            return Ok(None);
+        }
+        let raw = read_path(pid, if argument == 0 { r.rdi } else { r.rsi })?;
+        if raw == path {
+            return Ok(None);
+        }
+        Ok(Some((argument, path)))
+    }
+
+    /// Classify policy without reading or mutating workload memory or objects.
+    /// Resource/descriptor validation remains in claim after policy admission.
+    pub fn contract_operation(&self, r: &UserRegs) -> Option<&'static str> {
+        let write = match r.orig_rax {
+            2 | 257 => {
+                let flags = if r.orig_rax == 2 { r.rsi } else { r.rdx };
+                flags & 3 != 0 || flags & (0o100 | 0o1000 | 0o2000) != 0
+            }
+            4 | 6 | 21 | 89 | 262 | 332 | 439 => false,
+            83 | 87 | 90 | 258 | 263 | 268 => true,
+            0 | 5 | 17 if r.rdi >= FD_BASE as u64 && r.rdi < FD_BASE as u64 + 64 => false,
+            1 | 77 | 91 if r.rdi >= FD_BASE as u64 && r.rdi < FD_BASE as u64 + 64 => true,
+            _ => return None,
+        };
+        Some(if write {
+            "filesystem.path.write"
+        } else {
+            "filesystem.path.read"
+        })
+    }
+
+    /// Configured-launch dispatch only; demo paths keep their existing contract.
+    pub fn claim(&mut self, pid: usize, r: &UserRegs) -> Option<i64> {
+        if !self.enabled() {
+            return None;
+        }
+        let fd = r.rdi as i32;
+        if matches!(
+            r.orig_rax,
+            0 | 1 | 3 | 5 | 8 | 16 | 17 | 18 | 19 | 20 | 32 | 33 | 72 | 74 | 75 | 77 | 91 | 292
+        ) && fd >= FD_BASE as i32
+        {
+            return Some(self.descriptor_call(pid, r, fd - FD_BASE as i32 + 3));
+        }
+        if matches!(r.orig_rax, 262 | 332) {
+            match read_path(pid, r.rsi) {
+                Ok(p) if p.is_empty() && fd >= FD_BASE as i32 => {
+                    return Some(self.descriptor_call(pid, r, fd - FD_BASE as i32 + 3))
+                }
