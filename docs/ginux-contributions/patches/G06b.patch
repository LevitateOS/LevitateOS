+        for entry in &mut self.entries {
+            if entry.is_some_and(|d| d.cloexec) {
+                if let Handle::Owned(handle) = entry.take().unwrap().handle {
+                    backends.release(handle)?;
+                }
+                // Kernel closed native handles with no surviving aliases.
+            }
+        }
+        Ok(())
+    }
