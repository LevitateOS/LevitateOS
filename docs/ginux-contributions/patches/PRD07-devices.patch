diff --git a/README.md b/README.md
index 7ec5cd04..a41b05c0 100644
--- a/README.md
+++ b/README.md
@@ -458,3 +458,24 @@ checks for syscall ABI dispatch, clone restrictions, descriptor inheritance,
 thread reuse, successful and failed worker exec, signals, wait-status writes,
 nonblocking waits, and vfork. The existing native fork fixture also runs. These
 checks do not claim complete libc, job-control, or systemd compatibility.
+
+### Assigned virtual null devices
+
+Configured launch presents an immutable virtual `/dev`, empty by default.
+`[devices].assignments = ["null"]` exposes `/dev/null` through the existing
+device registry. Reads return EOF; writes discard at most 4,096 bytes per call
+without reading the ignored input buffer. Access modes, close, seek, descriptor
+flags and stat/statx metadata use virtual state, with at most 64 open device
+handles. Null-device directory opens fail with ENOTDIR. Device-directory
+descriptors, enumeration and mutation are unsupported in this contribution.
+
+Device paths share the configured namespace resolver with assigned storage.
+Image aliases cannot bypass the virtual view or expose hidden image devices.
+Metadata copies respect workload page protections. No host device is opened
+or passed to the workload; unsupported or duplicate assignments fail before it
+starts. The configured contract is checked before device effects. Catalog 1
+and native policy are unchanged; this contribution does not introduce general
+device passthrough or shared public-descriptor/exec ownership.
+
+Build with `make build-launch-device-fixture`, then run the independent
+`sudo make test-launch-devices` scenario against the existing launcher binary.
diff --git a/crates/ginux-init/src/device_hooks.rs b/crates/ginux-init/src/device_hooks.rs
new file mode 100644
index 00000000..989f4aa4
--- /dev/null
+++ b/crates/ginux-init/src/device_hooks.rs
@@ -0,0 +1,273 @@
+//! Explicitly assigned character devices for configured native launch.
+//! All IO uses ginux-devices objects; no host device node or descriptor is used.
+
+use crate::launch_storage::{read_path, write_stat, Stat};
+use crate::supervisor::UserRegs;
+use ginux_devices::{DeviceError, DeviceKind, DeviceName, DeviceRegistry};
+use ginux_instance::InstanceConfig;
+
+const INSTANCE: u64 = 1; // One instance per configured supervisor process.
+const FD_BASE: u32 = 0x4000_0000;
+const FDS: usize = 64;
+const CLOEXEC: u32 = 0o2000000;
+const ACCESS_MODE: u32 = 3;
+
+pub struct LaunchDevices {
+    registry: DeviceRegistry<1, FDS>,
+    flags: [Option<u32>; FDS],
+    enabled: bool,
+}
+
+impl LaunchDevices {
+    pub fn prepare(config: &InstanceConfig) -> Result<Self, &'static [u8]> {
+        let mut registry = DeviceRegistry::new();
+        for device in config.devices.as_slice() {
+            if device.as_bytes() != b"null" {
+                return Err(b"unsupported launch device assignment");
+            }
+            registry
+                .assign(
+                    INSTANCE,
+                    1,
+                    DeviceName::new(b"null").unwrap(),
+                    DeviceKind::Null,
+                )
+                .map_err(|_| b"duplicate launch device assignment".as_slice())?;
+        }
+        Ok(Self {
+            registry,
+            flags: [None; FDS],
+            enabled: !config.devices.as_slice().is_empty(),
+        })
+    }
+
+    pub fn descriptor_dispatch(&mut self, pid: usize, r: &UserRegs) -> Option<i64> {
+        let fd = r.rdi as u32;
+        if (fd as i32) >= FD_BASE as i32
+            && matches!(
+                r.orig_rax,
+                0 | 1 | 3 | 5 | 8 | 16 | 17 | 18 | 19 | 20 | 32 | 33 | 72 | 74 | 75 | 77 | 91 | 292
+            )
+        {
+            return Some(
+                self.descriptor_call(pid, fd, r)
+                    .unwrap_or_else(|error| error),
+            );
+        }
+        if matches!(r.orig_rax, 262 | 332) {
+            let flags = if r.orig_rax == 262 { r.r10 } else { r.rdx };
+            let path = if r.rsi == 0 && flags & 0x1000 != 0 {
+                ginux_instance::Text::from_bytes(b"").map_err(|_| -14)
+            } else {
+                read_path(pid, r.rsi)
+            };
+            match path {
+                Ok(path) if path.is_empty() && (fd as i32) >= FD_BASE as i32 => {
+                    if flags & 0x1000 == 0 {
+                        return Some(-2);
+                    }
+                    return Some(
+                        self.descriptor_call(pid, fd, r)
+                            .unwrap_or_else(|error| error),
+                    );
+                }
+                Ok(path) if path.is_empty() => return None,
+                Err(error) => return Some(error),
+                _ => {}
+            }
+        }
+        None
+    }
+
+    pub fn enabled(&self) -> bool {
+        self.enabled
+    }
+
+    pub fn owns(path: &[u8]) -> bool {
+        path == b"/dev" || path.starts_with(b"/dev/")
+    }
+
+    pub fn lookup(&self, path: &[u8]) -> Result<(ginux_vfs::NodeKind, usize), ginux_vfs::VfsError> {
+        match path {
+            b"/dev" => Ok((ginux_vfs::NodeKind::Directory, 0)),
+            b"/dev/null" if self.enabled => Ok((ginux_vfs::NodeKind::File, 0)),
+            _ => Err(ginux_vfs::VfsError::NotFound),
+        }
+    }
+
+    pub fn path_dispatch(&mut self, pid: usize, r: &UserRegs, path: &[u8]) -> i64 {
+        if path != b"/dev" && !path.starts_with(b"/dev/") {
+            return -2;
+        }
+        let null = path == b"/dev/null";
+        let dir = path == b"/dev";
+        if (!null && !dir) || (null && !self.enabled) {
+            return -2;
+        }
+        let result = match r.orig_rax {
+            2 | 257 => {
+                let flags = if r.orig_rax == 2 { r.rsi } else { r.rdx };
+                if dir {
+                    Err(-21)
+                } else {
+                    self.open(flags)
+                }
+            }
+            4 | 6 => Self::stat(pid, r.rsi, false, dir),
+            262 => {
+                if r.r10 & !0x1900 != 0 {
+                    Err(-22)
+                } else {
+                    Self::stat(pid, r.rdx, false, dir)
+                }
+            }
+            332 => {
+                if !crate::launch_storage::valid_statx(r.rdx, r.r10) {
+                    Err(-22)
+                } else {
+                    Self::stat(pid, r.r8, true, dir)
+                }
+            }
+            21 | 269 | 439 => {
+                let mode = if r.orig_rax == 21 { r.rsi } else { r.rdx };
+                let flags = if r.orig_rax == 439 { r.r10 } else { 0 };
+                if mode & !7 != 0 || flags & !0x100 != 0 {
+                    Err(-22)
+                } else if (dir && mode & 2 != 0) || (!dir && mode & 1 != 0) {
+                    Err(-13)
+                } else {
+                    Ok(0)
+                }
+            }
+            89 | 267 => Err(-22), // Character devices are not symlinks.
+            _ => Err(-30),        // Assignment metadata is immutable.
+        };
+        result.unwrap_or_else(|error| error)
+    }
+
+    fn open(&mut self, flags: u64) -> Result<i64, i64> {
+        if flags & 0o200000 != 0 {
+            return Err(-20);
+        }
+        const ALLOWED: u64 = 3
+            | 0o100
+            | 0o200
+            | 0o400
+            | 0o1000
+            | 0o2000
+            | 0o4000
+            | 0o100000
+            | 0o400000
+            | CLOEXEC as u64;
+        if flags & !ALLOWED != 0 || flags & 3 == 3 {
+            return Err(-95);
+        }
+        if flags & 0o300 == 0o300 {
+            return Err(-17);
+        }
+        let fd = self
+            .registry
+            .open(INSTANCE, b"null")
+            .map_err(device_errno)?;
+        // Creation and truncation do not mutate an existing character device.
+        self.flags[(fd - FD_BASE) as usize] = Some(flags as u32 & !0o1300);
+        Ok(fd as i64)
+    }
+
+    fn descriptor_call(&mut self, pid: usize, fd: u32, r: &UserRegs) -> Result<i64, i64> {
+        let slot = (fd - FD_BASE) as usize;
+        let flags = self.flags.get(slot).copied().flatten().ok_or(-9)?;
+        match r.orig_rax {
+            0 => {
+                if flags & ACCESS_MODE == 1 {
+                    Err(-9)
+                } else {
+                    self.registry
+                        .read(INSTANCE, fd, &mut [])
+                        .map(|n| n as i64)
+                        .map_err(device_errno)
+                }
+            }
+            1 => {
+                if flags & ACCESS_MODE == 0 {
+                    Err(-9)
+                } else {
+                    // Null consumes no input bytes; an ignored guest buffer is never
+                    // dereferenced. Bound discarded bytes per IO just like file IO.
+                    let count = r.rdx.min(4096) as usize;
+                    self.registry
+                        .write(INSTANCE, fd, &[0; 4096][..count])
+                        .map(|n| n as i64)
+                        .map_err(device_errno)
+                }
+            }
+            3 => {
+                self.registry.close(INSTANCE, fd).map_err(device_errno)?;
+                self.flags[slot] = None;
+                Ok(0)
+            }
+            5 => Self::stat(pid, r.rsi, false, false),
+            8 => {
+                if r.rdx <= 4 {
+                    Ok(0)
+                } else {
+                    Err(-22)
+                }
+            }
+            72 => match r.rsi {
+                1 => Ok(i64::from(flags & CLOEXEC != 0)),
+                2 if r.rdx & !1 == 0 => {
+                    self.flags[slot] =
+                        Some((flags & !CLOEXEC) | if r.rdx == 1 { CLOEXEC } else { 0 });
+                    Ok(0)
+                }
+                3 => Ok((flags & !CLOEXEC) as i64),
+                _ => Err(-95),
+            },
+            262 | 332 => {
+                let flags = if r.orig_rax == 262 { r.r10 } else { r.rdx };
+                let valid = if r.orig_rax == 262 {
+                    flags & !0x1900 == 0
+                } else {
+                    crate::launch_storage::valid_statx(flags, r.r10)
+                };
+                if flags & 0x1000 == 0 || !valid {
+                    Err(-22)
+                } else {
+                    Self::stat(
+                        pid,
+                        if r.orig_rax == 262 { r.rdx } else { r.r8 },
+                        r.orig_rax == 332,
+                        false,
+                    )
+                }
+            }
+            16 => Err(-25),
+            _ => Err(-95),
+        }
+    }
+
+    fn stat(pid: usize, destination: u64, statx: bool, dir: bool) -> Result<i64, i64> {
+        write_stat(
+            pid,
+            destination,
+            Stat {
+                inode: if dir { 0x1_0000_0000 } else { 0x1_0000_0001 },
+                mode: if dir { 0o40555 } else { 0o20666 },
+                size: 0,
+                device_major: if dir { 0 } else { 1 },
+                device_minor: if dir { 0 } else { 3 },
+            },
+            statx,
+        )
+    }
+}
+
+fn device_errno(error: DeviceError) -> i64 {
+    match error {
+        DeviceError::DescriptorLimit => -24,
+        DeviceError::InvalidDescriptor => -9,
+        DeviceError::NotAssigned | DeviceError::UnknownDevice => -2,
+        _ => -5,
+    }
+}
