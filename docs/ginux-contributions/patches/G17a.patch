         CHECK(DO(8,c,0,1)==1 && DO(5,c,meta,0)==0 && *(word *)(meta+48)==5*mib,142);
         CHECK(DO(8,c,0,0)==0 && DO(0,c,output,1)==1 && output[0]=='K',143);
         CHECK(DO(3,b,0,0)==0 && DO(77,c,9*mib,0)==0,82);
