From 94baebbec5e887ae659718c3f6162d08ca267b99 Mon Sep 17 00:00:00 2001
From: vince <vincepaul.liem@gmail.com>
Date: Fri, 6 Nov 2026 15:02:39 +0100
Subject: [PATCH] feat(storage): support positioned writes on owned files

Route pwrite through the existing owned write path, restoring the shared
open-description offset on success and failure. Retain bounded transfers,
sparse growth, Linux append behavior and existing descriptor ownership.

Signed-off-by: vince <vincepaul.liem@gmail.com>
---
 README.md                               |  5 +++--
 crates/ginux-init/src/fs_hooks.rs       | 26 +++++++++++++++++++++----
 scripts/test-launch-storage.py          |  5 +++--
 tests/fixtures/launch-storage-fixture.c | 21 ++++++++++++++++++++
 4 files changed, 49 insertions(+), 8 deletions(-)

diff --git a/README.md b/README.md
index a3982c7c..62318b23 100644
--- a/README.md
+++ b/README.md
@@ -232,9 +232,10 @@ storage. Paths must be canonical, unique, and cannot cover init, `/`, `/proc`,
 Without assignments, native image access remains read-only.
 
 This backend supports regular-file open/create/exclusive-create/truncate/append,
-read/write/pread, ftruncate, seek, close, descriptor flags, mkdir/unlink/rmdir,
+read/write/pread/pwrite, ftruncate, seek, close, descriptor flags, mkdir/unlink/rmdir,
 owned directory descriptions/getdents64, rename/renameat/renameat2 with NOREPLACE,
-chmod and stat/fstat/fstatat/statx metadata. Access and readlink probes stay in
+chmod and stat/fstat/fstatat/statx metadata. Positioned writes preserve the
+shared open-description offset; append descriptions retain Linux append semantics. Access and readlink probes stay in
 the owned namespace; regular files accept O_NOCTTY. Directory cookies and inode
 identity follow open descriptions across aliases, fork, rename and removal.
 Namespace changes validate types, capacity and replacement before mutation.
diff --git a/crates/ginux-init/src/fs_hooks.rs b/crates/ginux-init/src/fs_hooks.rs
index 6dd53976..59053aff 100644
--- a/crates/ginux-init/src/fs_hooks.rs
+++ b/crates/ginux-init/src/fs_hooks.rs
@@ -622,7 +622,8 @@ impl LaunchFs {
         let result = match r.orig_rax {
             0 => self.read(pid, fd, r.rsi, r.rdx, None),
             17 => self.read(pid, fd, r.rsi, r.rdx, Some(r.r10 as i64)),
-            1 => self.write(pid, fd, r.rsi, r.rdx),
+            1 => self.write(pid, fd, r.rsi, r.rdx, None),
+            18 => self.write(pid, fd, r.rsi, r.rdx, Some(r.r10 as i64)),
             3 => self.fs.close(fd).map(|_| 0).map_err(errno),
             5 => self
                 .fs
@@ -715,16 +716,33 @@ impl LaunchFs {
         result
     }
 
-    fn write(&mut self, pid: usize, fd: i32, address: u64, length: u64) -> Result<i64, i64> {
+    fn write(
+        &mut self,
+        pid: usize,
+        fd: i32,
+        address: u64,
+        length: u64,
+        offset: Option<i64>,
+    ) -> Result<i64, i64> {
         self.fs.fstat(fd).map_err(errno)?;
         let mut buffer = [0u8; IO_SIZE];
         let count = length.min(IO_SIZE as u64) as usize;
         let copied = copy_memory(pid, address, &mut buffer[..count], false)? as usize;
-        self.fs
+        let previous = self.fs.seek(fd, 0, 1).map_err(errno)?;
+        if let Some(offset) = offset {
+            self.fs.seek(fd, offset, 0).map_err(errno)?;
+        }
+        let result = self
+            .fs
             .write(fd, &buffer[..copied])
             .map(|n| n as i64)
-            .map_err(errno)
+            .map_err(errno);
+        if offset.is_some() {
+            self.fs.seek(fd, previous as i64, 0).map_err(errno)?;
+        }
+        result
     }
+
     fn getdents(&mut self, pid: usize, fd: i32, address: u64, length: u64) -> Result<i64, i64> {
         if self.fs.fstat(fd).map_err(errno)?.kind != NodeKind::Directory {
             return Err(-20);
