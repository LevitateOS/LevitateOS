+    /// Follow image links in component order and inspect the current namespace.
+    pub fn metadata(&self, path: &[u8]) -> Result<FileMetadata, VfsError> {
+        let path = self.resolved_path(path, true, false)?;
+        self.metadata_at(path.as_bytes())
+    }
+
+    fn metadata_at(&self, path: &[u8]) -> Result<FileMetadata, VfsError> {
+        if let Some(index) = self.find_overlay(path) {
+            let file = &self.overlay[index];
+            if file.state == 2 {
+                return Err(VfsError::NotFound);
+            }
+            return Ok(FileMetadata {
+                inode: (self.index.len() + index + 1) as u64,
+                kind: if file.state == 3 {
+                    NodeKind::Directory
+                } else {
+                    NodeKind::File
+                },
+                mode: file.mode,
+                size: file.len as u64,
+            });
+        }
+        let entry = self.index.lookup_exact(path)?;
+        Ok(FileMetadata {
+            inode: (self
+                .find_base_record(entry.path)
+                .ok_or(VfsError::InvalidIndex)?
+                + 1) as u64,
+            kind: entry.kind,
+            mode: entry.mode,
+            size: entry.size,
+        })
+    }
+
+    pub fn fstat(&self, descriptor: i32) -> Result<FileMetadata, VfsError> {
+        let state = self.descriptors[self.descriptor(descriptor)?];
+        if state.overlay {
+            let file = &self.overlay[state.object];
+            Ok(FileMetadata {
+                inode: (self.index.len() + state.object + 1) as u64,
+                kind: NodeKind::File,
+                mode: file.mode,
+                size: file.len as u64,
+            })
+        } else {
+            let entry = self.index.entry(state.object)?;
+            Ok(FileMetadata {
+                inode: (state.object + 1) as u64,
+                kind: entry.kind,
+                mode: entry.mode,
+                size: entry.size,
+            })
+        }
+    }
+
+    pub fn mkdir(&mut self, path: &[u8], mode: u32) -> Result<(), VfsError> {
+        let mut end = path.len();
+        while end > 1 && path[end - 1] == b'/' {
+            end -= 1;
+        }
+        let path = self.resolved_path(&path[..end], false, true)?;
+        match self.metadata_at(path.as_bytes()) {
+            Ok(_) => return Err(VfsError::AlreadyExists),
+            Err(VfsError::NotFound) => {}
+            Err(error) => return Err(error),
+        }
+        self.require_parent(path.as_bytes())?;
+        let slot = self.create_overlay(path, mode & 0o777)?;
+        self.overlay[slot].state = 3;
+        Ok(())
+    }
+
+    pub fn chmod(&mut self, path: &[u8], mode: u32) -> Result<(), VfsError> {
+        let path = self.resolved_path(path, true, false)?;
+        let slot = self
+            .find_overlay(path.as_bytes())
+            .ok_or(VfsError::PermissionDenied)?;
+        if mode & !0o777 != 0 {
+            return Err(VfsError::PermissionDenied);
+        }
+        self.overlay[slot].mode = mode;
+        Ok(())
+    }
+
+    pub fn fchmod(&mut self, descriptor: i32, mode: u32) -> Result<(), VfsError> {
+        let state = self.descriptors[self.descriptor(descriptor)?];
+        if !state.overlay || mode & !0o777 != 0 {
+            return Err(VfsError::PermissionDenied);
+        }
+        self.overlay[state.object].mode = mode;
+        Ok(())
+    }
+
+    /// Seek the shared open-file position; seeking past EOF does not grow data.
+    pub fn seek(&mut self, descriptor: i32, offset: i64, whence: u32) -> Result<u64, VfsError> {
+        let slot = self.descriptor(descriptor)?;
+        let base = match whence {
+            0 => 0,
+            1 => self.positions[self.descriptors[slot].position] as u64,
+            2 => self.fstat(descriptor)?.size,
+            _ => return Err(VfsError::InvalidPath),
+        };
+        let base = i64::try_from(base).map_err(|_| VfsError::FileTooLarge)?;
+        let position = base
+            .checked_add(offset)
+            .filter(|p| *p >= 0)
+            .ok_or(VfsError::InvalidPath)?;
+        self.positions[self.descriptors[slot].position] =
+            usize::try_from(position).map_err(|_| VfsError::FileTooLarge)?;
+        Ok(position as u64)
+    }
+
+    pub fn descriptor_flags(&self, descriptor: i32) -> Result<(u32, bool), VfsError> {
+        let state = self.descriptors[self.descriptor(descriptor)?];
+        let mode = match (state.readable, state.writable) {
+            (true, false) => 0,
+            (false, true) => 1,
+            _ => 2,
+        };
+        Ok((
+            mode | if state.append { 0o2000 } else { 0 },
+            state.close_on_exec,
+        ))
+    }
+
+    pub fn set_close_on_exec(&mut self, descriptor: i32, enabled: bool) -> Result<(), VfsError> {
+        let slot = self.descriptor(descriptor)?;
+        self.descriptors[slot].close_on_exec = enabled;
+        Ok(())
+    }
+
     fn descriptor(&self, descriptor: i32) -> Result<usize, VfsError> {
         let slot = descriptor
             .checked_sub(3)
@@ -586,7 +758,7 @@ impl<'a, R: BaseReader, const FILES: usize, const FILE_SIZE: usize, const FDS: u
     fn find_overlay(&self, path: &[u8]) -> Option<usize> {
         self.overlay
             .iter()
-            .position(|entry| entry.state == 1 && entry.path.as_bytes() == path)
+            .position(|entry| matches!(entry.state, 1 | 3) && entry.path.as_bytes() == path)
             .or_else(|| {
                 self.overlay
                     .iter()
@@ -671,7 +843,14 @@ impl<'a, R: BaseReader, const FILES: usize, const FILE_SIZE: usize, const FDS: u
                 return if self.overlay[slot].state == 2 {
                     Err(VfsError::NotFound)
                 } else {
-                    Ok((NodeKind::File, 0))
+                    Ok((
+                        if self.overlay[slot].state == 3 {
+                            NodeKind::Directory
+                        } else {
+                            NodeKind::File
