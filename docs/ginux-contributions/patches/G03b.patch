+                    ))
                 };
             }
             let entry = self.index.lookup_exact(name)?;
@@ -690,7 +869,7 @@ impl<'a, R: BaseReader, const FILES: usize, const FILE_SIZE: usize, const FDS: u
         } else {
             &path[..split]
         };
-        if self.index.resolve(parent)?.kind != NodeKind::Directory {
+        if self.metadata(parent)?.kind != NodeKind::Directory {
