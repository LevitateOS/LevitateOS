From 25d4f05a30a2b367e24aea9460149bd55baa3406 Mon Sep 17 00:00:00 2001
From: vince <vincepaul.liem@gmail.com>
Date: Fri, 6 Nov 2026 23:36:00 +0100
Subject: [PATCH] fix(vfs): share offsets between duplicated descriptors
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Retain one bounded offset slot per open-file description so aliases
observe each other’s reads and writes after close or FD reuse.
Keep independent opens and close-on-exec flags separate.

Add focused read/write and lifetime regressions, and update the
unlink regression to consume its old object through the shared offset.

Signed-off-by: vince <vincepaul.liem@gmail.com>
---
 crates/ginux-vfs/src/lib.rs | 116 +++++++++++++++++++++++++++++-------
 1 file changed, 95 insertions(+), 21 deletions(-)

diff --git a/crates/ginux-vfs/src/lib.rs b/crates/ginux-vfs/src/lib.rs
index 40ac9df5f13a28e3a3b83ab6ceee5c6f396fc862..f196ad13c82f69327a8859cb8042fa4a6e51a3be 100644
--- a/crates/ginux-vfs/src/lib.rs
+++ b/crates/ginux-vfs/src/lib.rs
@@ -328,7 +328,7 @@ struct Descriptor {
     open: bool,
     overlay: bool,
     object: usize,
-    offset: usize,
+    position: usize,
     readable: bool,
     writable: bool,
     close_on_exec: bool,
@@ -340,7 +340,7 @@ impl Descriptor {
             open: false,
             overlay: false,
             object: 0,
-            offset: 0,
+            position: 0,
             readable: false,
             writable: false,
             close_on_exec: false,
@@ -353,6 +353,7 @@ pub struct VirtualFs<'a, R, const FILES: usize, const FILE_SIZE: usize, const FD
     reader: R,
     overlay: [OverlayFile<FILE_SIZE>; FILES],
     descriptors: [Descriptor; FDS],
+    positions: [usize; FDS],
 }
 
 impl<'a, R: BaseReader, const FILES: usize, const FILE_SIZE: usize, const FDS: usize>
@@ -364,6 +365,7 @@ impl<'a, R: BaseReader, const FILES: usize, const FILE_SIZE: usize, const FDS: u
             reader,
             overlay: [OverlayFile::empty(); FILES],
             descriptors: [Descriptor::empty(); FDS],
+            positions: [0; FDS],
         }
     }
 
@@ -383,6 +385,16 @@ impl<'a, R: BaseReader, const FILES: usize, const FILE_SIZE: usize, const FDS: u
             .iter()
             .position(|descriptor| !descriptor.open)
             .ok_or(VfsError::DescriptorLimit)?;
+        // Duplicates share a position until their last close. A free descriptor
+        // implies a position unreferenced by every live descriptor.
+        let position = (0..FDS)
+            .find(|position| {
+                !self
+                    .descriptors
+                    .iter()
+                    .any(|fd| fd.open && fd.position == *position)
+            })
+            .ok_or(VfsError::DescriptorLimit)?;
         let overlay_index = self.find_overlay(path.as_bytes());
         let object: usize;
         let overlay: bool;
@@ -428,11 +440,12 @@ impl<'a, R: BaseReader, const FILES: usize, const FILE_SIZE: usize, const FDS: u
             self.overlay[object].len = 0;
         }
 
+        self.positions[position] = 0;
         self.descriptors[slot] = Descriptor {
             open: true,
             overlay,
             object,
-            offset: 0,
+            position,
             readable,
             writable,
             close_on_exec: flags & O_CLOEXEC != 0,
@@ -446,49 +459,48 @@ impl<'a, R: BaseReader, const FILES: usize, const FILE_SIZE: usize, const FDS: u
             return Err(VfsError::PermissionDenied);
         }
         let state = self.descriptors[slot];
+        let offset = self.positions[state.position];
         let available = if state.overlay {
-            self.overlay[state.object].len.saturating_sub(state.offset)
+            self.overlay[state.object].len.saturating_sub(offset)
         } else {
             let entry = self.index.entry(state.object)?;
             usize::try_from(entry.size)
                 .map_err(|_| VfsError::FileTooLarge)?
-                .saturating_sub(state.offset)
+                .saturating_sub(offset)
         };
         let length = available.min(output.len());
         if state.overlay {
-            output[..length].copy_from_slice(
-                &self.overlay[state.object].data[state.offset..state.offset + length],
-            );
+            output[..length]
+                .copy_from_slice(&self.overlay[state.object].data[offset..offset + length]);
         } else {
             let entry = self.index.entry(state.object)?;
-            self.reader.read_at(
-                entry.data_offset + state.offset as u64,
-                &mut output[..length],
-            )?;
+            self.reader
+                .read_at(entry.data_offset + offset as u64, &mut output[..length])?;
         }
-        self.descriptors[slot].offset += length;
+        self.positions[state.position] += length;
         Ok(length)
     }
 
     pub fn write(&mut self, descriptor: i32, input: &[u8]) -> Result<usize, VfsError> {
         let slot = self.descriptor(descriptor)?;
         let state = self.descriptors[slot];
+        let offset = self.positions[state.position];
         if !state.writable || !state.overlay {
             return Err(VfsError::PermissionDenied);
         }
-        let end = state
-            .offset
+        let end = offset
             .checked_add(input.len())
             .ok_or(VfsError::FileTooLarge)?;
         if end > FILE_SIZE {
             return Err(VfsError::FileTooLarge);
         }
-        self.overlay[state.object].data[state.offset..end].copy_from_slice(input);
+        self.overlay[state.object].data[offset..end].copy_from_slice(input);
         self.overlay[state.object].len = self.overlay[state.object].len.max(end);
-        self.descriptors[slot].offset = end;
+        self.positions[state.position] = end;
         Ok(input.len())
     }
 
+    /// Share the open-file offset while keeping close-on-exec descriptor-local.
     pub fn duplicate(&mut self, descriptor: i32, close_on_exec: bool) -> Result<i32, VfsError> {
         let source = self.descriptor(descriptor)?;
         let target = self
@@ -992,11 +1004,12 @@ mod tests {
         let mut output = [0; 3];
         assert_eq!(vfs.read(fresh, &mut output), Ok(3));
         assert_eq!(&output, b"new");
-        assert_eq!(vfs.read(old, &mut output), Ok(3));
-        assert_eq!(&output, b"old");
+        assert_eq!(vfs.read(old, &mut output[..1]), Ok(1));
+        assert_eq!(&output[..1], b"o");
         vfs.close(old).unwrap();
-        assert_eq!(vfs.read(alias, &mut output), Ok(3));
-        assert_eq!(&output, b"old");
+        assert_eq!(vfs.read(alias, &mut output), Ok(2));
+        assert_eq!(&output[..2], b"ld");
+        assert_eq!(vfs.read(alias, &mut output), Ok(0));
         vfs.close_on_exec();
         assert_eq!(vfs.close(alias), Err(VfsError::InvalidDescriptor));
         vfs.close(fresh).unwrap();
@@ -1098,4 +1111,65 @@ mod tests {
         assert_eq!(first.overlay_files(), 0);
         assert_eq!(second.overlay_files(), 0);
     }
+
+    #[test]
+    fn duplicated_reads_share_offset_while_separate_opens_do_not() {
+        let bytes = index_bytes();
+        let mut fs: VirtualFs<'_, Reader, 4, 32, 4> =
+            VirtualFs::new(Index::new(&bytes).unwrap(), Reader(*b"BASETOOL"));
+        let original = fs.open(b"/base", O_READ).unwrap();
+        let alias = fs.duplicate(original, false).unwrap();
+        let separate = fs.open(b"/base", O_READ).unwrap();
+        let mut byte = [0];
+        assert_eq!(fs.read(original, &mut byte), Ok(1));
+        assert_eq!(&byte, b"B");
+        assert_eq!(fs.read(alias, &mut byte), Ok(1));
+        assert_eq!(&byte, b"A");
+        assert_eq!(fs.read(separate, &mut byte), Ok(1));
+        assert_eq!(&byte, b"B");
+        assert_eq!(fs.read(original, &mut byte), Ok(1));
+        assert_eq!(&byte, b"S");
+    }
+
+    #[test]
+    fn duplicated_writes_and_reads_advance_the_same_offset() {
+        let bytes = index_bytes();
+        let mut fs: VirtualFs<'_, Reader, 4, 32, 4> =
+            VirtualFs::new(Index::new(&bytes).unwrap(), Reader(*b"BASETOOL"));
+        let original = fs.open(b"/base", O_READ | O_WRITE).unwrap();
+        let alias = fs.duplicate(original, false).unwrap();
+        assert_eq!(fs.write(alias, b"X"), Ok(1));
+        let mut byte = [0];
+        assert_eq!(fs.read(original, &mut byte), Ok(1));
+        assert_eq!(&byte, b"A");
+        assert_eq!(fs.write(original, b"Y"), Ok(1));
+        assert_eq!(fs.read(alias, &mut byte), Ok(1));
+        assert_eq!(&byte, b"E");
+        let separate = fs.open(b"/base", O_READ).unwrap();
+        let mut contents = [0; 4];
+        assert_eq!(fs.read(separate, &mut contents), Ok(4));
+        assert_eq!(&contents, b"XAYE");
+    }
+
+    #[test]
+    fn duplicated_offset_survives_close_slot_reuse_and_cloexec() {
+        let bytes = index_bytes();
+        let mut fs: VirtualFs<'_, Reader, 4, 32, 4> =
+            VirtualFs::new(Index::new(&bytes).unwrap(), Reader(*b"BASETOOL"));
+        let original = fs.open(b"/base", O_READ).unwrap();
+        let alias = fs.duplicate(original, true).unwrap();
+        let mut byte = [0];
+        fs.read(original, &mut byte).unwrap();
+        fs.close(original).unwrap();
+        let reused = fs.open(b"/base", O_READ).unwrap();
+        assert_eq!(reused, original);
+        fs.read(reused, &mut byte).unwrap();
+        assert_eq!(&byte, b"B");
+        fs.read(alias, &mut byte).unwrap();
+        assert_eq!(&byte, b"A");
+        fs.close_on_exec();
+        assert_eq!(fs.read(alias, &mut byte), Err(VfsError::InvalidDescriptor));
+        fs.read(reused, &mut byte).unwrap();
+        assert_eq!(&byte, b"A");
+    }
 }
