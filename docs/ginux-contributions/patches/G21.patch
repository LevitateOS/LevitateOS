+    pub fn restore_entry(
+        &mut self,
+        path: &[u8],
+        directory: bool,
+        mode: u32,
+        length: usize,
+        seen: &mut [bool; OBJECTS],
+        mut read: impl FnMut(&mut [u8]) -> Result<(), &'static [u8]>,
