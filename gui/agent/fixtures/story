# Claude Code

def claude_env(story, tag="", config=None, extra=None):
    return environment("claude-" + story, dict({"LEVITATE_AGENT": "claude"}, **(extra or {})), config, story=story, tag=tag)


def flag(args, name):
    return args[args.index(name) + 1] if name in args else None


def story_claude_plain():
    env, log = claude_env("plain")
    run = Run(env, log, prompt="Install the thing", app="recipe", title="Install it with Claude").finish()
    check(run.code == 0 and run.kinds()[-1] == "done" and "failed" not in run.kinds(), "claude plain: ends with done")
    plan = run.of("plan")
    check(len(plan) == 1 and plan[0]["steps"] == [["1", "Look around"], ["2", "Make the change"], ["3", "Check it"]],
          "claude plain: the todo list is one plan of three steps")
    steps = [(e["step"], e["status"]) for e in run.of("step")]
    check(steps == [("1", "running"), ("1", "done"), ("2", "running"), ("2", "done"), ("3", "done")],
          "claude plain: steps run and finish in order (%s)" % steps)
    lines = [e["line"] for e in run.of("output")]
    check("$ ls -l" in lines and "$ seq 1 100" in lines and "write /home/x/a.txt" in lines and "update /home/x/b.txt" in lines,
          "claude plain: commands are $ lines, file changes say write and update")
    check(len(lines) < 50 and any("more lines" in l for l in lines), "claude plain: long output is capped")
    dids = run.of("did")
    check([d["kind"] for d in dids] == ["command", "command", "write", "write", "search"],
          "claude plain: one did for each thing done (%s)" % [d["kind"] for d in dids])
    check(dids and dids[0]["what"] == "ls -l" and dids[0]["exit_code"] == 0 and dids[0]["as_administrator"] is False
          and dids[0]["asked"] is False and dids[0]["approved"] is None, "claude plain: a command's did")
    check([d["what"] for d in dids[2:]] == ["/home/x/a.txt", "/home/x/b.txt", "levitate recipe format"],
          "claude plain: a did for each path and the search")
    check([e["text"] for e in run.of("say")] == ["Working on it.", "I made the change. Everything checks out."],
          "claude plain: each text is said, thinking is not")
    check(run.of("agent") and run.of("agent")[0]["summary"] == "I made the change. Everything checks out.",
          "claude plain: the result is the summary")
    calls = run.calls()
    check(len(calls) == 1, "claude plain: claude ran once")
    if calls:
        args = calls[0]["args"]
        check(args[0] == "-p" and flag(args, "--output-format") == "stream-json" and "--verbose" in args,
              "claude plain: print mode, stream-json and --verbose")
        check(flag(args, "--permission-mode") == "dontAsk" and flag(args, "--allowedTools") == "Read,Glob,Grep,WebSearch,WebFetch"
              and flag(args, "--disallowedTools") == "Edit,Write,NotebookEdit" and "--resume" not in args and "--add-dir" not in args,
              "claude plain: read-only tools allowed, writing tools taken away, nothing asked (%s)" % args)
        check("RUN-AS-ADMINISTRATOR" in (flag(args, "--append-system-prompt") or "") and "never use sudo" in (flag(args, "--append-system-prompt") or "").lower(),
              "claude plain: the contract goes in --append-system-prompt")
        check("Install the thing" in calls[0]["prompt"] and "the recipe window" in calls[0]["prompt"] and calls[0]["cwd"] == HOME,
              "claude plain: the request is on standard input, in the home folder")
    record = ends_with(run, "done")
    check(record and record[0].get("agent") == "claude", "claude plain: the record names the agent")


