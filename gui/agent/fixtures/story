    run.finish(on_question=lambda e: "Approve")
    q = run.of("question")
    check(len(q) == 1 and q[0].get("kind") == "command" and q[0].get("command") == "echo hello from the person",
          "run: a command question")
    dids = run.of("did")
    check(len(dids) == 1 and dids[0]["as_administrator"] is False and dids[0]["asked"] is True
