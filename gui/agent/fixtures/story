def story_set_aside_refused(adapter="codex"):
    """A path not on the list, an ask-first place not asked about, a link that
    leads out of home: refused, nothing moved."""
    name = "setaside-refused-" + adapter
    base = os.path.join(HOME, "refused-" + adapter)
    shutil.rmtree(base, ignore_errors=True)
    outside = os.path.join(SCRATCH, "outside-" + adapter)
    shutil.rmtree(outside, ignore_errors=True)
    secret = made(os.path.join(outside, "secret.txt"), 77)
    listed = made(os.path.join(base, "cache/listed.bin"), 100)
    other = made(os.path.join(base, "cache/not-on-the-list.bin"), 200)
    asked = made(os.path.join(base, "Downloads/asked.iso"), 300)
    link = os.path.join(base, "cache/link-out")
    os.symlink(outside, link)
    holding = os.path.join(base, "holding")
    env, log = script_environment(name, [
        "SET-ASIDE: %s\nSET-ASIDE: %s\nSET-ASIDE: %s/\nSET-ASIDE: %s/../Downloads/asked.iso" % (other, asked, link, os.path.join(base, "cache")),
        "I will leave them."], adapter)
    request = {"holding": holding, "places": [listed, asked, link], "ask_first": [asked]}
    run = Run(env, log, extra={"set_aside": request}).finish()
    check(run.code == 0 and run.kinds()[-1] == "done", "%s: the run ends done (%s)" % (name, run.code))
    check(os.path.exists(other) and os.path.exists(asked) and os.path.exists(listed), "%s: nothing was moved" % name)
    check(os.path.islink(link) and os.path.exists(secret), "%s: the link and what it leads to are untouched" % name)
    manifest = manifest_of(holding)
    check(manifest is None or manifest.get("entries") == [], "%s: nothing was recorded as held (%s)" % (name, manifest))
    check(not os.path.exists(os.path.join(holding, outside.lstrip("/"))), "%s: nothing of the outside folder is in the holding folder" % name)
    said = places_of(run)
    check(other not in said, "%s: a path not on the list gets no place event" % name)
    check(asked not in said, "%s: an ask-first place that was not asked about gets no place event" % name)
    check(said.get(link, {}).get("outcome") == "could-not" and "link" in said[link]["why"] and "home folder" in said[link]["why"],
          "%s: the link that leads out is could-not, and says so (%s)" % (name, said.get(link)))
    check(len(run.of("question")) == 0, "%s: nobody was asked" % name)
    calls = run.calls()
    if len(calls) == 2:
        told = calls[1]["prompt"]
        check("%s: refused. It is not on the list" % other in told, "%s: the agent is told the other path is not on the list" % name)
        check("%s: refused. The person has to be asked" % asked in told, "%s: the agent is told to ask first (%s)" % (name, told[:400]))
        check("%s: not done, it is a link that leads out of your home folder" % link in told, "%s: the agent is told about the link" % name)
        check(told.count("Nothing was moved") >= 2, "%s: the agent is told nothing was moved" % name)
    else:
        check(False, "%s: two turns (%s)" % (name, len(calls)))
    ends_with(run, "done")


def story_set_aside_fails():
    """A holding folder or a place outside the home folder fails the run at once."""
    base = os.path.join(HOME, "fails")
    shutil.rmtree(base, ignore_errors=True)
    inside = made(os.path.join(base, "cache/x.bin"), 10)
    outside = os.path.join(SCRATCH, "outside-fails")
    os.makedirs(outside, exist_ok=True)
    os.symlink(outside, os.path.join(base, "way-out"))
    cases = {
        "holding outside home": ({"holding": os.path.join(outside, "h"), "places": [inside]}, "outside your home folder"),
        "holding behind a link": ({"holding": os.path.join(base, "way-out/h"), "places": [inside]}, "outside your home folder"),
        "holding the home folder itself": ({"holding": HOME, "places": [inside]}, "outside your home folder"),
        "holding not a full path": ({"holding": "holding", "places": [inside]}, "not a full path"),
        "a place outside home": ({"holding": os.path.join(base, "h"), "places": [inside, "/etc/hostname"]}, "outside your home folder"),
        "a place behind a linked folder": ({"holding": os.path.join(base, "h"), "places": [os.path.join(base, "way-out/secret")]}, "outside your home folder"),
        "a place inside the holding folder": ({"holding": os.path.join(base, "cache"), "places": [inside]}, "one inside the other"),
        "ask_first not on the list": ({"holding": os.path.join(base, "h"), "places": [inside], "ask_first": [os.path.join(base, "other")]}, "not on the list"),
        "places not a list": ({"holding": os.path.join(base, "h"), "places": "x"}, "must name the holding folder"),
        "not an object": ("everything", "must name the holding folder"),
    }
    for words, (request, expect) in cases.items():
        env, log = script_environment("setaside-fails", ["never said"], tag=str(abs(hash(words)) % 10000))
        run = Run(env, log, extra={"set_aside": request}).finish()
        failed = run.of("failed")
        check(run.code == 1 and len(failed) == 1 and expect in failed[0]["reason"],
              "set_aside %s: the run fails at once with a reason (exit %s, %s)" % (words, run.code, failed))
        check(run.calls() == [], "set_aside %s: the agent was not started" % words)
        check(os.path.exists(inside) and not os.path.exists(os.path.join(base, "h")), "set_aside %s: nothing was moved or made" % words)
        ends_with(run, "failed")


