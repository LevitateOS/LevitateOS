def story_fails(name, words, state="failed"):
    env, log = environment(name)
    run = Run(env, log).finish()
    check(run.code != 0 and run.code is not None, name + ": exits non-zero")
    failed = run.of("failed")
    check(len(failed) == 1 and words in failed[0].get("reason", ""),
          "%s: failed with the reason (%s)" % (name, failed))
    check(run.kinds()[-1] == "failed" and "done" not in run.kinds(), name + ": failed is the last event")
    record = ends_with(run, state)
    return failed[0].get("reason", "") if failed else ""


def story_stop():
    env, log = environment("hang")
    run = Run(env, log)
    run.read(until=lambda e: e.get("event") == "output" and e.get("line") == "$ sleep 300")
    for _ in range(50):
        if os.path.exists(log + ".pids"):
            break
        time.sleep(0.1)
    pids = [int(p) for p in open(log + ".pids").read().split()] if os.path.exists(log + ".pids") else []
    check(len(pids) == 2, "stop: the stand-in and its own child are running")
    run.proc.send_signal(signal.SIGTERM)
    try:
        run.proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        run.proc.kill()
        check(False, "stop: levitate-agent exits on SIGTERM")
    run.proc.stderr.read()

    def gone(pid):
        for _ in range(30):
            try:
                if open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()[0] == "Z":
                    return True
            except OSError:
                return True
            time.sleep(0.1)
        return False

    check(all(gone(p) for p in pids), "stop: the agent and what it started are gone")
    ends_with(run, "stopped")
    return run


def made(path, size, make_parent=True):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as out:
        out.write(b"x" * size)
    return path


def script_environment(name, messages, adapter="codex", tag=""):
    """An environment whose stand-in agent says `messages`, one for each turn."""
    config = {"agent": "claude"} if adapter == "claude" else None
    env, log = environment(name + tag, config=config, story="script")
    script = os.path.join(SCRATCH, name + tag + ".script.json")
    json.dump(messages, open(script, "w"))
    env["LEVITATE_STANDIN_SCRIPT"] = script
    return env, log


def manifest_of(holding):
    try:
        return json.load(open(os.path.join(holding, "manifest.json")))
    except (OSError, ValueError):
        return None


def places_of(run):
    return {e["path"]: e for e in run.of("place")}


def story_set_aside(adapter):
    """The helper moves, the agent only decides: two places set aside, one kept,
    one that cannot, one asked about first and set aside after a yes."""
    name = "setaside-" + adapter
    base = os.path.join(HOME, "aside-" + adapter)
    shutil.rmtree(base, ignore_errors=True)
    a = made(os.path.join(base, "cache/a/one.bin"), 1000)
    made(os.path.join(base, "cache/a/deep/two.bin"), 500)
    a = os.path.join(base, "cache/a")
    b = made(os.path.join(base, "cache/b.bin"), 2000)
    c = made(os.path.join(base, "keep/c.bin"), 300)
    d = made(os.path.join(base, "stuck/d.bin"), 400)
    e = made(os.path.join(base, "Downloads/e.iso"), 5000)
    holding = os.path.join(base, ".local/share/levitate/set-aside/20261111-140500")
    ask = "Set %s aside? It was not opened for a year. | Remove it | Keep it" % e
    env, log = script_environment(name, [
        "Going through the list.\nSET-ASIDE: %s\nSET-ASIDE: %s\nKEEP: %s | still in use\nCANNOT: %s | files are open\nASK: %s" % (a, b, c, d, ask),
        "SET-ASIDE: " + e,
        "Everything on the list is decided."], adapter)
    asked = []
    request = {"holding": holding, "places": [a, b, c, d, e], "ask_first": [e]}
    run = Run(env, log, prompt="Clear these places", app="disk", title="Set the mess aside", extra={"set_aside": request}).finish(
        on_question=lambda q: asked.append(q) or "Remove it")
    check(run.code == 0 and run.kinds()[-1] == "done" and "failed" not in run.kinds(),
          "%s: the run is done (exit %s, %s)" % (name, run.code, run.kinds()[-3:]))
    check(len(asked) == 1 and run.of("question")[0]["text"].startswith("Set %s aside?" % e),
          "%s: the person is asked once, about the ask-first place, and about no move (%s questions)" % (name, len(asked)))
    for path in (a, b, e):
        check(not os.path.lexists(path), "%s: %s is no longer where it was" % (name, path))
        check(os.path.exists(os.path.join(holding, path.lstrip("/"))), "%s: %s is in the holding folder under its own path" % (name, path))
    check(os.path.exists(os.path.join(holding, a.lstrip("/"), "deep/two.bin")), "%s: a folder is moved whole" % name)
    for path in (c, d):
        check(os.path.exists(path) and not os.path.exists(os.path.join(holding, path.lstrip("/"))), "%s: %s was not moved" % (name, path))
    manifest = manifest_of(holding)
    want = [{"from": a, "held": a.lstrip("/"), "bytes": 1500}, {"from": b, "held": b.lstrip("/"), "bytes": 2000},
            {"from": e, "held": e.lstrip("/"), "bytes": 5000}]
    check(manifest == {"version": 1, "entries": want}, "%s: the manifest says exactly what was moved (%s)" % (name, manifest))
    said = places_of(run)
    check(said.get(a, {}).get("outcome") == "set-aside" and said[a]["bytes"] == 1500 and said[b]["outcome"] == "set-aside"
          and said[b]["bytes"] == 2000, "%s: set-aside place events carry the size (%s)" % (name, said.get(a)))
    check(said.get(c, {}).get("outcome") == "kept" and said[c]["why"] == "still in use", "%s: KEEP gives a kept event with its reason" % name)
    check(said.get(d, {}).get("outcome") == "could-not" and said[d]["why"] == "files are open", "%s: CANNOT gives a could-not event with its reason" % name)
    check(said.get(e, {}).get("outcome") == "set-aside" and said[e].get("asked") is True and said[e].get("answer") == "Remove it",
          "%s: the asked place says it was asked and what the person answered (%s)" % (name, said.get(e)))
    check(len(run.of("place")) == 5, "%s: one place event for each place (%s)" % (name, len(run.of("place"))))
    check(sorted(d_["what"] for d_ in run.of("did") if d_["kind"] == "write") == sorted([a, b, e])
          and all(d_["asked"] is False for d_ in run.of("did")), "%s: a did for each move, none asked about" % name)
    calls = run.calls()
    check(len(calls) == 3, "%s: three turns (%s)" % (name, len(calls)))
    if len(calls) == 3:
        check("SET-ASIDE: /full/path" in calls[0]["prompt"] or "SET-ASIDE: /full/path" in " ".join(calls[0]["args"]),
              "%s: the agent is told the convention" % name)
        every = calls[0]["prompt"] + " ".join(calls[0]["args"])
        check(e in every and "Ask first" in every, "%s: the agent is told which place to ask about first" % name)
        check("SET-ASIDE %s: done" % a in calls[1]["prompt"] and "KEEP %s: noted" % c in calls[1]["prompt"]
              and "The person answered: Remove it" in calls[1]["prompt"], "%s: the next turn tells what the helper did and the answer (%s)" % (name, calls[1]["prompt"][:200]))
        check("SET-ASIDE %s: done" % e in calls[2]["prompt"], "%s: the turn after tells the result for the asked place" % name)
        if adapter == "codex":
            check(all(c_["args"][c_["args"].index("-s") + 1] == "read-only" for c_ in calls[:1]) and
                  all("workspace-write" not in " ".join(c_["args"]) for c_ in calls),
                  "%s: the agent never got the right to write" % name)
        else:
            check(all("dontAsk" in c_["args"] and "acceptEdits" not in c_["args"] for c_ in calls),
                  "%s: the agent never got the right to write" % name)
    record = ends_with(run, "done")
