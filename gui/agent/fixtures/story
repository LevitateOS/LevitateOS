def settings():
    A = BINARY

    def call(env, *args):
        return subprocess.run([A, *args], env=env, capture_output=True, text=True, timeout=30)

    env, _ = environment("settings")
    cfg = env["XDG_CONFIG_HOME"]
    file = os.path.join(cfg, "levitate/agent.json")
    out = call(env, "--settings")
    check(out.returncode == 0 and json.loads(out.stdout) == {"agent": "codex", "run_commands": "ask", "notices": True, "file": file},
          "settings: the defaults, and the file it would use (%s)" % out.stdout)
    check(not os.path.exists(file), "settings: reading writes nothing")

    out = call(env, "--set", "run_commands=allowed")
    check(out.returncode == 0 and json.loads(out.stdout)["run_commands"] == "allowed",
          "set: run_commands=allowed is accepted and printed (%s)" % out.stderr)
    check(json.load(open(file)) == {"run_commands": "allowed"}, "set: the file says so")
    # Another key in the file stays.
    json.dump({"run_commands": "allowed", "future": [1, 2]}, open(file, "w"))
    out = call(env, "--set", "agent=" + DISK_AGENT)
    check(out.returncode == 0 and json.loads(out.stdout)["agent"] == DISK_AGENT, "set: a program by its full path is accepted")
    check(json.load(open(file)) == {"run_commands": "allowed", "future": [1, 2], "agent": DISK_AGENT},
          "set: the other keys of the file are kept (%s)" % open(file).read())
    check(json.loads(call(env, "--settings").stdout)["agent"] == DISK_AGENT, "settings: what was set is in force")
    out = call(env, "--set", "agent=codex")
    check(out.returncode == 0 and json.loads(out.stdout)["agent"] == "codex", "set: agent=codex is accepted")
    out = call(env, "--set", "run_commands=ask")
    check(out.returncode == 0 and json.loads(out.stdout)["run_commands"] == "ask", "set: run_commands=ask is accepted")
    out = call(env, "--set", "notices=false")
    check(out.returncode == 0 and json.loads(out.stdout)["notices"] is False and json.load(open(file))["notices"] is False,
          "set: notices=false is accepted, printed, and written as a boolean (%s)" % out.stderr)
    check(json.loads(call(env, "--settings").stdout)["notices"] is False, "settings: notices=false is in force")
    out = call(env, "--set", "notices=true")
    check(out.returncode == 0 and json.loads(out.stdout)["notices"] is True, "set: notices=true is accepted")
    out = call(env, "--set", "agent=claude")
    check(out.returncode == 0 and json.loads(out.stdout)["agent"] == "claude", "set: agent=claude is accepted")
    out = call(env, "--set", "agent=codex")
    check(out.returncode == 0 and json.loads(out.stdout)["agent"] == "codex", "set: agent=codex is accepted again")

    before = open(file).read()
    for words, why in [("agent=nothing", "not a path"), ("agent=/nonexistent/agent", "does not exist"),
                       ("agent=" + HOME, "a folder"), ("agent=" + os.path.join(HERE, "records.txt"), "a missing file"),
                       ("run_commands=sometimes", "a value that is not one"), ("notices=maybe", "a value that is not a boolean"), ("colour=blue", "a key that is not one"),
                       ("agent", "no value")]:
        out = call(env, "--set", words)
        check(out.returncode != 0 and out.stdout == "" and len(out.stderr.strip().splitlines()) == 1
              and out.stderr.strip().endswith("."), "set: %s (%s) is refused with one sentence (%r)" % (words, why, out.stderr))
    plain = os.path.join(SCRATCH, "plain-file")
    open(plain, "w").write("x")
    out = call(env, "--set", "agent=" + plain)
    check(out.returncode != 0 and "not a program" in out.stderr, "set: a file that cannot be run is refused (%r)" % out.stderr)
    check(open(file).read() == before, "set: a refused value changes nothing")

    # Sign in and out go through the stand-in; its `login status` follows.
    def signed(env):
        return json.loads(call(env, "--status").stdout)["agents"][0]["signed_in"]
    env, _ = environment("settings")
    check(signed(env) is True, "sign-in: the stand-in starts signed in")
    out = call(env, "--sign-out")
    check(out.returncode == 0 and "logged out" in out.stderr and out.stdout == "", "sign-out: runs codex logout (%r)" % out.stderr)
    check(signed(env) is False, "sign-out: login status says so")
    proc = subprocess.Popen([A, "--sign-in"], env=env, stderr=subprocess.PIPE, text=True)
    first = proc.stderr.readline()
    check("localhost" in first and proc.poll() is None, "sign-in: a line arrives while codex is still going (%r)" % first)
    rest = proc.stderr.read()
    proc.wait()
    check(proc.returncode == 0 and "https://auth.standin.invalid" in rest and "logged in" in rest,
          "sign-in: the address and the end are passed through (%r)" % rest)
    check(signed(env) is True, "sign-in: login status says so")
    env, _ = environment("settings", {"LEVITATE_STANDIN_LOGIN_FAILS": "1"})
    out = call(env, "--sign-out")
    out = call(env, "--sign-in")
    check(out.returncode == 1 and "was not completed" in out.stderr, "sign-in: codex's exit code is ours (%d)" % out.returncode)
    env, _ = environment("settings", {"LEVITATE_AGENT_CODEX": os.path.join(SCRATCH, "none")})
    out = call(env, "--sign-in")
    check(out.returncode != 0 and out.stderr.strip() == "Codex is not installed.", "sign-in: no Codex says so (%r)" % out.stderr)
    # Stopped half way: the stand-in's login is still going and goes too.
    env, _ = environment("settings", {"LEVITATE_STANDIN_LOGIN_SECONDS": "30"})
    call(env, "--sign-out")
    proc = subprocess.Popen([A, "--sign-in"], env=env, stderr=subprocess.PIPE, text=True)
    proc.stderr.readline()
    proc.send_signal(signal.SIGTERM)
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proc.kill()
        check(False, "sign-in: SIGTERM ends it")
    check(proc.returncode == 143 and signed(env) is False, "sign-in: stopped, it ends with 143 and nobody is signed in")
    # Claude Code: `claude auth login`, `claude auth logout`, `claude auth status`.
    env, _ = environment("settings", {"LEVITATE_AGENT": "claude"})

    def claude_signed(env):
        return [a for a in json.loads(call(env, "--status").stdout)["agents"] if a["id"] == "claude"][0]["signed_in"]
    check(claude_signed(env) is True, "claude sign-in: the stand-in starts signed in")
    out = call(env, "--sign-out")
    check(out.returncode == 0 and "logged out" in out.stderr and out.stdout == "", "claude sign-out: runs claude auth logout (%r)" % out.stderr)
    check(claude_signed(env) is False, "claude sign-out: auth status says so (exit code 1)")
    out = call(env, "--sign-in")
    check(out.returncode == 0 and "https://auth.standin.invalid" in out.stderr and "successful" in out.stderr and out.stdout == "",
          "claude sign-in: runs claude auth login and passes what it prints (%r)" % out.stderr)
    check(claude_signed(env) is True, "claude sign-in: auth status says so")
    env, _ = environment("settings", {"LEVITATE_AGENT": "claude", "LEVITATE_STANDIN_LOGIN_FAILS": "1"})
    call(env, "--sign-out")
    out = call(env, "--sign-in")
    check(out.returncode == 1 and "was not completed" in out.stderr, "claude sign-in: Claude's exit code is ours (%d)" % out.returncode)
    env, _ = environment("settings", {"LEVITATE_AGENT": "claude", "LEVITATE_AGENT_CLAUDE": os.path.join(SCRATCH, "none")})
    out = call(env, "--sign-in")
    check(out.returncode != 0 and out.stderr.strip() == "Claude Code is not installed.", "claude sign-in: no Claude Code says so (%r)" % out.stderr)
    # Another program than Codex signs in by itself.
    env, _ = environment("settings", {"LEVITATE_AGENT": DISK_AGENT})
    for flag in ("--sign-in", "--sign-out"):
        out = call(env, flag)
        check(out.returncode != 0 and out.stderr.strip() == "agent signs in by itself; there is nothing to do here.",
              "%s: another program signs in by itself (%r)" % (flag, out.stderr))


# ---------------------------------------------------------------------------
# Runs that outlive the window that started them

def wait_for(condition, seconds=15):
    end = time.time() + seconds
    while time.time() < end:
        if condition():
            return True
        time.sleep(0.05)
    return False


def gone(pid):
    for _ in range(30):
        try:
            if open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()[0] == "Z":
                return True
        except OSError:
            return True
        time.sleep(0.1)
    return False


def alive(pid):
    try:
        return open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()[0] != "Z"
    except OSError:
        return False


def entry(env, run_id):
    runs = json.loads(subprocess.check_output([BINARY, "--list"], env=env))["runs"]
    return next((r for r in runs if r["id"] == run_id), None)


def attach(env, log, run_id):
    return Run(env, log, argv=[BINARY, "--attach", run_id])


def is_question(event):
    return event.get("event") == "question"


def story_survives():
    # A run goes on without the window that started it, and an attached
    # window finishes it by answering.
    env, log = environment("asks", tag="-survives")
    a = Run(env, log, prompt="Paint it", title="Survives")
    a.read(until=is_question)
    run_id = a.run_id()
    check(len(a.of("question")) == 1 and run_id, "survives: the run asks its question")
    a.close_input()
    check(a.wait(10) == 75, "survives: a client whose input closed while the run waits for an answer leaves with 75 (got %s)" % a.code)
    mine = entry(env, run_id)
    check(mine and mine["state"] == "waiting" and mine["attachable"] is True,
          "survives: --list says the run waits and can be attached to (%s)" % mine)
    b = attach(env, log, run_id)
    b.read(until=is_question)
    check(len(b.of("question")) == 1 and b.of("question")[0]["text"] == "Which colour?",
          "survives: an attached client is first given the events so far, the question among them")
    check(all("t" in e for e in b.events), "survives: an attached client reads events with their time")
    b.answer(b.of("question")[0], "Blue")
    b.read()
    check(b.code == 0 and b.kinds()[-1] == "done" and "answer" in b.kinds(),
          "survives: the answer from the attached client finishes the run, and it sees the answer and done (%s)" % b.kinds())
    calls = a.calls()
    check(len(calls) == 2 and calls[1]["prompt"] == "Blue", "survives: the agent is resumed with that answer")
    record = ends_with(a, "done")
    check([l.get("event") for l in record if l.get("event") in ("question", "answer")] == ["question", "answer"],
          "survives: the record has the question and the answer once")
    check(record and record[0].get("pid") and record[0].get("host") and record[0]["pid"] != record[0]["host"],
          "survives: the record names the process that asked (pid) and the one the run lives in (host)")
    after = entry(env, run_id)
    check(after and after["state"] == "done" and after["attachable"] is False, "survives: afterwards --list says done, not attachable")
    out = subprocess.run([BINARY, "--attach", run_id], env=env, capture_output=True, text=True, timeout=15)
    check(out.returncode == 1 and "ended" in out.stderr, "survives: a run that has ended cannot be attached to (%r)" % out.stderr)
    out = subprocess.run([BINARY, "--attach", "nonesuch"], env=env, capture_output=True, text=True, timeout=15)
    check(out.returncode == 1 and "no run" in out.stderr, "survives: an unknown run cannot be attached to (%r)" % out.stderr)


def story_two_clients():
    env, log = environment("asks", tag="-two")
    a = Run(env, log, prompt="Paint it", title="Two clients")
    a.read(until=is_question)
    run_id = a.run_id()
    b = attach(env, log, run_id)
    b.read(until=is_question)
    check(len(a.of("question")) == 1 and len(b.of("question")) == 1, "two clients: both see the question")
    # Both answer, differently: only the first counts.
    a.answer(a.of("question")[0], "Red")
    b.answer(b.of("question")[0], "Blue")
    a.read()
    b.read()
    check(a.code == 0 and b.code == 0 and a.kinds()[-1] == "done" and b.kinds()[-1] == "done",
          "two clients: both see the run end with done (%s, %s)" % (a.code, b.code))
    check(a.of("agent") and b.of("agent") and a.of("agent")[0]["summary"] == b.of("agent")[0]["summary"], "two clients: both see the same events")
    record = ends_with(a, "done")
    answers = [l for l in record if l.get("event") == "answer"]
    calls = a.calls()
    check(len(answers) == 1 and len(calls) == 2 and calls[1]["prompt"] == answers[0]["answer"] and answers[0]["answer"] in ("Red", "Blue"),
          "two clients: the answers count once (record: %s, agent resumed %d times)" % ([x["answer"] for x in answers], len(calls) - 1))
    check("answer" not in a.kinds() and a.kinds().count("question") == 1,
          "two clients: the window that started the run reads exactly what apps always read")
    check(b.kinds().count("answer") == 1, "two clients: an attached window is told the answer once")


def start_hang(tag, title):
    env, log = environment("hang", tag=tag)
    run = Run(env, log, title=title)
    run.read(until=lambda e: e.get("event") == "output" and e.get("line") == "$ sleep 300")
    wait_for(lambda: os.path.exists(log + ".pids"))
    pids = [int(p) for p in open(log + ".pids").read().split()] if os.path.exists(log + ".pids") else []
    check(len(pids) == 2, "%s: the stand-in and its own child are running" % title)
    return env, log, run, pids, run.run_id()


def story_leaving_and_stopping():
    # Leaving does not stop a run; --stop does, and so does SIGTERM to a client.
    env, log, a, pids_a, id_a = start_hang("-a", "Input closed")
    env, log, b, pids_b, id_b = start_hang("-b", "Hung up")
    env, log, c, pids_c, id_c = start_hang("-c", "Killed")

    a.close_input()
    b.proc.send_signal(signal.SIGHUP)
    c.proc.kill()
    check(b.wait(10) == 129, "leaving: a client that gets SIGHUP leaves with 129 (got %s)" % b.code)
    time.sleep(1.0)
    check(a.proc.poll() is None, "leaving: a client whose input closed stays and goes on relaying while the run works")
    for name, rid, pids in (("input closed", id_a, pids_a), ("SIGHUP", id_b, pids_b), ("SIGKILL", id_c, pids_c)):
        mine = entry(env, rid)
        check(mine and mine["state"] == "running" and mine["attachable"] is True,
              "leaving: the run goes on after %s and can be attached to (%s)" % (name, mine))
        check(all(alive(p) for p in pids), "leaving: the agent and what it started still run after %s" % name)

    # SIGTERM to an attached client is its window's Stop: the run ends.
    d = attach(env, log, id_a)
    d.read(until=lambda e: e.get("event") == "output" and e.get("line") == "$ sleep 300")
    check(d.of("output"), "leaving: an attached client is given the events so far of a working run")
    d.proc.send_signal(signal.SIGTERM)
    check(d.wait(10) == 143, "leaving: SIGTERM to an attached client ends it with 143 (got %s)" % d.code)
    check(a.wait(10) == 143, "leaving: the first client sees the run end with 143 (got %s)" % a.code)
    check(all(gone(p) for p in pids_a), "leaving: SIGTERM to a client stopped the agent and what it started")
    check(a.kinds()[-1] != "done" and "failed" not in a.kinds(), "leaving: a stopped run says neither done nor failed")
    mine = entry(env, id_a)
    check(mine and mine["state"] == "stopped" and mine["attachable"] is False, "leaving: --list says stopped, not attachable")

    # --stop, with nobody attached.
    for rid, pids, label in ((id_b, pids_b, "after SIGHUP"), (id_c, pids_c, "after SIGKILL")):
        out = subprocess.run([BINARY, "--stop", rid], env=env, capture_output=True, text=True, timeout=30)
        check(out.returncode == 0 and json.loads(out.stdout or "{}") == {"id": rid, "state": "stopped"},
              "--stop %s: ends the run and says so (%r %r)" % (label, out.stdout, out.stderr))
        check(all(gone(p) for p in pids), "--stop %s: the agent and what it started are gone" % label)
        mine = entry(env, rid)
        check(mine and mine["state"] == "stopped" and mine["attachable"] is False, "--stop %s: --list says stopped" % label)
        lines = [json.loads(l) for l in open(os.path.join(RUNS, next(n for n in os.listdir(RUNS) if n.endswith("-%s.jsonl" % rid))))]
        check(lines[-1].get("record") == "end" and lines[-1].get("state") == "stopped", "--stop %s: the record ends in stopped" % label)
    out = subprocess.run([BINARY, "--stop", id_b], env=env, capture_output=True, text=True, timeout=30)
    check(out.returncode == 0 and "already ended" in out.stderr, "--stop: a run that has ended is said to have ended (%r)" % out.stderr)
    out = subprocess.run([BINARY, "--stop", "nonesuch"], env=env, capture_output=True, text=True, timeout=30)
    check(out.returncode == 1 and "no run" in out.stderr, "--stop: an unknown run is refused (%r)" % out.stderr)

    # A client that waits for a run ends with it.
    env, log, e, pids_e, id_e = start_hang("-e", "Stopped under a client")
    out = subprocess.run([BINARY, "--stop", id_e], env=env, capture_output=True, text=True, timeout=30)
    check(out.returncode == 0 and e.wait(10) == 143, "--stop: a client of the run ends with 143 (got %s)" % e.code)
    check(all(gone(p) for p in pids_e), "--stop: with a client attached, the agent and what it started are gone")
    ends_with(e, "stopped")


def story_notices():
    notes = os.path.join(SCRATCH, "notices.jsonl")
    if os.path.exists(notes):
        os.remove(notes)
    on = {"LEVITATE_AGENT_NOTIFIER": NOTIFIER, "LEVITATE_STANDIN_NOTICES": notes}

    def seen():
        return [json.loads(l) for l in open(notes) if l.strip()] if os.path.exists(notes) else []

    # A client is attached the whole time: no notice, neither for the question nor for the end.
    env, log = environment("asks", on, tag="-notice1")
    Run(env, log, title="Watched").finish(on_question=lambda e: "Red")
    time.sleep(0.3)
    check(seen() == [], "notices: none while a client is attached (%s)" % seen())

    # The question comes while nobody watches: one notice.
    env, log = environment("asks", on, tag="-notice2")
    a = Run(env, log, title="Painting")
    a.read(until=is_question)
    run_id = a.run_id()
    a.close_input()
    a.wait(10)
    check(wait_for(lambda: len(seen()) == 1), "notices: one notice when the run asks and the last client has left (%s)" % seen())
    time.sleep(0.4)
    check(seen() == [{"title": "Painting", "body": "waits for an answer"}],
          "notices: the title of the run and what is true, once (%s)" % seen())
    # It ends with a client attached: no notice for that.
    b = attach(env, log, run_id)
    b.read(until=is_question)
    b.answer(b.of("question")[0], "Red")
    b.read()
    time.sleep(0.4)
    check(len(seen()) == 1, "notices: none for the end of a run a client is attached to (%s)" % seen())

    # It ends while nobody watches.
    env, log = environment("slow", on, tag="-notice3")
    c = Run(env, log, title="Slow one")
    c.read(until=lambda e: e.get("event") == "output")
    c.proc.send_signal(signal.SIGHUP)
    c.wait(10)
    check(wait_for(lambda: len(seen()) == 2), "notices: one notice when a run ends and nobody watches (%s)" % seen())
    check(seen()[1:] == [{"title": "Slow one", "body": "is done: Done, slowly."}], "notices: is done, and what it said (%s)" % seen())

    # Stopped while nobody watches.
    env, log = environment("hang", on, tag="-notice5")
    f = Run(env, log, title="Stuck for real")
    f.read(until=lambda e: e.get("event") == "output" and e.get("line") == "$ sleep 300")
    rid = f.run_id()
    f.proc.send_signal(signal.SIGHUP)
    f.wait(10)
    out = subprocess.run([BINARY, "--stop", rid], env=env, capture_output=True, text=True, timeout=30)
    check(wait_for(lambda: len(seen()) == 3), "notices: one notice when a run is stopped and nobody watches (%s)" % seen())
    check(seen()[2:] == [{"title": "Stuck for real", "body": "stopped: it was asked to stop"}], "notices: stopped, and why (%s)" % seen())

    # Turned off: nothing, whatever happens.
    env, log = environment("slow", on, config={"notices": False}, tag="-notice6")
    g = Run(env, log, title="Quiet")
    g.read(until=lambda e: e.get("event") == "output")
    rid = g.run_id()
    g.proc.send_signal(signal.SIGHUP)
    g.wait(10)
    check(wait_for(lambda: (entry(env, rid) or {}).get("state") == "done"), "notices: the quiet run ends")
    time.sleep(0.4)
    check(len(seen()) == 3, "notices: \"notices\": false shows none (%s)" % seen())

    # Failed with nobody watching, through a failing notifier: the run does not mind.
    env, log = environment("slow", dict(on, LEVITATE_AGENT_NOTIFIER=os.path.join(SCRATCH, "no-notifier")), tag="-notice7")
    h = Run(env, log, title="Unshown")
    h.read(until=lambda e: e.get("event") == "output")
    rid = h.run_id()
    h.proc.send_signal(signal.SIGHUP)
    h.wait(10)
    check(wait_for(lambda: (entry(env, rid) or {}).get("state") == "done"), "notices: a notice that cannot be shown does not stop the run ending")


def story_may_write():
    work = os.path.join(HOME, "work")
    recipes, other = os.path.join(work, "recipes"), os.path.join(work, "other")
    os.makedirs(recipes, exist_ok=True)
    os.makedirs(other, exist_ok=True)
    real = os.path.realpath
    made = os.path.join(recipes, "made-by-standin.txt")
    for path in (made, os.path.join(HOME, "made-by-standin.txt")):
        if os.path.exists(path):
            os.remove(path)

    env, log = environment("writes", tag="-w1")
    run = Run(env, log, extra={"may_write": [recipes, other]}).finish()
    calls = run.calls()
    check(run.code == 0 and len(calls) == 1, "may_write: the run is accepted and ends (%s)" % run.code)
    if calls:
        args = calls[0]["args"]
        check(args[args.index("-s") + 1] == "workspace-write", "may_write: workspace-write instead of read-only")
        check(args[args.index("-C") + 1] == real(recipes) and calls[0]["cwd"] == real(recipes),
              "may_write: the first folder is the working root")
        check([args[i + 1] for i, a in enumerate(args) if a == "--add-dir"] == [real(other)], "may_write: the others are --add-dir")
    check(os.path.exists(made), "may_write: the agent could write in the first folder")
    check([d["what"] for d in run.of("did") if d["kind"] == "write"] == [made], "may_write: the write is reported")
    record = ends_with(run, "done")
    check(record and record[0].get("may_write") == [recipes, other], "may_write: the first line of the record has it (%s)" % (record[0] if record else None))

    env, log = environment("writes", tag="-w2")
    run = Run(env, log).finish()
    calls = run.calls()
    check(calls and calls[0]["args"][calls[0]["args"].index("-s") + 1] == "read-only" and calls[0]["cwd"] == HOME
          and "--add-dir" not in calls[0]["args"], "may_write: without it, read-only in the home folder")
    check(not os.path.exists(os.path.join(HOME, "made-by-standin.txt")) and run.of("agent")[0]["summary"] == "I could not write the file.",
          "may_write: without it nothing is written")
    check(ends_with(run, "done")[0].get("may_write") is None, "may_write: a request without it records none")

    env, log = environment("writes", config={"run_commands": "allowed"}, tag="-w3")
    run = Run(env, log, extra={"may_write": [recipes]}).finish()
    calls = run.calls()
    check(calls and calls[0]["args"][calls[0]["args"].index("-C") + 1] == HOME and "--add-dir" not in calls[0]["args"]
          and os.path.exists(os.path.join(HOME, "made-by-standin.txt")),
          "may_write: run_commands allowed keeps meaning the home folder")
    os.remove(os.path.join(HOME, "made-by-standin.txt"))

    env, log = environment("asks", tag="-w4")
    run = Run(env, log, extra={"may_write": [recipes, other]}).finish(on_question=lambda e: "Red")
    calls = run.calls()
    if len(calls) == 2:
        args = calls[1]["args"]
        check('sandbox_mode="workspace-write"' in args and "sandbox_workspace_write.writable_roots=%s" % json.dumps([real(other)]) in args
              and "--add-dir" not in args, "may_write: a resumed turn gets the sandbox and the other folders as configuration (%s)" % args)
    else:
        check(False, "may_write: the asking run was resumed")

    link = os.path.join(HOME, "escape")
    if not os.path.islink(link):
        os.symlink("/etc", link)
    refused = [("outside the home folder", ["/etc"], "outside your home folder"),
               ("a relative path", ["recipes"], "not a full path"),
               ("a folder that is not there", [os.path.join(HOME, "no-such-folder")], "does not exist"),
               ("a link that leads out", [link], "outside your home folder"),
               ("one good folder and one bad", [recipes, "/etc"], "outside your home folder"),
               ("not a list", "/etc", "list of folders")]
    for name, value, words in refused:
        env, log = environment("writes", tag="-w5")
        run = Run(env, log, extra={"may_write": value}).finish()
        failed = run.of("failed")
        check(run.code == 1 and len(failed) == 1 and words in failed[0]["reason"] and run.kinds()[-1] == "failed",
              "may_write: %s is refused at once, with a reason (%s)" % (name, failed))
        check(run.calls() == [], "may_write: %s: the agent was not started" % name)
        record = ends_with(run, "failed")
        check(record and record[0].get("may_write") == value, "may_write: %s: the request is in the record" % name)


