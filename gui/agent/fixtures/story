def story_disk_standin():
    """What the Recdirstat window hands over, decided by the stand-in the Disk story uses."""
    name = "disk"
    base = os.path.join(HOME, "diskstory")
    shutil.rmtree(base, ignore_errors=True)
    paths = {k: made(os.path.join(base, v), 10) for k, v in {"cache": ".cache/x/f.bin", "stuck": "proj/build/f.bin", "iso": "Downloads/a.iso", "rpm": "Downloads/b.rpm"}.items()}
    cache, stuck = os.path.dirname(paths["cache"]), os.path.dirname(paths["stuck"])
    holding = os.path.join(base, "held")
    facts = ["%s (30.0 MiB): Kept by a program." % cache, "%s (30.0 MiB): Made again." % stuck,
             "%s (3.0 GiB): Not opened. Ask me first." % paths["iso"], "%s (64.0 MiB): Old. Ask me first." % paths["rpm"]]
    prompt = "The issue:\nx\n\nThe facts:\n- %s\n\nThe expected result:\ny\n" % "\n- ".join(facts)
    env, log = environment("disk", extra={"DISK_STANDIN_COULD_NOT": "/proj/build"})
    answers = iter(["Remove it", "Keep it"])
    request = {"holding": holding, "places": [cache, stuck, paths["iso"], paths["rpm"]], "ask_first": [paths["iso"], paths["rpm"]]}
    run = Run(env, log, prompt=prompt, app="disk", extra={"set_aside": request}).finish(on_question=lambda q: next(answers))
