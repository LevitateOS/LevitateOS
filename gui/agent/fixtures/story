#!/usr/bin/env python3
"""Drives the built levitate-agent through every story of the stand-in codex
and checks the events it sends and the record it keeps.

    gui/agent/fixtures/story [PATH-TO-levitate-agent]

It points HOME and the XDG folders into .artifacts/agent/story (or into the
folder named by LEVITATE_STORY_SCRATCH), sets LEVITATE_AGENT_CODEX and
LEVITATE_AGENT_CLAUDE to the stand-ins in fixtures and the root helper to
nothing (so an approved administrator command runs as the person, which is all
a check may do). No notice is shown on a desktop: the notifier is a stand-in
that writes down what it was asked to show. It prints a line for each
expectation that does not hold, and ends with `all flows ended where they
should` or the opposite; the exit code agrees. When it ends, it checks that no
process of its own is left running.
"""
import json
import os
import select
import shutil
import signal
import subprocess
import sys
import threading
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, "..", "..", ".."))
BINARY = sys.argv[1] if len(sys.argv) > 1 else os.path.join(ROOT, ".artifacts/agent/build/levitate-agent")
STANDIN = os.path.join(HERE, "codex")
CLAUDE_STANDIN = os.path.join(HERE, "claude")
NOTIFIER = os.path.join(HERE, "notifier")
DISK_AGENT = os.path.join(ROOT, "gui/disk/fixtures/agent")
SCRATCH = os.environ.get("LEVITATE_STORY_SCRATCH") or os.path.join(ROOT, ".artifacts/agent/story")
HOME = os.path.join(SCRATCH, "home")
STATE = os.path.join(HOME, "state")
RUNS = os.path.join(STATE, "levitate/agent/runs")

failures = []


def check(condition, words):
    if not condition:
        failures.append(words)
        print("story: " + words)


def environment(name, extra=None, config=None, story=None, tag=""):
    """The environment of one check. `name` is also the story of the stand-in
    unless `story` says another; `tag` keeps the log of two runs of one story apart."""
    env = dict(os.environ)
    for key in [k for k in env if k.startswith(("LEVITATE_", "XDG_"))]:
        del env[key]
    cfg = os.path.join(SCRATCH, "config-" + name)
    shutil.rmtree(cfg, ignore_errors=True)
    if config is not None:
        os.makedirs(os.path.join(cfg, "levitate"))
        json.dump(config, open(os.path.join(cfg, "levitate/agent.json"), "w"))
    log = os.path.join(SCRATCH, name + tag + ".log")
    for suffix in ("", ".turns", ".pids", ".places"):
        if os.path.exists(log + suffix):
            os.remove(log + suffix)
    env.update(HOME=HOME, XDG_STATE_HOME=STATE, XDG_CONFIG_HOME=cfg, XDG_RUNTIME_DIR=os.path.join(SCRATCH, "run"),
               LEVITATE_AGENT_CODEX=STANDIN, LEVITATE_AGENT_CLAUDE=CLAUDE_STANDIN, LEVITATE_AGENT_NOTIFIER="",
               LEVITATE_AGENT_ROOT_HELPER="", LEVITATE_STANDIN_LOG=log, LEVITATE_STANDIN_STORY=story or name)
    env.update(extra or {})
    return env, log


class Run:
    """A client of levitate-agent: the usual one, which sends a request, or
    (with `argv`) one that attaches to a run that is going."""

    def __init__(self, env, log, prompt="Please do the thing", app="recab", title="A change", before=None, extra=None,
                 argv=None):
        self.env, self.log = env, log
        self.events, self.lines = [], []
        self.announced = None  # the id the client names first, in {"event": "run"}
        self.code = None
        self.known = set(os.listdir(RUNS)) if os.path.isdir(RUNS) else set()
        self.proc = subprocess.Popen(argv or [BINARY], stdin=subprocess.PIPE, stderr=subprocess.PIPE,
                                     stdout=subprocess.PIPE, env=env, text=True)
        if argv:
            return
        request = {"prompt": prompt}
        if app:
            request["app"] = app
        if title:
            request["title"] = title
        request.update(extra or {})
        self.send(request)

    def send(self, obj):
        try:
            self.proc.stdin.write(json.dumps(obj) + "\n")
            self.proc.stdin.flush()
        except (BrokenPipeError, ValueError):
            pass  # the client has gone; what follows is what the check looks at

    def answer(self, question, text):
        self.send({"question": question["id"], "answer": text})

    def close_input(self):
        self.proc.stdin.close()

    def wait(self, seconds=15):
        """The exit code, or None when it did not end in time (then it is killed)."""
        try:
            self.code = self.proc.wait(timeout=seconds)
        except subprocess.TimeoutExpired:
            self.proc.kill()
            self.proc.wait()
            self.code = None
        return self.code

    def run_id(self):
        record = self.record()
        return record[0]["id"] if record else None

    def read(self, until=None, on_question=None, seconds=30):
        """Reads events until the process ends, or `until(event)` holds."""
        watchdog = threading.Timer(seconds, self.proc.kill)
        watchdog.start()
        try:
            while True:
                line = self.proc.stderr.readline()
                if not line:
                    break
                line = line.rstrip("\n")
                self.lines.append(line)
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if event.get("event") == "run":
                    self.announced = event.get("id")
                    continue
                self.events.append(event)
                if event.get("event") == "question" and on_question:
                    self.answer(event, on_question(event))
                if until and until(event):
                    return
            self.code = self.proc.wait()
        finally:
            watchdog.cancel()

    def finish(self, **kwargs):
        self.read(**kwargs)
        return self

    def kinds(self):
        return [e.get("event") for e in self.events]

    def of(self, kind):
        return [e for e in self.events if e.get("event") == kind]

    def record(self):
        new = sorted(set(os.listdir(RUNS)) - self.known)
        if len(new) != 1:
            return []
        return [json.loads(line) for line in open(os.path.join(RUNS, new[0])) if line.strip()]

    def calls(self):
        if not os.path.exists(self.log):
            return []
        return [json.loads(line) for line in open(self.log) if line.strip()]


def ends_with(run, state):
    record = run.record()
    check(bool(record) and record[0].get("record") == "request", "the record starts with the request")
    check(bool(record) and record[-1].get("record") == "end" and record[-1].get("state") == state,
          "the record ends in %s (got %s)" % (state, record[-1] if record else None))
    check(all("t" in line for line in record), "every line of the record has a time")
    return record


def story_plain():
    env, log = environment("plain")
    run = Run(env, log, prompt="Install the thing", app="recipe", title="Install it").finish()
    check(run.code == 0, "plain: exits 0 (got %s)" % run.code)
    check(run.announced and run.announced == run.run_id(), "plain: the client names the run's id before anything else (%s)" % run.announced)
    check(run.lines and json.loads(run.lines[0]).get("event") == "run", "plain: the id is the first line the window gets")
    check(run.kinds()[-1] == "done" and "failed" not in run.kinds(), "plain: ends with done")
    plan = run.of("plan")
    check(len(plan) == 1 and plan[0]["steps"][0] == ["1", "Look around"] and len(plan[0]["steps"]) == 3,
          "plain: one plan of three steps with id and title")
    steps = [(e["step"], e["status"]) for e in run.of("step")]
    check(steps[:2] == [("1", "running"), ("1", "done")] and ("2", "running") in steps and ("3", "done") in steps,
          "plain: steps run and finish in order (%s)" % steps)
    lines = [e["line"] for e in run.of("output")]
    check("$ ls -l" in lines and "$ seq 1 100" in lines, "plain: commands are shown as $ lines")
    check(len(lines) < 50 and any("more lines" in l for l in lines), "plain: long output is capped")
    dids = run.of("did")
    check([d["kind"] for d in dids] == ["command", "command", "write", "write", "search"],
          "plain: one did for each thing done (%s)" % [d["kind"] for d in dids])
    check(dids and dids[0]["exit_code"] == 0 and dids[0]["as_administrator"] is False and dids[0]["asked"] is False
          and dids[0]["approved"] is None and dids[0]["what"] == "ls -l",
          "plain: a command run in the sandbox was not asked about, so approved is null")
    check(all(d["asked"] is False and d["approved"] is None for d in dids), "plain: no did was asked about")
    check(dids[2]["what"] == "/home/x/a.txt" and dids[3]["what"] == "/home/x/b.txt", "plain: a did for each path")
    check([e["text"] for e in run.of("say")] == ["Working on it.", "I made the change. Everything checks out."],
          "plain: each message is said")
    check(run.of("agent") and run.of("agent")[0]["summary"] == "I made the change. Everything checks out.",
          "plain: the last message is the summary")
    calls = run.calls()
    check(len(calls) == 1, "plain: codex ran once")
    if calls:
        args = calls[0]["args"]
        check(args[0] == "exec" and "--json" in args and "--skip-git-repo-check" in args and args[-1] == "-",
              "plain: exec with --json, --skip-git-repo-check and the prompt on stdin")
        check(args[args.index("-s") + 1] == "read-only", "plain: read-only unless commands are allowed")
        check(args[args.index("-C") + 1] == HOME and calls[0]["cwd"] == HOME, "plain: started in the home folder")
        check("Install the thing" in calls[0]["prompt"] and "RUN-AS-ADMINISTRATOR" in calls[0]["prompt"]
              and "never use sudo" in calls[0]["prompt"].lower().replace("never use sudo, su", "never use sudo")
              and "recipe" in calls[0]["prompt"], "plain: the prompt holds the preamble and the request")
    record = ends_with(run, "done")
    if record:
        check(record[0].get("app") == "recipe" and record[0].get("title") == "Install it"
              and record[0].get("prompt") == "Install the thing" and record[0].get("agent") == "codex"
              and "t" in record[0], "plain: the request line holds app, title, prompt, agent and time")
        check("done" in [l.get("event") for l in record], "plain: events are in the record")
    return run


def story_allowed():
    # run_commands=allowed widens codex's own sandbox; a RUN request is still asked.
    env, log = environment("run", config={"run_commands": "allowed"})
    run = Run(env, log).finish(on_question=lambda e: "Approve")
    calls = run.calls()
    check(run.code == 0 and calls and calls[0]["args"][calls[0]["args"].index("-s") + 1] == "workspace-write",
          "allowed: run_commands=allowed gives workspace-write")
    q = run.of("question")
    check(len(q) == 1 and q[0].get("kind") == "command", "allowed: a RUN request is still asked")


def story_asks():
    env, log = environment("asks")
    run = Run(env, log, prompt="Paint it", title="Painting")
    seen = {}

    def waiting(event):
        # The run is idle on a question: --list must say so.
        listing = json.loads(subprocess.check_output([BINARY, "--list"], env=env))
        mine = [r for r in listing["runs"] if r["title"] == "Painting"]
        seen["state"] = mine[0]["state"] if mine else None
        return "Blue"

    run.finish(on_question=waiting)
    questions = run.of("question")
    check(len(questions) == 1 and questions[0]["text"] == "Which colour?" and questions[0]["choices"] == ["Red", "Blue"]
          and "id" in questions[0], "asks: a question with text, choices and id")
    check(seen.get("state") == "waiting", "asks: --list shows the run as waiting (%s)" % seen.get("state"))
    calls = run.calls()
    check(len(calls) == 2 and calls[1]["args"][:3] == ["exec", "resume", "standin-thread-1"],
          "asks: the answer resumes the session")
    check(len(calls) == 2 and calls[1]["prompt"] == "Blue", "asks: the answer is the prompt of the resume")
    if len(calls) == 2:
        args = calls[1]["args"]
        check("--json" in args and args[-1] == "-" and "-s" not in args and "-C" not in args,
              "asks: resume uses only options resume accepts")
    check(run.code == 0 and run.kinds()[-1] == "done" and "Blue" in run.of("agent")[0]["summary"],
          "asks: finishes after the answer")
    check([e.get("text") for e in run.of("say") if "ASK:" in e.get("text", "")] == [], "asks: the ASK line is not said")
    record = ends_with(run, "done")
    check([l.get("event") for l in record if l.get("event") in ("question", "answer")] == ["question", "answer"],
          "asks: the record has the question and the answer")


def story_administrator(approve):
    env, log = environment("administrator")
    run = Run(env, log)
    run.finish(on_question=lambda e: "Approve" if approve else "Refuse")
    name = "administrator(%s)" % ("approved" if approve else "refused")
    questions = run.of("question")
    check(len(questions) == 1, name + ": one question")
    if questions:
        q = questions[0]
        check(q.get("kind") == "administrator" and q.get("command") == "id -u" and q["choices"] == ["Approve", "Refuse"],
              name + ": kind, command and choices")
        check("id -u" in q["text"] and "which user the command ran as" in q["text"],
              name + ": the text holds the command and the reason")
    dids = run.of("did")
    calls = run.calls()
    check(run.code == 0 and run.kinds()[-1] == "done", name + ": ends with done")
    check(len(dids) == 1 and dids[0]["as_administrator"] is True and dids[0]["asked"] is True
          and dids[0]["approved"] is approve and dids[0]["what"] == "id -u",
          name + ": one did, as administrator, asked, approved=%s" % approve)
    if approve:
        uid = str(os.getuid())
        check(dids and dids[0]["exit_code"] == 0 and uid in [e["line"] for e in run.of("output")],
              name + ": the command ran and its output was sent")
        check(len(calls) == 2 and "Exit code: 0" in calls[1]["prompt"] and uid in calls[1]["prompt"],
              name + ": the agent is told the exit code and the output")
    else:
        check(dids and dids[0]["exit_code"] is None, name + ": no exit code when refused")
        check("$ id -u" not in [e["line"] for e in run.of("output")], name + ": nothing ran")
        check(len(calls) == 2 and "refused" in calls[1]["prompt"], name + ": the agent is told the person refused")
    ends_with(run, "done")


