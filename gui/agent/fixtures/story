def story_fails(name, words, state="failed"):
    env, log = environment(name)
    run = Run(env, log).finish()
    check(run.code != 0 and run.code is not None, name + ": exits non-zero")
    failed = run.of("failed")
    check(len(failed) == 1 and words in failed[0].get("reason", ""),
          "%s: failed with the reason (%s)" % (name, failed))
    check(run.kinds()[-1] == "failed" and "done" not in run.kinds(), name + ": failed is the last event")
    record = ends_with(run, state)
    return failed[0].get("reason", "") if failed else ""


def story_stop():
    env, log = environment("hang")
    run = Run(env, log)
    run.read(until=lambda e: e.get("event") == "output" and e.get("line") == "$ sleep 300")
    for _ in range(50):
        if os.path.exists(log + ".pids"):
            break
        time.sleep(0.1)
    pids = [int(p) for p in open(log + ".pids").read().split()] if os.path.exists(log + ".pids") else []
    check(len(pids) == 2, "stop: the stand-in and its own child are running")
    run.proc.send_signal(signal.SIGTERM)
    try:
        run.proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        run.proc.kill()
        check(False, "stop: levitate-agent exits on SIGTERM")
    run.proc.stderr.read()

    def gone(pid):
        for _ in range(30):
            try:
                if open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()[0] == "Z":
                    return True
            except OSError:
                return True
            time.sleep(0.1)
        return False

    check(all(gone(p) for p in pids), "stop: the agent and what it started are gone")
    ends_with(run, "stopped")
    return run


def story_passthrough():
    # An agent that already speaks the protocol: the disk app's own stand-in.
    env, log = environment("passthrough", {"LEVITATE_AGENT": DISK_AGENT, "DISK_STANDIN_SPEED": "0"})
    run = Run(env, log, prompt="What differs between this system and the other system?", app="disk", title="Compare").finish()
    check(run.code == 0 and run.kinds()[-1] == "done", "passthrough: its events arrive and end with done")
    check(run.of("plan") and run.of("agent") and "sshd_config" in run.of("agent")[0]["summary"],
          "passthrough: its events arrive unchanged")
    record = ends_with(run, "done")
    check(record and record[0]["agent"] == DISK_AGENT, "passthrough: the record names the agent")

    # Questions and answers pass both ways.
    mini = os.path.join(SCRATCH, "mini-agent")
    open(mini, "w").write(
        "#!/usr/bin/env python3\nimport json, sys\n"
        "json.loads(sys.stdin.readline())\n"
        "sys.stderr.write(json.dumps({'event': 'question', 'id': '7', 'text': 'Well?', 'choices': ['A', 'B']}) + '\\n')\n"
        "sys.stderr.flush()\n"
        "answer = json.loads(sys.stdin.readline())\n"
        "sys.stderr.write('a plain line\\n')\n"
        "sys.stderr.write(json.dumps({'event': 'agent', 'summary': 'got ' + answer['answer'] + ' for ' + answer['question']}) + '\\n')\n"
        "sys.stderr.write(json.dumps({'event': 'done'}) + '\\n')\n")
    os.chmod(mini, 0o755)
    env, log = environment("passthrough", {"LEVITATE_AGENT": mini})
    run = Run(env, log).finish(on_question=lambda e: "B")
    check(run.of("agent") and run.of("agent")[0]["summary"] == "got B for 7", "passthrough: answers reach the agent")
    check("a plain line" in run.lines, "passthrough: a plain line passes through as it is")
    record = ends_with(run, "done")
    check(any(l.get("event") == "output" and l.get("line") == "a plain line" for l in record),
          "passthrough: a plain line is recorded as output")

    env, log = environment("passthrough", {"LEVITATE_AGENT": os.path.join(SCRATCH, "no-such-agent")})
    run = Run(env, log).finish()
    check(run.code != 0 and run.of("failed"), "passthrough: an agent that cannot be started fails")
    ends_with(run, "failed")


def story_config():
    # The program named in agent.json is used when the environment names none.
    mini = os.path.join(SCRATCH, "mini-agent")
    env, log = environment("passthrough", config={"agent": mini})
    run = Run(env, log).finish(on_question=lambda e: "A")
    check(run.of("agent") and run.of("agent")[0]["summary"] == "got A for 7", "config: agent.json names the agent")


def listing(expected_ids):
    out = json.loads(subprocess.check_output([BINARY, "--list"], env=environment("list")[0]))
    runs = out["runs"]
    check(len(runs) >= 12, "list: every run is listed (%d)" % len(runs))
    check([r["started"] for r in runs] == sorted((r["started"] for r in runs), reverse=True), "list: newest first")
    keys = {"id", "app", "title", "state", "started", "ended", "summary"}
    check(all(set(r) == keys for r in runs), "list: each run has id, app, title, state, started, ended, summary")
    states = {r["state"] for r in runs}
    check(states <= {"running", "waiting", "done", "failed", "stopped"} and {"done", "failed", "stopped"} <= states,
          "list: states are the known ones and done, failed and stopped all occur (%s)" % sorted(states))
    check(all(r["state"] != "running" and r["state"] != "waiting" for r in runs), "list: no run is left running")
    first = [r for r in runs if r["app"] == "recipe" and r["title"] == "Install it"]
    check(len(first) == 1 and first[0]["state"] == "done" and first[0]["summary"].startswith("I made the change")
          and first[0]["ended"], "list: a finished run has its summary and end")
    failed = [r for r in runs if r["state"] == "failed"]
    check(failed and all(r["summary"] for r in failed), "list: a failed run's summary is its reason")

    env = environment("show")[0]
    run_id = first[0]["id"] if first else "00000000"
    shown = json.loads(subprocess.check_output([BINARY, "--show", run_id], env=env))
    check(isinstance(shown, list) and shown[0].get("record") == "request" and shown[-1].get("record") == "end"
          and shown[-1].get("state") == "done", "show: the lines of the run, request first and end last")
    missing = subprocess.run([BINARY, "--show", "../../etc"], env=env, capture_output=True)
    check(missing.returncode != 0, "show: an unknown id is refused")


def status():
    env, _ = environment("status", {"LEVITATE_STANDIN_SIGNED_OUT": ""})
    out = json.loads(subprocess.check_output([BINARY, "--status"], env=env))
    codex = [a for a in out.get("agents", []) if a["id"] == "codex"]
    check(out.get("chosen") == "codex" and len(codex) == 1, "status: chosen codex, listed once")
    check(codex and codex[0] == {"id": "codex", "name": "Codex", "installed": True, "version": "0.0.0-standin",
                                 "signed_in": True}, "status: installed, version and signed in (%s)" % codex)
    env, _ = environment("status", {"LEVITATE_STANDIN_SIGNED_OUT": "1"})
    out = json.loads(subprocess.check_output([BINARY, "--status"], env=env))
    check(out["agents"][0]["signed_in"] is False, "status: signed out when login status fails")
    env, _ = environment("status", {"LEVITATE_AGENT_CODEX": os.path.join(SCRATCH, "none")})
    out = json.loads(subprocess.check_output([BINARY, "--status"], env=env))
    check(out["agents"][0]["installed"] is False and out["agents"][0]["signed_in"] is None,
          "status: not installed, signed_in unknown")
    env, _ = environment("status", {"LEVITATE_AGENT": DISK_AGENT})
    out = json.loads(subprocess.check_output([BINARY, "--status"], env=env))
    check(out["chosen"] == DISK_AGENT and any(a["id"] == DISK_AGENT and a["installed"] for a in out["agents"]),
          "status: a chosen program is named and found")


def main():
    if not os.access(BINARY, os.X_OK):
        print("story: %s is not built" % BINARY)
        return 1
    shutil.rmtree(SCRATCH, ignore_errors=True)
    os.makedirs(HOME)
    story_plain()
    story_allowed()
    story_asks()
    story_administrator(True)
    story_administrator(False)
    story_run()
    story_shell()
    story_fails("fails", "The model is overloaded")
    reason = story_fails("signed-out", "sign")
    check("codex login" in reason, "signed-out: the reason says to sign in")
    story_fails("dies", "Connection lost")
    story_stop()
    story_passthrough()
    story_config()
    listing(None)
    status()
    print("all flows ended where they should" if not failures else "some flows did not end where they should (%d)" % len(failures))
    return 0 if not failures else 1


if __name__ == "__main__":
    sys.exit(main())
