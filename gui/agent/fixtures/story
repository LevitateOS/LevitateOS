    calls = run.calls()
    check(run.code == 0 and run.kinds()[-1] == "done", name + ": ends with done")
    check(len(dids) == 1 and dids[0]["as_administrator"] is True and dids[0]["asked"] is True and dids[0]["approved"] is approve,
          name + ": one did, as administrator, asked, approved=%s" % approve)
    if approve:
        check(dids and dids[0]["exit_code"] == 0 and str(os.getuid()) in [e["line"] for e in run.of("output")],
              name + ": the command ran and its output was sent")
        check(len(calls) == 2 and "Exit code: 0" in calls[1]["prompt"], name + ": the agent is told the exit code")
    else:
        check("$ id -u" not in [e["line"] for e in run.of("output")] and len(calls) == 2 and "refused" in calls[1]["prompt"],
              name + ": nothing ran, and the agent is told the person refused")
    ends_with(run, "done")


def story_claude_fails():
    env, log = claude_env("fails")
    run = Run(env, log).finish()
    failed = run.of("failed")
    check(run.code == 1 and len(failed) == 1 and "The model is overloaded" in failed[0]["reason"] and run.kinds()[-1] == "failed",
          "claude fails: failed with the reason of the result's errors (%s)" % failed)
    ends_with(run, "failed")

    env, log = claude_env("dies")
    run = Run(env, log).finish()
    failed = run.of("failed")
    check(run.code == 1 and len(failed) == 1 and "stream closed" in failed[0]["reason"],
          "claude dies: a child that ends without a result fails with what it said (%s)" % failed)
    ends_with(run, "failed")

    env, log = claude_env("signed-out")
    run = Run(env, log).finish()
    failed = run.of("failed")
    check(run.code == 1 and len(failed) == 1 and "Claude Code is not signed in" in failed[0]["reason"] and "`claude`" in failed[0]["reason"],
          "claude signed-out: the reason says to sign in (%s)" % failed)
    ends_with(run, "failed")


def story_claude_denied():
    env, log = claude_env("denied")
    run = Run(env, log).finish()
    check(run.code == 0 and "not allowed: touch /usr/nope" in [e["line"] for e in run.of("output")] and run.of("did") == [],
          "claude denied: a refused call is said, and not reported as something done (%s)" % [e["line"] for e in run.of("output")])
    check("$ touch /usr/nope" in [e["line"] for e in run.of("output")], "claude denied: the command that was tried is shown")


def story_claude_may_write():
    work = os.path.join(HOME, "work")
    recipes, other = os.path.join(work, "recipes"), os.path.join(work, "other")
    real = os.path.realpath
    made = os.path.join(recipes, "made-by-standin.txt")
    if os.path.exists(made):
        os.remove(made)
    env, log = claude_env("writes", tag="-w1")
    run = Run(env, log, extra={"may_write": [recipes, other]}).finish()
    calls = run.calls()
    check(run.code == 0 and len(calls) == 1, "claude may_write: accepted and ends")
    if calls:
        args = calls[0]["args"]
        check(flag(args, "--permission-mode") == "acceptEdits" and "--disallowedTools" not in args and calls[0]["cwd"] == real(recipes)
              and [args[i + 1] for i, a in enumerate(args) if a == "--add-dir"] == [real(other)],
              "claude may_write: acceptEdits in the first folder, the others --add-dir (%s)" % args)
    check(os.path.exists(made) and [d["what"] for d in run.of("did") if d["kind"] == "write"] == [made], "claude may_write: the write is made and reported")
    check(ends_with(run, "done")[0].get("may_write") == [recipes, other], "claude may_write: recorded")

    env, log = claude_env("writes", tag="-w2")
    run = Run(env, log).finish()
    calls = run.calls()
    check(calls and flag(calls[0]["args"], "--permission-mode") == "dontAsk" and run.of("agent")[0]["summary"] == "I could not write the file.",
          "claude may_write: without it nothing may be written")

    env, log = claude_env("writes", config={"run_commands": "allowed"}, tag="-w3")
    run = Run(env, log, extra={"may_write": [recipes]}).finish()
    calls = run.calls()
    check(calls and flag(calls[0]["args"], "--permission-mode") == "acceptEdits" and calls[0]["cwd"] == HOME and "--add-dir" not in calls[0]["args"],
          "claude may_write: run_commands allowed means the home folder")
    if os.path.exists(os.path.join(HOME, "made-by-standin.txt")):
        os.remove(os.path.join(HOME, "made-by-standin.txt"))

    env, log = claude_env("writes", tag="-w4")
    run = Run(env, log, extra={"may_write": ["/etc"]}).finish()
    check(run.code == 1 and run.of("failed") and "outside your home folder" in run.of("failed")[0]["reason"] and run.calls() == [],
          "claude may_write: a folder outside the home folder is refused before claude starts")
    ends_with(run, "failed")


def story_claude_stop():
    env, log = claude_env("hang")
    run = Run(env, log)
    run.read(until=lambda e: e.get("event") == "output" and e.get("line") == "$ sleep 300")
    wait_for(lambda: os.path.exists(log + ".pids"))
    pids = [int(p) for p in open(log + ".pids").read().split()]
    run.proc.send_signal(signal.SIGTERM)
    check(run.wait(10) == 143, "claude stop: SIGTERM ends the client with 143")
    check(all(gone(p) for p in pids), "claude stop: the agent and what it started are gone")
    ends_with(run, "stopped")


def nothing_left():
    """No process of this check is left running: not a host, a client, a
    stand-in, nor what a stand-in started."""
    time.sleep(0.5)
    marks = [BINARY, STANDIN, CLAUDE_STANDIN, DISK_AGENT, os.path.join(SCRATCH, "mini-agent"), os.path.join(SCRATCH, "mini-out-agent")]
    left = []
    for name in os.listdir("/proc"):
        if not name.isdigit() or int(name) == os.getpid():
            continue
        try:
            words = open("/proc/%s/cmdline" % name, "rb").read().replace(b"\0", b" ").decode(errors="replace")
        except OSError:
            continue
        # Other checks may be running the same programs elsewhere at the same
        # time: only what runs in this check's own home folder is ours.
        try:
            environ = open("/proc/%s/environ" % name, "rb").read().split(b"\0")
        except OSError:
            continue
        if ("HOME=" + HOME).encode() not in environ:
            continue
        if any(mark in words for mark in marks) and alive(int(name)):
            left.append((name, words.strip()))
    for path in os.listdir(SCRATCH):
        if path.endswith(".pids"):
            for pid in open(os.path.join(SCRATCH, path)).read().split():
                if alive(int(pid)):
                    left.append((pid, path))
    check(not left, "no process of the check is left running (%s)" % left)
    sockets = os.listdir(os.path.join(SCRATCH, "run/levitate-agent")) if os.path.isdir(os.path.join(SCRATCH, "run/levitate-agent")) else []
    check(not sockets, "no socket of a run is left (%s)" % sockets)


