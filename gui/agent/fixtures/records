#!/usr/bin/env python3
"""Fills a state folder with a few runs of levitate-agent, so that the Activity
page of an app has something to show in a picture or a story.

    gui/agent/fixtures/records STATE-FOLDER [PATH-TO-levitate-agent]
    gui/agent/fixtures/records --stop STATE-FOLDER

It drives the built levitate-agent with the stand-in codex (fixtures/codex),
never a real agent, and the root helper set to nothing. Five runs, from two
apps:

  Recipe  still running, not waiting (story "hang": a command it started)
  Recipe  done, with commands, file changes and a search (story "plain")
  System  waiting on a question, still alive (story "asks")
  Recipe  failed (story "fails")
  System  an administrator step the person refused (story "administrator")

A record with no last line is only "waiting" or "running" while the process
the run lives in does. A run lives in a process of its own, which goes on
without the window that started it, so those two runs are left running by
simply letting go of the helpers that started them (they are killed; the runs
do not mind). `--stop` ends the two runs with `levitate-agent --stop` (their
records then say stopped). Run `--stop` when the check is over.

Prints one line: the folder to give the app as XDG_STATE_HOME, and the pid of
the helper that started the waiting run (the running one is the oldest run), as
`state=FOLDER/state waiting_pid=N`. That is the number the record names as
`pid`, which is what an app matches against its own helper; the helper itself is
gone by then. Exits non-zero, with the reason on standard error, when a run did
not end where it should.
"""
import json
import os
import shutil
import signal
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.abspath(os.path.join(HERE, "..", "..", ".."))
STANDIN = os.path.join(HERE, "codex")


def environment(folder, story):
    env = dict(os.environ)
    for key in [k for k in env if k.startswith(("LEVITATE_", "XDG_"))]:
        del env[key]
    log = os.path.join(folder, "standin-%s.log" % story)
    for suffix in ("", ".turns"):
        if os.path.exists(log + suffix):
            os.remove(log + suffix)
    env.update(HOME=os.path.join(folder, "home"), XDG_STATE_HOME=os.path.join(folder, "state"),
               XDG_CONFIG_HOME=os.path.join(folder, "config"), LEVITATE_AGENT_CODEX=STANDIN,
               XDG_RUNTIME_DIR=os.path.join(folder, "run"), LEVITATE_AGENT_ROOT_HELPER="", LEVITATE_AGENT_NOTIFIER="",
               LEVITATE_STANDIN_LOG=log, LEVITATE_STANDIN_STORY=story)
    return env


def drive(binary, folder, story, app, title, prompt, answer=None, keep=False, until="question"):
    """One run. Returns the process when `keep`, once it has sent an event
    named `until`: it is then waiting (a question) or running (a did)."""
    proc = subprocess.Popen([binary], stdin=subprocess.PIPE, stderr=subprocess.PIPE, stdout=subprocess.PIPE,
                            env=environment(folder, story), start_new_session=True)
    proc.stdin.write((json.dumps({"prompt": prompt, "app": app, "title": title}) + "\n").encode())
    proc.stdin.flush()
    while True:
        line = proc.stderr.readline()
        if not line:
            break
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if keep and event.get("event") == until:
            return proc
        if event.get("event") == "question":
            proc.stdin.write((json.dumps({"question": event["id"], "answer": answer}) + "\n").encode())
            proc.stdin.flush()
    proc.wait(timeout=30)
    return proc


def stop(folder):
    """Ends the runs that were left going."""
    path = os.path.join(folder, "going.json")
    if not os.path.exists(path):
        return
    going = json.load(open(path))
    for run_id in going["ids"]:
        subprocess.run([going["binary"], "--stop", run_id], env=environment(folder, "plain"), capture_output=True, timeout=60)
    os.remove(path)


def running_ids(binary, folder):
    listing = json.loads(subprocess.check_output([binary, "--list"], env=environment(folder, "plain")))
    return [r["id"] for r in listing["runs"] if r["state"] in ("running", "waiting")]


def stop_after(binary, folder):
    json.dump({"binary": binary, "ids": running_ids(binary, folder)}, open(os.path.join(folder, "going.json"), "w"))
    stop(folder)


def main():
    args = sys.argv[1:]
    if args[:1] == ["--stop"] and len(args) == 2:
        stop(os.path.abspath(args[1]))
        return 0
    if not args or len(args) > 2:
        sys.stderr.write(__doc__)
        return 2
    folder = os.path.abspath(args[0])
    binary = args[1] if len(args) > 1 else os.path.join(ROOT, ".artifacts/agent/build/levitate-agent")
    stop(folder)
    shutil.rmtree(folder, ignore_errors=True)
    os.makedirs(os.path.join(folder, "home"))

    running = drive(binary, folder, "hang", "Recipe", "Install Krita for this computer",
                    "The request:\nInstall Krita for this computer.\n", keep=True, until="did")
    time.sleep(1.1)
    done = drive(binary, folder, "plain", "Recipe", "Install htop for this computer",
                 "The request:\nInstall htop for this computer.\n\nThe expected result:\nhtop starts from the menu "
                 "and nothing else changes.\n")
    time.sleep(1.1)  # the file name of a record has the time to the second
    waiting = drive(binary, folder, "asks", "System", "Turn off password logins over ssh",
                    "The request:\nTurn off password logins over ssh; I only use keys.\n\nThe expected result:\n"
                    "After a restart the change is in effect and the system starts as before. Nothing else "
                    "changes.\n",
                    keep=True)
    time.sleep(1.1)
    failed = drive(binary, folder, "fails", "Recipe", "Update Element",
                   "The request:\nUpdate Element to the newest version.\n")
    time.sleep(1.1)
    refused = drive(binary, folder, "administrator", "System", "Install the NVIDIA driver",
                    "The request:\nMy graphics card is an NVIDIA RTX 4070. I want NVIDIA's own driver instead of the "
                    "built-in one.\n\nThe facts:\nEvery recab command that changes something takes --actor agent.\n\n"
                    "The expected result:\nAfter a restart the driver is in use.\n",
                    answer="Refuse")

    if done.returncode != 0 or refused.returncode != 0 or failed.returncode != 1:
        sys.stderr.write("records: runs ended with %s, %s, %s (expected 0, 1, 0)\n"
                         % (done.returncode, failed.returncode, refused.returncode))
        waiting.kill()
        running.kill()
        stop_after(binary, folder)
        return 1
    # Let go of the helpers; the runs are theirs no more.
    pids = (waiting.pid, running.pid)
    for proc in (waiting, running):
        proc.kill()
        proc.wait()
    ids = running_ids(binary, folder)
    json.dump({"binary": binary, "ids": ids}, open(os.path.join(folder, "going.json"), "w"))
    if len(ids) != 2:
        sys.stderr.write("records: %d runs are going (expected 2)\n" % len(ids))
        stop(folder)
        return 1
    print("state=%s waiting_pid=%d" % (os.path.join(folder, "state"), pids[0]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
