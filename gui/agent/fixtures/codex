#!/usr/bin/env python3
"""A stand-in for `codex`, for checking levitate-agent without a real one.

It answers `--version`, `login status`, `exec ...` and `exec resume ID ...`
and prints JSON lines in the shapes of codex-rs/exec/src/exec_events.rs. The
prompt is read from standard input, as `-` asks. What it does is chosen by
LEVITATE_STANDIN_STORY (see the story list below); every call is appended to
LEVITATE_STANDIN_LOG as one JSON line (arguments, prompt, which turn), so the
check can see what levitate-agent really sent.

`login` and `logout` keep whether it is signed in in `$HOME/.standin-codex-signed`
("in" or "out"); `login status` follows that file, and without it the old
rule holds (signed in unless LEVITATE_STANDIN_SIGNED_OUT is set). Like the real
`codex login`, `login` prints an address and then ends. `LEVITATE_STANDIN_LOGIN_FAILS`
makes it end without signing in.

Stories: plain, asks, administrator, run, shell, fails, signed-out, dies, hang, slow,
writes (writes a file in the working folder when the sandbox is workspace-write),
script (turn N says message N of the JSON list in the file LEVITATE_STANDIN_SCRIPT;
the last one repeats: what a check uses to make the agent write SET-ASIDE, KEEP,
CANNOT and ASK lines), disk (reads the list of places in the request of the Disk
window and decides about each: SET-ASIDE, or CANNOT for a path containing
DISK_STANDIN_COULD_NOT, and for a place marked "Ask me first" an ASK, then SET-ASIDE
on "Remove it" and KEEP on anything else; asked what differs between two systems, it
answers in one message and changes nothing).
The turn is counted in a file next to the log, one count for the session.
"""
import json
import os
import subprocess
import sys
import time

STORY = os.environ.get("LEVITATE_STANDIN_STORY", "plain")
LOG = os.environ.get("LEVITATE_STANDIN_LOG", "/tmp/levitate-standin.log")
THREAD = "standin-thread-1"
_ids = [0]


def out(**event):
    sys.stdout.write(json.dumps(event) + "\n")
    sys.stdout.flush()


def item(phase, kind, **fields):
    """An item event; the same id for the same thing, as Codex does."""
    out(type="item." + phase, item=dict(fields, type=kind))


def message(text):
    _ids[0] += 1
    item("completed", "agent_message", id="msg%d" % _ids[0], text=text)


def todo(texts, done):
    items = [{"text": t, "completed": i < done} for i, t in enumerate(texts)]
    item("updated" if done else "started", "todo_list", id="todo1", items=items)


def command(cid, text, output, code):
    item("started", "command_execution", id=cid, command=text, aggregated_output="", exit_code=None,
         status="in_progress")
    item("completed", "command_execution", id=cid, command=text, aggregated_output=output, exit_code=code,
         status="completed" if code == 0 else "failed")


def turn_number():
    path = LOG + ".turns"
    count = int(open(path).read()) + 1 if os.path.exists(path) else 1
    open(path, "w").write(str(count))
    return count


def begin():
    out(type="thread.started", thread_id=THREAD)
    out(type="turn.started")


def end():
    out(type="turn.completed", usage={"input_tokens": 1, "cached_input_tokens": 0, "output_tokens": 1})


def sandbox_mode():
    args = sys.argv[1:]
    if "-s" in args:
        return args[args.index("-s") + 1]
    for a in args:
        if a.startswith("sandbox_mode="):
            return a.split("=", 1)[1].strip('"')
    return None


def disk(turn, prompt):
    """What an agent does with the list the Disk window hands over: it only decides;
    the helper moves what it names."""
    import re
    # Asked what differs between the two systems (the Disk window's second request): it reads, and says. A real
    # agent would look at the files; this one answers from the facts it was handed.
    if turn == 1 and "the other system" in prompt.split("The facts:", 1)[0]:
        message("All but one difference belong to one change: htop was installed, which brought ncurses, and curl was "
                "updated with it. One thing no change explains: /etc/ssh/sshd_config can be read by everyone in the "
                "other system and only by root in this one. Nothing was changed.")
        return
    # A resumed session remembers the first request; the stand-in does by a file.
    memory = LOG + ".places"
    if turn == 1:
        facts = prompt.split("The facts:", 1)[-1].split("The expected result:", 1)[0]
        places = []
        for line in facts.splitlines():
            found = re.match(r"^- (/.+?) \([\d.,]+ (?:B|KiB|MiB|GiB|TiB)\): (.*)$", line.strip())
            if found:
                places.append((found.group(1), found.group(2)))
        json.dump(places, open(memory, "w"))
    places = json.load(open(memory))
    asking = [(p, w) for p, w in places if "Ask me first" in w]
    sure = [(p, w) for p, w in places if "Ask me first" not in w]
    refuse = os.environ.get("DISK_STANDIN_COULD_NOT", "")
    lines = []
    if turn == 1:
        for path, _ in sure:
            if refuse and refuse in path:
                lines.append("CANNOT: %s | a program has files open in it" % path)
            else:
                lines.append("SET-ASIDE: %s" % path)
    else:
        index = turn - 2  # the question of the turn before
        if 0 <= index < len(asking):
            path = asking[index][0]
            answer = prompt.split("The person answered:", 1)[-1].strip()
            lines.append(("SET-ASIDE: %s" % path) if "Remove it" in answer else "KEEP: %s | you said to keep it" % path)
    next_one = turn - 1
    if next_one < len(asking):
        path, why = asking[next_one]
        lines.append("ASK: Set %s aside? %s | Remove it | Keep it" % (path, why.replace(" Ask me first.", "")))
    elif turn == 1 and not lines:
        lines.append("There was nothing to set aside.")
    elif turn > 1 or not lines:
        lines.append("I went through the list: what is sure is set aside, and the rest was decided with you.")
    message("\n".join(lines))


def story(turn, prompt):
    begin()
    if STORY == "disk":
        disk(turn, prompt)
    elif STORY == "script":
        messages = json.load(open(os.environ["LEVITATE_STANDIN_SCRIPT"]))
        message(messages[min(turn, len(messages)) - 1])
    elif STORY == "plain":
        steps = ["Look around", "Make the change", "Check it"]
        todo(steps, 0)
        item("completed", "reasoning", id="r1", text="thinking about it")
        command("c1", "ls -l", "total 0\n", 0)
        todo(steps, 1)
        # Long output: the window must not be flooded with it.
        command("c2", "seq 1 100", "\n".join(str(n) for n in range(1, 101)), 0)
        item("completed", "file_change", id="f1", status="completed",
             changes=[{"path": "/home/x/a.txt", "kind": "add"}, {"path": "/home/x/b.txt", "kind": "update"}])
        item("completed", "web_search", id="w1", query="levitate recipe format")
        todo(steps, 3)
        message("Working on it.")
        message("I made the change. Everything checks out.")
    elif STORY == "asks":
        if turn == 1:
            message("I need to know one thing.\nASK: Which colour? | Red | Blue")
        else:
            message("I used the colour you chose: %s." % prompt.strip())
    elif STORY == "administrator":
        if turn == 1:
            message("This needs the administrator.\nRUN-AS-ADMINISTRATOR: id -u\nBECAUSE: It shows which user the command ran as.")
        elif "refused" in prompt:
            message("Understood, I left it alone.")
        else:
            message("It ran. The prompt said: " + " ".join(prompt.split()))
    elif STORY == "run":
        if turn == 1:
            message("RUN: echo hello from the person")
        else:
            message("It ran. " + " ".join(prompt.split()))
    elif STORY == "shell":
        if turn == 1:
            message("RUN: ls | wc -l")
        elif turn == 2:
            message("RUN: echo plain" if "plain command" in prompt else "RUN: false")
        else:
            message("Done with the plain command.")
    elif STORY == "slow":
        command("c1", "true", "", 0)  # something to read, so that a window has been connected
        time.sleep(float(os.environ.get("LEVITATE_STANDIN_SLOW", "1.5")))
        message("Done, slowly.")
    elif STORY == "writes":
        # The sandbox is `-s MODE` on a first turn, `-c sandbox_mode="MODE"` on a resume.
        mode = sandbox_mode()
        if mode == "workspace-write":
            path = os.path.join(os.getcwd(), "made-by-standin.txt")
            open(path, "w").write("made")
            item("completed", "file_change", id="f1", status="completed", changes=[{"path": path, "kind": "add"}])
            message("I wrote the file.")
        else:
            message("I could not write the file.")
    elif STORY == "fails":
        out(type="turn.failed", error={"message": "The model is overloaded"})
        sys.exit(1)
    elif STORY == "dies":
        out(type="error", message="Connection lost")
        sys.stderr.write("stream closed\n")
        sys.exit(1)
    elif STORY == "hang":
        child = subprocess.Popen(["sleep", "300"])
        open(LOG + ".pids", "w").write("%d %d" % (os.getpid(), child.pid))
        command("c1", "sleep 300", "", 0)
        time.sleep(300)
    end()


def signed_file():
    return os.path.join(os.path.expanduser("~"), ".standin-codex-signed")


def signed_in():
    try:
        return open(signed_file()).read().strip() == "in"
    except OSError:
        return not os.environ.get("LEVITATE_STANDIN_SIGNED_OUT")


def main():
    args = sys.argv[1:]
    if args[:1] == ["--version"]:
        print("codex-cli 0.0.0-standin")
        return
    if args[:1] == ["login"] and args[1:2] != ["status"]:
        print("Starting a local login server on http://localhost:1455.", flush=True)
        print("If your browser did not open, go to https://auth.standin.invalid/oauth/authorize?state=standin", flush=True)
        if os.environ.get("LEVITATE_STANDIN_LOGIN_FAILS"):
            sys.stderr.write("Error logging in: the sign-in was not completed\n")
            sys.exit(1)
        time.sleep(float(os.environ.get("LEVITATE_STANDIN_LOGIN_SECONDS", "0.3")))
        open(signed_file(), "w").write("in")
        print("Successfully logged in")
        return
    if args[:1] == ["logout"]:
        open(signed_file(), "w").write("out")
        print("Successfully logged out")
        return
    if args[:2] == ["login", "status"]:
        if not signed_in():
            print("Not logged in")
            sys.exit(1)
        print("Logged in using the stand-in")
        return
    if args[:1] != ["exec"]:
        sys.stderr.write("stand-in: unknown arguments\n")
        sys.exit(2)
    prompt = sys.stdin.read()
    turn = turn_number() if STORY != "signed-out" else 1
    with open(LOG, "a") as log:
        log.write(json.dumps({"args": args, "prompt": prompt, "turn": turn, "cwd": os.getcwd()}) + "\n")
    if STORY == "signed-out":
        sys.stderr.write("Error: not signed in. Run `codex login` first.\n")
        sys.exit(1)
    story(turn, prompt)


if __name__ == "__main__":
    main()
