#!/usr/bin/env python3
"""A stand-in for the `recipe` command, for running recipe-gui from a checkout.

It answers the commands the front end uses (see ../README.md, "What the front
end asks of recipe") from catalog.json and a small state file, and plays an
install as a stream of events. Nothing is downloaded, built or installed.

It tells the places software can be in apart the way the real `recipe` does
(tools/recipe, `system_route` and `default_package_root`):

  recipe --system install|update|remove NAME   the system route: the change goes
                                               into the next system (recab); the
                                               running system is not touched
  recipe --system installed --json             what recab's `change list` answers:
                                               {active, prepared, preparation, activation}
  recipe ... --package-root DIR                one explicit store (installed.json)
  recipe ...                                   the person's own store (installed-me.json)

Environment:
  RECIPE_STANDIN_STATE    folder for the state file (default: a folder in /tmp)
  RECIPE_STANDIN_LOG      file each invocation's arguments are appended to, one JSON
                          line each (default: invocations.log in the state folder)
  RECIPE_STANDIN_PREPARED 1: the reader may read `prepared` (real recipe: only root can);
                          otherwise it is null, as for a person
  RECIPE_RECAB_BIN        as the real recipe: the recab the system route runs; the stand-in
                          prepares and records the change in it, so the strip can be read
  RECIPE_STANDIN_SPEED    time factor for an install; 0 runs it at once (default 1)
  RECIPE_STANDIN_STOP_AT  "name:hook": stay in the middle of that step forever
  RECIPE_STANDIN_REFUSE_NEW  a recipe whose install (not yet installed) the sandbox refuses,
                          as it refuses Element's update; with --autofix the agent repairs it
  RECIPE_STANDIN_FIXED    "element": Element's update is no longer refused (its source fixed it)

It also keeps what the real `recipe` keeps beside a store (tools/recipe, packages.rs and
packages/history.rs): the history of what was done to it (`recipe history --json`, one line
per change, newest first), and `held` on a package (`recipe hold` / `unhold`; `installed`
and `updates` carry it, `update` refuses a held package in the real sentence).
"""
import datetime
import json
import os
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
CATALOG = json.load(open(os.path.join(HERE, "catalog.json")))
STATE_DIR = os.environ.get("RECIPE_STANDIN_STATE") or "/tmp/recipe-standin-%d" % os.getuid()
STATE = os.path.join(STATE_DIR, "installed.json")  # main() picks the store the arguments name
SYSTEM = os.path.join(STATE_DIR, "system.json")
ME = os.path.join(STATE_DIR, "installed-me.json")
PREPARED_VISIBLE = os.environ.get("RECIPE_STANDIN_PREPARED") == "1" or os.getuid() == 0
STORE_ROOT = "/var/lib/recipe"  # the profile named in answers
SPEED = float(os.environ.get("RECIPE_STANDIN_SPEED", "1"))
STOP_AT = os.environ.get("RECIPE_STANDIN_STOP_AT", "")


def installed():
    if not os.path.exists(STATE):
        os.makedirs(STATE_DIR, exist_ok=True)
        # The person's own store starts with one program an agent wrote for them,
        # an older version of it; the others' store is the catalog's.
        save(ME_START if STATE == ME else CATALOG["installed"])
    return json.load(open(STATE))


ME_START = [{
    "name": "tree", "version": "2.3.1", "installed_on": 1793275200, "size_bytes": 3145728, "kept": [],
    "recipe": os.path.expanduser("~/.local/share/recipe/recipes/tree.rhai"),
    "files": ["bin/tree"],
}]


def save(items):
    with open(STATE, "w") as out:
        json.dump(items, out, indent=1)


def history_path():
    return STATE + ".history.jsonl"


def record(what, package=None, before=None, after=None, source=None):
    """One line of the store's history, in the real fields (history.rs `HistoryEntry`)."""
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(history_path(), "a") as out:
        out.write(json.dumps({"at": int(time.time()), "what": what, "package": package, "from": before,
                              "to": after, "source": source}) + "\n")


def remote_source(name):
    """The source's name for a recipe of a remote source; the real entry is null for a folder."""
    for each in listed_sources():
        if each["name"] == recipes_source(name) and each["kind"] == "remote":
            return each["name"]
    return None


def history():
    if not os.path.exists(history_path()):
        return []
    lines = [json.loads(line) for line in open(history_path()) if line.strip()]
    return list(reversed(lines))


# ---------------------------------------------------------------- sources
# Two to begin with: the catalog the image ships as a remote source, and the
# person's own folder, which holds what an agent wrote for them.

SOURCES = os.path.join(STATE_DIR, "sources.json")
WRITTEN = os.path.join(STATE_DIR, "written.json")
OWN = os.path.expanduser("~/.local/share/recipe/recipes")


def read(path, default):
    if not os.path.exists(path):
        return default
    return json.load(open(path))


def write(path, value):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(path, "w") as out:
        json.dump(value, out, indent=1)


def sources():
    first = [{"name": "levitate", "title": CATALOG["source"]["title"], "kind": "remote",
              "address": "https://raw.githubusercontent.com/LevitateOS/recipes/{rev}/{path}", "branch": "main",
              "commit": "4c1d9e07", "checked": int(time.time()) - 3 * 3600, "problem": None}]
    return read(SOURCES, first)


def listed_sources():
    own = {"name": "local", "title": None, "kind": "folder", "path": OWN, "checked": None, "problem": None}
    return [own] + sources()


def sample(name, title, description, category, like):
    """A recipe for a source added by hand: shaped like one of the catalog's."""
    made = dict(next(item for item in CATALOG["recipes"] if item["name"] == like))
    made.update(name=name, description=description)
    made["about"] = dict(made.get("about") or {}, category=category, title=title, kind="tool")
    return made


def recipes():
    found = []
    for item in CATALOG["recipes"]:
        # `tree` is the one an agent wrote earlier: it lives in the person's own folder.
        found.append(dict(item, source="local" if item["name"] == "tree" else "levitate", path=recipe_file(item["name"])))
    for item in read(WRITTEN, []):
        found.append(dict(item, source="local"))
    for source in sources():
        if source["name"] == "levitate" or source.get("problem"):
            continue
        found.append(dict(sample("fastfetch", "Fastfetch", "Shows what this computer is, at a glance", "utilities",
                                 "tree"), source=source["name"]))
        found.append(dict(sample("zellij", "Zellij", "Several terminals in one window", "utilities", "htop"),
                          source=source["name"]))
    return found


def recipe_file(name):
    """The recipe's file, as the real `list --json` names it: made here so there is one to open."""
    path = os.path.join(STATE_DIR, "recipes", name + ".rhai")
    if not os.path.exists(path):
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w") as out:
            out.write("// the stand-in's recipe for %s\n" % name)
    return path


def source_add(args, words):
    known = sources()
    if "--path" in args:
        folder = words[2]
        name = os.path.basename(folder.rstrip("/"))
        made = {"name": name, "title": None, "kind": "folder", "path": folder, "checked": None, "problem": None}
    else:
        address = words[2]
        if not address.startswith("https://"):
            fail("a source is fetched over https; %s is not such an address" % address)
        name = address.rstrip("/").split("/")[-2] if address.rstrip("/").count("/") >= 4 else "source"
        made = {"name": name, "title": "%s recipes" % name.capitalize(), "kind": "remote", "address": address,
                "branch": "main", "commit": "9a02b7f1", "checked": int(time.time()), "problem": None}
    if name in ("local", "image") or any(each["name"] == name for each in known):
        fail("a source named %s exists already" % name)
    pause(0.6)
    write(SOURCES, known + [made])


def source_remove(name):
    known = sources()
    if not any(each["name"] == name for each in known):
        fail("no source named %s" % name)
    write(SOURCES, [each for each in known if each["name"] != name])


def refresh(name):
    known = sources()
    if name and not any(each["name"] == name for each in known):
        fail("no source named %s" % name)
    pause(0.8)
    for each in known:
        if each["kind"] == "remote" and name in ("", each["name"]):
            each["checked"] = int(time.time())
    write(SOURCES, known)


def recipes_source(name):
    return next((item["source"] for item in recipes() if item["name"] == name), None)


def recipe(name):
    name = name.split(":", 1)[-1]  # SOURCE:NAME; the stand-in's names are unique
    for item in recipes():
        if item["name"] == name:
            return item
    fail("no recipe named %s" % name)


def fail(text):
    sys.stderr.write(json.dumps({"event": "failed", "reason": text}) + "\n")
    sys.exit(1)


def emit(**event):
    sys.stderr.write(json.dumps(event) + "\n")
    sys.stderr.flush()


def pause(seconds):
    if SPEED > 0:
        time.sleep(seconds * SPEED)


def stop_here(name, hook):
    if STOP_AT == "%s:%s" % (name, hook):
        while True:
            time.sleep(3600)


def steps_of(item):
    steps = ["acquire"] if item.get("sources") else []
    steps += [hook for hook in ("build", "install") if hook in item["hooks"]]
    return steps


def hook_event(name, hook, status, msg):
    """One lifecycle event as the real recipe sends it."""
    emit(event="recipe-hook", recipe=name, hook=hook, status=status, msg=msg)


def play(item, refuse=None, agent=False):
    name = item["name"]
    # Each recipe says which of its steps it needs this time, once its checks have run.
    emit(event="plan", recipe=name, steps=steps_of(item))
    for hook in steps_of(item):
        hook_event(name, hook, "running", "executing recipe hook")
        if hook == "acquire":
            total = max(item["needs"]["network_max_bytes"] // 4, 1 << 20)
            for part in range(1, 9):
                if refuse and part == 3 and agent:
                    # The sample repair: the agent reads the refusal and the prompt, and changes the recipe.
                    emit(event="say", recipe=name, text="The agent is reading the failure and the recipe")
                    pause(1.0)
                    emit(event="agent", recipe=name, hook=hook, attempt=1,
                         files=["/usr/share/recipe/recipes/%s.rhai" % name],
                         summary="it now fetches the file from packages.element.io, which the recipe already allows")
                    refuse = None
                if refuse and part == 3:
                    hook_event(name, hook, "failed", "connection refused by the sandbox")
                    # `refused` is asked for: the real recipe names the step and its own message only.
                    emit(event="failed", recipe=name, hook=hook,
                         reason="connection refused by the sandbox",
                         refused={"endpoint": refuse, "declared": item["needs"]["network"]})
                    sys.exit(1)
                emit(event="fetch", recipe=name, source=next(iter(item["sources"])),
                     bytes=total * part // 8, total=total)
                pause(0.25)
        elif hook == "build":
            count = 24 if item["about"]["kind"] == "library" else 60
            for done in range(1, count + 1):
                emit(event="output", recipe=name,
                     line="[%d/%d] Compiling C object %s.p/src_part%03d.c.o" % (done, count, name, done))
                emit(event="progress", recipe=name, done=done, total=count)
                if done == count * 2 // 3:
                    stop_here(name, hook)
                pause(0.08)
        else:
            emit(event="say", recipe=name, text="Putting the files in place")
            pause(0.5)
        hook_event(name, hook, "success", "step finished")


def install(name, agent=False, update_only=False):
    item = recipe(name)
    items = installed()
    current = next((each for each in items if each["name"] == name), None)
    if update_only and current and current.get("held"):
        # `recipe update` refuses a held package before anything runs (commands.rs, Commands::Update).
        emit(event="failed", recipe=name, hook=None,
             reason="%s is held, so it is not updated. Release it with: recipe unhold %s" % (name, name))
        sys.exit(1)
    order = [recipe(dep) for dep in item["build_deps"]] + [item]
    emit(event="plan", recipes=[{"name": each["name"], "steps": steps_of(each)} for each in order])
    # The sample story: the newer Element recipe reaches for a host it has not declared.
    # The real `recipe` reports the numeric address Ginux's audit names, never a host name.
    # RECIPE_STANDIN_REFUSE_NEW names a recipe whose first install is refused the same way.
    # RECIPE_STANDIN_FIXED=element: its source has since published a recipe that does not.
    refuse = ("203.0.113.9:443" if (name == "element" and current and os.environ.get("RECIPE_STANDIN_FIXED") != name)
              or (not current and name == os.environ.get("RECIPE_STANDIN_REFUSE_NEW")) else None)
    for each in order:
        play(each, refuse if each is item else None, agent)
    about = item["about"].get("adds", {})
    entry = {
        "name": name, "version": item["version"],
        "recipe": "/usr/share/recipe/recipes/%s.rhai" % name,
        "files": ["bin/" + program for program in about.get("programs", [])]
                 + ["share/applications/%s.desktop" % name for _ in about.get("menu", [])[:1]],
        "installed_on": int(time.time()),
        "size_bytes": 62914560, "kept": [],
    }
    if current and current.get("held"):
        entry["held"] = True  # installing again keeps a package held
    if current:
        # The version it replaces stays in the generation before, to go back to.
        entry["kept"] = [kept_of(current)] + current.get("kept", [])
        entry["size_bytes"] = current["size_bytes"]
        items.remove(current)
    items.append(entry)
    save(sorted(items, key=lambda each: each["name"]))
    record("update" if update_only else "install", name, current["version"] if current else None, item["version"],
           remote_source(name))
    emit(event="done", recipe=name)


def kept_of(item):
    """An installed version as the earlier version it becomes."""
    return {"version": item["version"], "generation": "g-%s-%s" % (item["name"], item["version"].replace(".", "")),
            "installed_on": item.get("installed_on"), "size_bytes": item.get("size_bytes")}


def storage(clear):
    """What `recipe storage` says: what is installed, and the earlier versions beside it."""
    items = installed()
    earlier = [kept for each in items for kept in each.get("kept", [])]
    answer = {"schema_version": 1, "active_bytes": sum(each.get("size_bytes") or 0 for each in items),
              "earlier_generations": len(earlier), "earlier_bytes": sum(kept.get("size_bytes") or 0 for kept in earlier),
              "profile": STORE_ROOT + "/profile"}
    if clear:
        answer.update(operation="clear-earlier", cleared_generations=answer["earlier_generations"],
                      cleared_bytes=answer["earlier_bytes"], earlier_generations=0, earlier_bytes=0)
        for each in items:
            each["kept"] = []
        save(items)
        record("clear-earlier")
    print(json.dumps(answer))


def remove(name):
    items = installed()
    current = next((each for each in items if each["name"] == name), None)
    if not current:
        fail("%s is not installed" % name)
    pause(0.4)
    items.remove(current)
    save(items)
    record("remove", name, current["version"], None, remote_source(name))
    emit(event="done", recipe=name)


def go_back(name):
    items = installed()
    current = next((each for each in items if each["name"] == name), None)
    if not current or not current.get("kept"):
        fail("no earlier version of %s is kept" % name)
    # The newest earlier version comes back; the one left behind stays kept.
    older = current["kept"][0]
    left = current["version"]
    current["kept"] = [kept_of(current)] + current["kept"][1:]
    current["version"] = older["version"]
    current["size_bytes"] = older.get("size_bytes") or current["size_bytes"]
    current["installed_on"] = int(time.time())
    save(items)
    record("go-back", name, left, current["version"], remote_source(name))
    emit(event="done", recipe=name)


def hold(name, held):
    """`recipe hold` / `unhold`: `held` on the receipt; holding a held package changes nothing."""
    items = installed()
    current = next((each for each in items if each["name"] == name), None)
    if not current:
        fail("package %s is not installed" % name)
    if bool(current.get("held")) != held:
        current["held"] = held
        save(items)
        record("hold" if held else "unhold", name, current["version"], current["version"], remote_source(name))
    print(json.dumps({"name": name, "version": current["version"], "operation": "hold" if held else "unhold",
                      "held": held, "profile": STORE_ROOT + "/profile"}))
    emit(event="done", recipe=name)


def updates():
    found = []
    for each in installed():
        newer = recipe(each["name"])["version"]
        if newer != each["version"]:
            # As the real `recipe updates`: only the fields of NEEDS that differ,
            # and null where nothing was recorded at install.
            found.append({"name": each["name"], "source": "levitate", "from": each["version"], "to": newer,
                          "reason": "version", "changes": CATALOG["changes"].get(each["name"]),
                          "held": bool(each.get("held"))})
    return found


# ---------------------------------------------------------------- the system route
# `recipe --system ...` hands the change to recab, which puts it into the next
# system. State: what the running system holds (`active`), what the next one will
# (`prepared`, null until a change is made) and the changes made in it.

def system_state():
    if not os.path.exists(SYSTEM):
        # Two programs the running system came with, at the versions it was built with.
        write(SYSTEM, {"active": {"gimp": "3.0.4", "element": "1.12.3"}, "prepared": None, "changes": []})
    return read(SYSTEM, None)


def receipt(packages):
    """The selection as recipe's `system::Receipt` has it (tools/recipe/src/system.rs)."""
    return {"schema_version": 1, "packages": {
        name: {"name": name, "version": version, "recipe": "/usr/share/recipe/recipes/%s.rhai" % name,
               "recipe_digest": "sha256:" + "0" * 64, "architecture": "x86_64", "target": "linux",
               "dependencies": [], "files": {}}
        for name, version in sorted(packages.items())}}


def system_view():
    """What `recab change list` answers (tools/recab/src/change.rs `changes()`): the running
    system's selection, the next system's only for a reader that may read it (root), the next
    system's state with its changes, and a fixed sentence."""
    state = system_state()
    preparation = None
    if state["changes"]:
        preparation = {"id": "p2", "slot": "B", "source_slot": "A", "source_generation": "g1",
                       "revision": 1 + len(state["changes"]), "operation": "synchronize", "phase": "prepared",
                       "completed_steps": 3, "failure": None, "synchronized": True, "synchronization": None,
                       "finalization": None, "change": None, "last_change": None, "changes": state["changes"]}
    prepared = receipt(state["prepared"]) if state["prepared"] is not None and PREPARED_VISIBLE else None
    return {"active": receipt(state["active"]), "prepared": prepared, "preparation": preparation,
            "activation": "pending reboot for prepared changes"}


def recab_record(action, name):
    """The change is made in recab too when the story names one, so the strip can be read."""
    binary = os.environ.get("RECIPE_RECAB_BIN")
    if not binary:
        return

    def run(*args):
        done = subprocess.run([binary, *args], capture_output=True, text=True)
        if done.returncode:
            fail("recab: " + (done.stderr.strip() or "failed"))
        return done.stdout

    preparation = json.loads(run("status", "--json")).get("preparation")
    if not preparation:
        run("--json", "prepare")
        preparation = json.loads(run("status", "--json"))["preparation"]
    run("--json", "change", action, name, "--preparation", preparation["id"], "--revision", str(preparation["revision"]))


def system_change(action, name):
    state = system_state()
    held = state["prepared"] if state["prepared"] is not None else state["active"]
    if action in ("update", "remove") and name not in held:
        fail("package is not selected in that system")
    if action == "install" and name in held:
        fail("%s is already selected in the next system" % name)
    if action != "remove":
        item = recipe(name)
        order = [recipe(dep) for dep in item["build_deps"]] + [item]
        emit(event="plan", recipes=[{"name": each["name"], "steps": steps_of(each)} for each in order])
        for each in order:
            play(each)
    pause(0.4)
    recab_record(action, name)
    prepared = dict(held)
    if action == "remove":
        del prepared[name]
    else:
        prepared[name] = item["version"]
    state["prepared"] = prepared
    state["changes"].append({"id": "c%d" % (len(state["changes"]) + 2), "action": action, "package": name,
                             "unix_time": int(time.time()), "actor": None})
    write(SYSTEM, state)
    emit(event="done", recipe=name)


def log(args, route):
    """Each invocation's arguments, for a check that the window asked the right thing."""
    path = os.environ.get("RECIPE_STANDIN_LOG") or os.path.join(STATE_DIR, "invocations.log")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a") as out:
        out.write(json.dumps({"route": route, "args": args}) + "\n")


def main(args):
    # The real recipe tells the places apart by `--system`, and by whether a store is
    # named: without one it is the person's own.
    global STATE
    system = "--system" in args
    root = args[args.index("--package-root") + 1] if "--package-root" in args else None
    log(args, "system" if system else "me" if root is None else "store")
    if root is None and not system:
        STATE = ME
    words, skip = [], False
    for arg in args:
        if skip:
            skip = False
        elif arg in ("--recipes-path", "--package-root", "--autofix-prompt-file"):
            skip = True
        elif arg == "--path":
            pass  # `source add --path FOLDER`: the folder is the next word
        elif not arg.startswith("--"):
            words.append(arg)
    command = words[0] if words else ""
    if command in ("install", "update", "remove", "go-back", "hold", "unhold") and len(words) == 2:
        words[1] = words[1].split(":", 1)[-1]  # SOURCE:NAME; the stand-in's names are unique
    if command == "update" and any(arg.startswith("--autofix") for arg in args):
        # As the real recipe: `--autofix` is an option of `install` only (cli.rs, Commands::Update).
        sys.stderr.write("error: unexpected argument '--autofix' found\n\nUsage: recipe update <RECIPE>\n")
        sys.exit(2)
    if system:
        if command == "installed":
            print(json.dumps(system_view()))
        elif command in ("install", "update", "remove") and len(words) == 2:
            system_change(command, words[1])
        else:
            fail("--system supports install, update, remove, installed and isinstalled")
        return
    if command == "list":
        # A recipe that cannot be read is named as `list --json` does: its path and why. One appears
        # once a second source is added, so the Sources page has something to show.
        problems = [{"path": os.path.join(STATE_DIR, "recipes", "yazi.rhai"),
                     "problem": "it names nothing to download"}] if len(sources()) > 1 else []
        print(json.dumps({"schema_version": 1, "sources": listed_sources(), "recipes": recipes(), "problems": problems}))
    elif command == "refresh":
        refresh(words[1] if len(words) > 1 else "")
    elif command == "source" and words[1:2] == ["add"] and len(words) == 3:
        source_add(args, words)
    elif command == "source" and words[1:2] == ["remove"] and len(words) == 3:
        source_remove(words[2])
    elif command == "installed":
        # The shape `recipe installed` has today, plus the fields the front end asks for.
        # `held` is always there, true or false (commands.rs, Commands::Installed).
        print(json.dumps({"packages": [dict(each, held=bool(each.get("held"))) for each in installed()],
                          "profile": STORE_ROOT + "/profile"}))
    elif command == "updates":
        print(json.dumps({"schema_version": 1, "updates": updates(), "problems": []}))
    elif command == "storage":
        storage("--clear-earlier" in args)
    elif command == "history":
        print(json.dumps({"schema_version": 1, "history": history()}))
    elif command in ("hold", "unhold") and len(words) == 2:
        hold(words[1], command == "hold")
    elif command in ("install", "update") and len(words) == 2:
        install(words[1], "--autofix" in args, command == "update")
    elif command == "remove" and len(words) == 2:
        remove(words[1])
    elif command == "go-back" and len(words) == 2:
        go_back(words[1])
    else:
        sys.stderr.write("stand-in recipe: unknown command: %s\n" % " ".join(args))
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
