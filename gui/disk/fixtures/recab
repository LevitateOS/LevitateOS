#!/usr/bin/env python3
"""A stand-in for `recab compare`, for running disk-gui from a checkout.

  recab compare --json --machine-events

It plays reading both systems and answers as the Disk window expects (see
the README: "What it asks of recab"). It reads no disk.

DISK_STANDIN_SYSTEMS picks the story:
  before     the other system is the one from before the last change (default)
  next       the other system holds a change that is not started yet
  identical  the two were made as copies and nothing was changed since
  none       there is no second system
DISK_STANDIN_SPEED scales the waiting (0: none).
"""
import json
import os
import sys
import time

STORY = os.environ.get("DISK_STANDIN_SYSTEMS", "before")
SPEED = float(os.environ.get("DISK_STANDIN_SPEED", "1"))
KIB, MIB, GIB = 1 << 10, 1 << 20, 1 << 30


def emit(**event):
    sys.stderr.write(json.dumps(event) + "\n")
    sys.stderr.flush()


def read(step, total):
    emit(event="step", step=step, status="running")
    for part in range(1, 9):
        time.sleep(0.25 * SPEED)
        emit(event="progress", step=step, done=total * part // 8, total=total, unit="bytes")
    emit(event="step", step=step, status="done")


def only(side, path, size):
    return {"path": path, "change": "only-" + side, side + "_bytes": size}


def content(path, running, other):
    return {"path": path, "change": "content", "running_bytes": running, "other_bytes": other}


def differences(newer):
    """What a change that added htop (and ncurses for it) and updated curl
    leaves between the two systems. `newer` is the side that has the change."""
    older = "other" if newer == "running" else "running"

    def changed(path, new, old):
        return content(path, new, old) if newer == "running" else content(path, old, new)

    found = [
        only(newer, "/usr/bin/htop", 412 * KIB),
        only(newer, "/usr/share/applications/htop.desktop", 2 * KIB),
        only(newer, "/usr/share/man/man1/htop.1.gz", 9 * KIB),
        only(newer, "/usr/share/pixmaps/htop.png", 11 * KIB),
        only(newer, "/usr/lib64/libncursesw.so.6.5", 486 * KIB),
        only(newer, "/usr/lib64/libtinfo.so.6.5", 198 * KIB),
        only(newer, "/usr/lib64/libpanelw.so.6.5", 22 * KIB),
        changed("/usr/bin/curl", 318 * KIB, 302 * KIB),
        changed("/usr/lib64/libcurl.so.4.8.0", 842 * KIB, 811 * KIB),
        only(older, "/usr/lib64/libnghttp2.so.14.26.0", 174 * KIB),
        only(newer, "/usr/lib64/libnghttp2.so.14.28.3", 181 * KIB),
        changed("/usr/share/recipe/installed.json", 41 * KIB, 38 * KIB),
        changed("/etc/ld.so.cache", 96 * KIB, 94 * KIB),
        {"path": "/etc/ssh/sshd_config", "change": "metadata", "running_bytes": 3 * KIB, "other_bytes": 3 * KIB,
         "detail": "mode 0600 here, 0644 in the other"},
    ]
    for number in range(1, 13):
        found.append(only(newer, "/usr/share/terminfo/x/xterm-%d" % number, 3 * KIB))
    return found


# What a system holds, folder by folder, in MiB: the files directly in each.
HOLDS = {
    "/usr/bin": 420, "/usr/sbin": 86, "/usr/libexec": 264, "/usr/include": 38,
    "/usr/lib64": 1310, "/usr/lib64/qt6": 640, "/usr/lib64/dri": 276, "/usr/lib64/gstreamer-1.0": 92,
    "/usr/lib64/kf6": 148,
    "/usr/lib": 96, "/usr/lib/modules": 1180, "/usr/lib/firmware": 760, "/usr/lib/systemd": 58,
    "/usr/lib/python3.13": 236,
    "/usr/share": 268, "/usr/share/icons": 418, "/usr/share/locale": 372, "/usr/share/fonts": 204,
    "/usr/share/doc": 146, "/usr/share/man": 58, "/usr/share/wallpapers": 232, "/usr/share/terminfo": 9,
    "/usr/share/applications": 2, "/usr/share/pixmaps": 3, "/usr/share/recipe": 1,
    "/etc": 13, "/etc/ssh": 1, "/etc/recab": 1, "/etc/kernel": 1,
    "/opt": 24, "/root": 2,
}


def folders(found):
    """Every folder with its whole size on both sides: what it holds, what its
    folders hold, and what differs in it."""
    sizes = {}

    def add(path, running, other):
        while True:
            entry = sizes.setdefault(path, [0, 0])
            entry[0] += running
            entry[1] += other
            if path == "/":
                return
            path = os.path.dirname(path)

    for path, mib in HOLDS.items():
        add(path, mib * MIB, mib * MIB)
    for d in found:
        folder = os.path.dirname(d["path"])
        while folder not in HOLDS and folder != "/":
            folder = os.path.dirname(folder)
        # What is the same was counted above; a file with other content
        # replaces one of about that size, so only one-sided files add room.
        if d["change"].startswith("only-"):
            add(folder, d.get("running_bytes", 0), d.get("other_bytes", 0))
    return [{"path": path, "running_bytes": pair[0], "other_bytes": pair[1]} for path, pair in sorted(sizes.items())]


def main():
    if sys.argv[1:2] != ["compare"]:
        sys.exit("the stand-in recab only knows `compare`")
    if STORY == "none":
        emit(event="failed", reason="This computer has one system only: recab was set up without a second one.")
        sys.exit(1)

    running = {"slot": "A", "device": "/dev/nvme0n1p2", "files": 61204, "bytes": int(8.14 * GIB)}
    other = {"slot": "B", "device": "/dev/nvme0n1p3", "files": 61204, "bytes": int(8.14 * GIB)}
    emit(event="plan", steps=[["running", "Read the running system"], ["other", "Read the other system"],
                               ["compare", "Compare them"]])
    read("running", running["bytes"])
    read("other", other["bytes"])
    emit(event="step", step="compare", status="running")
    time.sleep(0.4 * SPEED)

    found = []
    if STORY == "before":
        found = differences("running")
        other["role"] = "before"
    elif STORY == "next":
        found = differences("other")
        other["role"] = "next"
    else:
        other["role"] = "copy"
    tree = folders(found)
    whole = next(f for f in tree if f["path"] == "/")
    # Each side's files: what is the same, what differs in place, what only it has.
    same_files = 61178
    in_place = [d for d in found if d["change"] in ("content", "metadata")]
    same_bytes = sum(HOLDS.values()) * MIB - sum(max(d["running_bytes"], d["other_bytes"]) for d in in_place)
    for side, facts in (("running", running), ("other", other)):
        facts["files"] = same_files + len(in_place) + sum(1 for d in found if d["change"] == "only-" + side)
        facts["bytes"] = whole[side + "_bytes"]
    answer = {
        "schema_version": 1,
        "running": running,
        "other": other,
        "same": {"files": same_files, "bytes": same_bytes},
        "own": ["/etc/fstab", "/etc/recab/slot", "/etc/kernel/cmdline"],
        "folders": tree,
        "differences": found,
        "more": 0,
    }
    emit(event="step", step="compare", status="done")
    emit(event="done")
    json.dump(answer, sys.stdout)


if __name__ == "__main__":
    main()
