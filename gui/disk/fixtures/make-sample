#!/usr/bin/env python3
"""Makes a sample home folder for disk-gui: ordinary files and several kinds
of mess, as long-but-empty files, so it shows gigabytes and takes no room.

  make-sample FOLDER     (FOLDER must not exist)

Run disk-gui on it with DISK_GUI_APPARENT=1 so lengths are counted.
"""
import os
import sys
import time

MIB = 1 << 20
DAY = 86400


def make(root, path, mib, age_days=5):
    full = os.path.join(root, path)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, "wb") as out:
        out.truncate(int(mib * MIB))
    when = time.time() - age_days * DAY
    os.utime(full, (when, when))


def main():
    if len(sys.argv) != 2 or os.path.exists(sys.argv[1]):
        sys.exit(__doc__)
    root = sys.argv[1]
