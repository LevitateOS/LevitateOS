#!/usr/bin/env python3
"""A stand-in for the agent, for running disk-gui from a checkout.

It reads the prompt on its input, goes through the listed places and reports
as an agent would. It removes a place only when that place is inside
DISK_STANDIN_ROOT (the sample tree); anywhere else it says what it would have
done and touches nothing. For a place marked "Ask me first" it asks, and
removes it only on a yes. Places that belong to Recipe are left.
"""
import json
import os
import re
import shutil
import sys
import time

ROOT = os.environ.get("DISK_STANDIN_ROOT", "")
SPEED = float(os.environ.get("DISK_STANDIN_SPEED", "1"))


def emit(**event):
    sys.stderr.write(json.dumps(event) + "\n")
    sys.stderr.flush()


def inside_sample(path):
    if not ROOT:
        return False
    root = os.path.realpath(ROOT)
    return os.path.realpath(path).startswith(root + os.sep)


def explain(prompt):
    """Asked what differs between the two systems: it reads, and says. A real
    agent would look at Recipe's record and at the files; this one answers
    from the facts it was handed."""
    emit(event="plan", steps=[["read", "Read the differences"], ["match", "Match them to changes"]])
    emit(event="step", step="read", status="running")
    time.sleep(0.4 * SPEED)
    emit(event="step", step="read", status="done")
    emit(event="step", step="match", status="running")
    time.sleep(0.6 * SPEED)
    emit(event="output", line="htop, its man page and menu entry: the recipe htop")
    emit(event="output", line="libncursesw, libtinfo, libpanelw, terminfo: the recipe ncurses, needed by htop")
    emit(event="output", line="curl, libcurl, libnghttp2: curl was updated")
    emit(event="output", line="/etc/ssh/sshd_config: no change accounts for the different mode")
    emit(event="step", step="match", status="done")
    emit(event="agent", summary="All but one difference belong to one change: htop was installed, which brought "
                                "ncurses, and curl was updated with it. One thing no change explains: "
                                "/etc/ssh/sshd_config can be read by everyone in the other system and only by root "
                                "in this one. Nothing was changed.")
    emit(event="done")


def ask(number, text, choices):
    """Asks the person and waits. With nobody there, the careful answer: the last choice."""
    emit(event="question", id=number, text=text, choices=choices)
    try:
        return json.loads(sys.stdin.readline())["answer"]
    except (ValueError, KeyError):
        return choices[-1]


def main():
    # The prompt arrives as one JSON line; the input stays open for answers.
    prompt = json.loads(sys.stdin.readline())["prompt"]
    if "the other system" in prompt.split("The facts:", 1)[0]:
        explain(prompt)
        return
    facts = prompt.split("The facts:", 1)[-1].split("The expected result:", 1)[0]
    places = []
    for line in facts.splitlines():
        found = re.match(r"^- (/.+?) \([\d.,]+ (?:MiB|GiB)\): (.*)$", line.strip())
        if found:
            places.append((found.group(1), found.group(2)))

    emit(event="plan", steps=[["read", "Read the list"], ["clear", "Clear what is sure"], ["check", "Check the result"]])
    emit(event="step", step="read", status="running")
    time.sleep(0.4 * SPEED)
    emit(event="step", step="read", status="done")
    emit(event="step", step="clear", status="running")
    cleared = left = 0
    for number, (path, why) in enumerate(places, 1):
        emit(event="progress", step="clear", done=number, total=len(places))
        if "Ask me first" in why and ask(str(number), "Remove %s? %s" % (path, why.replace(" Ask me first.", "")),
                                         ["Remove it", "Keep it"]) != "Remove it":
            emit(event="output", line="kept, as you said: %s" % path)
            left += 1
        elif "Recipe" in why:
            emit(event="output", line="left for Recipe to clear: %s" % path)
            left += 1
        elif inside_sample(path):
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path)
            elif os.path.lexists(path):
                os.remove(path)
            emit(event="output", line="cleared: %s" % path)
            cleared += 1
        else:
            emit(event="output", line="would clear (the stand-in removes nothing outside its sample): %s" % path)
        time.sleep(0.15 * SPEED)
    emit(event="step", step="clear", status="done")
    emit(event="step", step="check", status="running")
    time.sleep(0.3 * SPEED)
    emit(event="step", step="check", status="done")
    emit(event="agent", summary="it cleared %d places and left %d that you kept or that belong to Recipe" % (cleared, left))
    emit(event="done")


if __name__ == "__main__":
    main()
